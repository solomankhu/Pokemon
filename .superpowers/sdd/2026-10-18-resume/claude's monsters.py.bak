    'razorleaf': 'blade', 'leafblade': 'blade', 'energyball': 'focus',
    'thundershock': 'focus', 'spark': 'body', 'thunderbolt': 'focus',
    'rockthrow': 'claw', 'rockslide': 'focus', 'bugbite': 'fang', 'gust': 'wing',
    'wingattack': 'wing', 'aerialace': 'wing', 'poisonsting': 'stinger',
    'sludge': 'mouth', 'confusion': 'focus', 'psybeam': 'focus', 'psychic': 'focus',
    'growl': 'mouth', 'tailwhip': 'tail', 'leer': 'focus', 'harden': 'body',
    'howl': 'mouth', 'agility': 'body', 'stringshot': 'mouth', 'bite': 'fang',
    'crunch': 'fang', 'snarl': 'mouth', 'nightveil': 'focus', 'metalclaw': 'claw',
    'irontail': 'tail', 'flashcannon': 'focus', 'ironguard': 'body',
    'brinejet': 'mouth', 'sandsting': 'stinger', 'dazzle': 'focus',
}
CONTACT_MOVES = frozenset(('tackle', 'scratch', 'quickattack', 'bodyslam', 'hyperfang',
    'infernofang', 'aquatail', 'vinewhip', 'leafblade', 'spark', 'bugbite', 'wingattack',
    'aerialace', 'poisonsting', 'bite', 'crunch', 'metalclaw', 'irontail', 'sandsting'))


def move_timeline(move_id):
    if move_id not in MOVE_WEAPONS:
        raise ValueError('Unknown move: ' + str(move_id))
    windup = .18 if move_id == 'quickattack' else .34
    travel = .3 if move_id in CONTACT_MOVES else .48
    return dict(windup=windup, travel=travel, contact=.18, recovery=.34,
                contactAt=windup + travel, duration=windup + travel + .52)



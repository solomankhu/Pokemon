ITEMS = {
    (56, 100): 4, (20, 89): 5, (62, 80): 5,
    (52, 68): 6, (70, 70): 10, (80, 57): 6,
    (50, 51): 7, (20, 28): 8, (70, 36): 8,
    (12, 18): 9, (76, 18): 9,
    (75, 30): 8,                 # inside the GEODE: needs the IRON PICK
}

NPCS = [
    # --- CEDAR TOWN ---
    dict(id="prof", x=61, y=107, dir="down", kind="prof", name="PROF. CEDAR",
         c1=(216, 216, 224), c2=(138, 107, 74)),
    dict(id="nurse1", x=12, y=107, dir="down", kind="npc", name="MEDIC",
         c1=(240, 184, 200), c2=(192, 72, 104),

SHOP_QTY_MAX = 10
FORCE_NO_LOOT = False            # test seam: no loot, no coins, no blackout loss; never saved
BATTLE_BAG = ["greatball", "potion", "superpotion", "smoke"]   # after BALL, in the battle BAG list
NURSE_GIFT = "Here, take these BALLs. Be careful out there."
CENTRE_HEAL = ["MEDIC: Rest here a moment...", "Your team is fully healed!"]   # the H door's lines

# DARK CAVE horror kit (after THE STATIC BELOW): a draining lantern, a
# tension meter, the hunting GLOOMSTALK and the stun PULSE.  Every rule is a
# pure function below.  The stalker moves only on the player's completed
# steps and draws from its own seeded mulberry32, never the global random.
ENC_BASE = 0.14                  # the wild encounter roll per grass step
LANTERN = dict(max=100, drain=1, oil=50, r_max=4.7, r_min=2.25, core_px=34, buckets=8)
TENSION = dict(max=100, base=1, dim=1, dark=2, hunted=3, safe=-2, fear=75, enc_bonus=0.75,
               events=dict(win=-10, run=5, pulse=-15))
KEEP_OUT = ((0.5, 3), (0.2, 2), (0.0, 1))   # lantern fraction floor -> min Manhattan gap
HUNT_AI = dict(
    rows=(27, 36), safe_r=4, mouths=((42, 25), (43, 25), (42, 38), (43, 38)),
    lair=(7, 33),
    patrol=((7, 33), (7, 28), (30, 28), (38, 30), (56, 31), (62, 28), (79, 28), (79, 35),
            (56, 36), (38, 35), (20, 36), (7, 36)),
    pace_patrol=(1, 2), pace_hunt=(4, 5), pause=0.2,
    sense_base=4, sense_dark=4, sense_div=25, lose_track=4,
    rest_lose=80, rest_run=40, grace=3)
PULSE = dict(max=3, range=4, stun=10, push=3)
STALKER_DIRS = ((0, -1), (-1, 0), (1, 0), (0, 1))   # tie order: up, left, right, down

STAT_KEYS = ("hp", "atk", "def_", "spa", "spd", "spe")
STAT_LABEL = {"atk": "ATTACK", "def_": "DEFENSE", "spa": "SP.ATK",
              "spd": "SP.DEF", "spe": "SPEED"}


# ============================= LAYER 2: ENGINE =============================
# Pure functions.  Nothing here touches the display or module-level state.

def clamp(v, lo, hi):
    return lo if v < lo else hi if v > hi else v


def stat_at(base, level, is_hp=False):
    if is_hp:
        return int(base * 2 * level / 100) + level + 10
    return int(base * 2 * level / 100) + 5


def hunt_level(party_levels):
    """The hunter's level for a party: best level + offset, clamped."""
    return clamp(max(party_levels) + HUNT["lv_offset"], HUNT["lv_min"], HUNT["lv_max"])


def hunt_count(v):
    """flags["hunt_beaten"] from a save: a non-negative int, garbage -> 0."""
    if isinstance(v, bool) or not isinstance(v, (int, float)) or v != v:
        return 0
    return max(0, int(v))


def xp_for_level(level):
    return level ** 3


def moves_for_level(species_id, level):
    """The four most recent moves learnable at or below ``level``."""
    known = []
    for lvl, move_id in SPECIES[species_id]["learn"]:
        if lvl > level:
            break
        if move_id not in known:
            known.append(move_id)
    return known[-4:]


class Mon:
    """One monster.  Stats are derived, never stored authoritative."""

    __slots__ = ("id", "name", "level", "xp", "moves", "hp", "maxhp",
                 "atk", "def_", "spa", "spd", "spe")

    def __init__(self, species_id, level, nickname=None):
        self.id = species_id
        self.name = nickname or SPECIES[species_id]["name"]
        self.level = level
        self.xp = xp_for_level(level)
        self.moves = moves_for_level(species_id, level)
        self.hp = 0
        self.recalc()
        self.hp = self.maxhp

    def recalc(self):
        b = SPECIES[self.id]["base"]
        self.maxhp = stat_at(b["hp"], self.level, True)
        self.atk = stat_at(b["atk"], self.level)
        self.def_ = stat_at(b["def_"], self.level)
        self.spa = stat_at(b["spa"], self.level)
        self.spd = stat_at(b["spd"], self.level)
        self.spe = stat_at(b["spe"], self.level)

    @property
    def types(self):
        return SPECIES[self.id]["types"]

    def to_dict(self):
        return dict(id=self.id, name=self.name, level=self.level,
                    xp=self.xp, moves=list(self.moves), hp=self.hp)

    @staticmethod
    def from_dict(d):
        if d.get("id") not in SPECIES:
            return None
        mon = Mon(d["id"], int(d.get("level", 5)), d.get("name"))
        mon.xp = int(d.get("xp", xp_for_level(mon.level)))
        moves = [m for m in d.get("moves", []) if m in MOVES]
        mon.moves = moves[:4] or moves_for_level(mon.id, mon.level)
        if mon.id == "zapmote":
            if mon.name == "ZAPMOTE":
                mon.name = "PICKAJOO"
            if "thunderbolt" not in mon.moves:
                mon.moves = mon.moves[:3] + ["thunderbolt"]
        mon.recalc()
        mon.hp = int(clamp(d.get("hp", mon.maxhp), 0, mon.maxhp))
        return mon

    def __repr__(self):
        return "<Mon %s L%d %d/%d>" % (self.name, self.level, self.hp, self.maxhp)


def make_mon(species_id, level, nickname=None):
    return Mon(species_id, level, nickname)


def stage_mul(stage):
    return (2 + stage) / 2 if stage >= 0 else 2 / (2 - stage)


def type_effectiveness(move_type, def_types):
    mul = 1.0
    row = TYPE_CHART.get(move_type, {})
    for t in def_types:
        mul *= row.get(t, 1)
    return mul


def _finite_scale(value, low, high, default):
    return max(low, min(high, value)) if isinstance(value, (float, int)) and math.isfinite(value) else default


def damage_calc(atk_mon, def_mon, move_id, atk_stages, def_stages, rng=None, timing=1.0, crit_bonus=0.0,
                condition=None):
    """Returns dict(missed, dmg, eff, crit).  ``rng`` is injectable so the
    engine can be exercised deterministically.  ``condition`` is a CONDITIONS
    id: its ``acc`` shifts every move that can miss and its ``boost`` scales
    damage after the type chart.  None (or "clear") is today's result, and the
    number of rng draws never depends on it."""
    rnd = rng or random.random
    mv = MOVES[move_id]
    cond = CONDITIONS.get(condition) or CONDITIONS["clear"]

    if mv["acc"] < 999 and rnd() * 100 >= mv["acc"] + cond["acc"]:
        return dict(missed=True, dmg=0, eff=1.0, crit=False)
    if mv["cat"] == "status" or mv["pow"] == 0:
        return dict(missed=False, dmg=0, eff=1.0, crit=False)

    crit = rnd() < min(1, (0.125 if mv.get("high_crit") else 0.0625) + _finite_scale(crit_bonus, 0, .05, 0))
    # A critical hit ignores the attacker's negative and the defender's
    # positive stat stages, the same way the real games handle it.
    a_key = "atk" if mv["cat"] == "phys" else "spa"
    d_key = "def_" if mv["cat"] == "phys" else "spd"
    a_stage = max(0, atk_stages.get(a_key, 0)) if crit else atk_stages.get(a_key, 0)
    d_stage = min(0, def_stages.get(d_key, 0)) if crit else def_stages.get(d_key, 0)

    a = max(1, int(getattr(atk_mon, a_key) * stage_mul(a_stage)))
    d = max(1, int(getattr(def_mon, d_key) * stage_mul(d_stage)))

    dmg = int(int(int(2 * atk_mon.level / 5 + 2) * mv["pow"] * a / d) / 50) + 2
    if crit:
        dmg = int(dmg * 1.5)
    if mv["type"] in SPECIES[atk_mon.id]["types"]:
        dmg = int(dmg * 1.5)                                   # STAB

    eff = type_effectiveness(mv["type"], SPECIES[def_mon.id]["types"])
    dmg = int(dmg * eff)
    dmg = int(dmg * cond["boost"].get(mv["type"], 1))          # battle condition
    dmg = int(dmg * (0.85 + rnd() * 0.15))
    dmg = int(dmg * _finite_scale(timing, .65, 1.2, 1))

    return dict(missed=False, dmg=0 if eff == 0 else max(1, dmg), eff=eff, crit=crit)


def catch_roll(mon, ball_bonus, rng=None, throw_scale=1.0):
    """Ball shake check.  Returns dict(caught, shakes) with shakes in 0..4."""
    rnd = rng or random.random
    rate = SPECIES[mon.id]["catch_rate"]
    a = ((3 * mon.maxhp - 2 * mon.hp) * rate * ball_bonus * _finite_scale(throw_scale, 1, 1.85, 1)) / (3 * mon.maxhp)
    if a >= 255:
        return dict(caught=True, shakes=4)
    b = 65536 / ((255 / a) ** 0.25)
    shakes = 0
    for _ in range(4):
        if rnd() * 65536 >= b:
            return dict(caught=False, shakes=shakes)
        shakes += 1
    return dict(caught=True, shakes=4)


def xp_from_faint(foe):
    return max(1, int(SPECIES[foe.id]["base_exp"] * foe.level / 7))


def gain_xp(mon, amount):
    """Applies XP and returns a list of narratable events."""
    events = []
    mon.xp += amount
    while mon.level < 100 and mon.xp >= xp_for_level(mon.level + 1):
        mon.level += 1
        before = mon.maxhp
        mon.recalc()
        mon.hp += mon.maxhp - before
        events.append(dict(t="level", level=mon.level))

        for lvl, move_id in SPECIES[mon.id]["learn"]:
            if lvl == mon.level and move_id not in mon.moves:
                if len(mon.moves) < 4:
                    mon.moves.append(move_id)
                    events.append(dict(t="move", move=move_id))
                else:
                    dropped = mon.moves.pop(0)
                    mon.moves.append(move_id)
                    events.append(dict(t="swap", move=move_id, dropped=dropped))

        evo = SPECIES[mon.id]["evo"]
        if evo and mon.level >= evo[1]:
            from_name = SPECIES[mon.id]["name"]
            was_named = mon.name != from_name
            mon.id = evo[0]
            if not was_named:
                mon.name = SPECIES[evo[0]]["name"]
            mon.recalc()
            events.append(dict(t="evolve", from_=from_name, into=SPECIES[evo[0]]["name"]))
    return events


def pick_weighted(pool, rng=None):
    rnd = rng or random.random
    total = sum(w for _, w in pool)
    r = rnd() * total
    for key, w in pool:
        r -= w
        if r <= 0:
            return key
    return pool[-1][0]


def zone_at(x, y):
    for z in ZONES:
        if z["x1"] <= x <= z["x2"] and z["y1"] <= y <= z["y2"]:
            return z
    return None


def region_name(y):
    for y1, y2, name in REGIONS:
        if y1 <= y <= y2:
            return name
    return "THE TRAIL"


def in_cave(y):
    return CAVE_BAND[0] <= y <= CAVE_BAND[1]


def ground_tone(gx, gy):
    """Signs, item balls and ledges sit on whatever ground surrounds them.

    Without this they always painted a grass square, which looked wrong on
    the beach and plain broken on a cave floor.
    """
    near = [tile_at(gx + dx, gy + dy) for dx, dy in ((0, 1), (0, -1), (-1, 0), (1, 0))]
    if "c" in near:
        return (56, 52, 64)
    if "s" in near:
        return (224, 204, 150)
    if "_" in near:
        return (192, 168, 124)
    if ROCK_BAND[0] <= gy <= ROCK_BAND[1]:
        return (148, 140, 124)
    return (90, 165, 87)


def picked_ground(gx, gy):
    """The glyph a collected item ball leaves behind: the same ground
    ground_tone paints under it, so a taken cave ball is cave floor, not a
    square of lawn."""
    near = [tile_at(gx + dx, gy + dy) for dx, dy in ((0, 1), (0, -1), (-1, 0), (1, 0))]
    for g in ("c", "s", "_"):
        if g in near:
            return g
    return "."


PICKED_TEXT = {"c": "a scuff on the cave floor", "s": "a hollow in the sand",
               "_": "a scuff on the path", "scree": "a scrape in the scree",
               ".": "a dent in the grass"}


def picked_text(gx, gy):
    """What a collected item ball leaves behind, by the ground picked_ground
    paints there (ROCKY PASS ground is scree, not grass)."""
    g = picked_ground(gx, gy)
    if g == "." and ROCK_BAND[0] <= gy <= ROCK_BAND[1]:
        g = "scree"
    return PICKED_TEXT[g]


def tile_at(x, y, edits=None):
    """The authored tile, or the sandbox overlay's glyph when one is given."""
    if x < 0 or y < 0 or y >= MAP_H or x >= MAP_W:
        return "#"
    if edits and (x, y) in edits:
        return edits[(x, y)]
    return MAP[y][x]


# -- sandbox engine: pure, no Game, no display ------------------------------
DIRS4 = ((0, -1), (0, 1), (-1, 0), (1, 0))


def in_sandbox(x, y):
    """ROCKY PASS interior: the only place a PICK or a WALL works.  The two
    border columns stay unbreakable so the world edge can't be dug through."""
    return ROCK_BAND[0] <= y <= ROCK_BAND[1] and 2 <= x <= MAP_W - 3


def tile_hash(x, y):
    """A 16-bit hash of a tile (Knuth multiplicative, 32-bit).  The HTML
    build computes the same bits with Math.imul, so drops agree exactly."""
    return (((x * 73 + y * 151 + 7) * 2654435761) & 0xFFFFFFFF) >> 16


def pick_tier(v):
    """flags["pick"] as a tier 0..PICK_MAX.  Saves from before the IRON PICK
    stored True for the plain PICK, so True means 1; junk means none."""
    if v is True:
        return 1
    if isinstance(v, bool) or not isinstance(v, int):
        return 0
    return clamp(v, 0, PICK_MAX)


def can_mine(tile, x, y, tier):
    """A PICK of this tier can break tile at (x, y).  Ordinary blocks break
    only inside ROCKY PASS; an authored_only block (the seam) breaks only
    where MAP itself carries that glyph, so it can never spread."""
    b = BLOCKS.get(tile)
    if not b or pick_tier(tier) < b["tier"]:
        return False
    if b.get("authored_only"):
        return tile_at(x, y) == tile
    return in_sandbox(x, y)


def ore_deposits():
    """Every ROCKY PASS boulder that holds ORE, from the deterministic
    mine_drop: the world's whole ORE supply, which never grows back."""
    return tuple((x, y) for y in range(ROCK_BAND[0], ROCK_BAND[1] + 1)
                 for x in range(MAP_W)
                 if MAP[y][x] == "#" and can_mine("#", x, y, 1) and mine_drop("#", x, y).get("ore"))


def mine_drop(tile, x, y):
    """Materials a tile yields.  Deterministic per tile, so ORE can't be
    save-scummed: the boulder at (x, y) always holds the same thing."""
    b = BLOCKS.get(tile)
    if not b:
        return {}
    out = dict(b["drops"])
    if b["ore_one_in"] and tile_hash(x, y) % b["ore_one_in"] == 0:
        out["ore"] = out.get("ore", 0) + 1
    return out


ORE_DEPOSITS = ore_deposits()    # a constant of the authored MAP


def with_edit(edits, x, y, glyph):
    """A new overlay with (x, y) set to glyph.  Matching the authored tile
    removes the entry, so the overlay only ever holds the diff."""
    out = dict(edits)
    if glyph == tile_at(x, y):
        out.pop((x, y), None)
    else:
        out[(x, y)] = glyph
    return out


def craft(materials, recipe, tier=0):
    """A new materials dict with the recipe applied, or None if short.
    Exactly the needs come out and exactly count goes in; nothing else moves.
    A sets_tier recipe (a tool) puts nothing into materials - the caller
    raises the PICK tier - and is refused once the tier is already that high."""
    if recipe.get("sets_tier") and pick_tier(tier) >= recipe["sets_tier"]:
        return None
    if "cap" in recipe and materials.get(recipe["out"], 0) >= recipe["cap"]:
        return None                  # already full: never spend for nothing
    if any(materials.get(k, 0) < n for k, n in recipe["needs"].items()):
        return None
    out = dict(materials)
    for k, n in recipe["needs"].items():
        out[k] -= n
    if not recipe.get("sets_tier"):
        out[recipe["out"]] = out.get(recipe["out"], 0) + recipe["count"]
        if "cap" in recipe:
            out[recipe["out"]] = min(recipe["cap"], out[recipe["out"]])
    return out


def quarry_backstop(materials, tier, edits):
    """The QUARRY HAND's soft-lock guard: materials with BACKSTOP_ORE more
    ORE, or None.  Only for a plain-PICK player short of an IRON PICK's ORE
    after every ORE boulder in the world has been mined (ORE does not grow
    back; it all went into BALLs).  The caller pays it once (flags)."""
    iron = next(r for r in RECIPES if r.get("sets_tier") == PICK_MAX)
    if pick_tier(tier) != 1 or materials.get("ore", 0) >= iron["needs"]["ore"]:
        return None
    if any(tile_at(x, y, edits) == "#" for x, y in ORE_DEPOSITS):
        return None
    out = dict(materials)
    out["ore"] = out.get("ore", 0) + BACKSTOP_ORE
    return out


def tile_blocked(x, y, moving, edits, picked, npc_tiles):
    """Game.blocked_for without the Game: ledges yield only downward, taken
    balls are floor, people are solid."""
    t = tile_at(x, y, edits)
    if t == "v":
        return moving != "down"
    if t == "o" and (x, y) in picked:
        return False
    if t in SOLID:
        return True
    return (x, y) in npc_tiles


def reachable(start, edits, picked, npc_tiles):
    """Every tile the player can walk to from start, ledge vaults included."""
    seen = {tuple(start)}
    queue = [tuple(start)]
    while queue:
        x, y = queue.pop()
        for dx, dy in DIRS4:
            nx, ny = x + dx, y + dy
            if tile_at(nx, ny, edits) == "v":
                if dy != 1 or tile_blocked(nx, ny + 1, "down", edits, picked, npc_tiles):
                    continue
                nxt = (nx, ny + 1)
            elif tile_blocked(nx, ny, "none", edits, picked, npc_tiles):
                continue
            else:
                nxt = (nx, ny)
            if nxt not in seen:
                seen.add(nxt)
                queue.append(nxt)
    return seen


def placement_ok(x, y, edits, picked, npc_tiles, player):
    """(ok, reason) for building a WALL at (x, y).

    Bare ROCKY PASS ground only; never on the player or a person, never
    right beside a sign/item/door/person, and never where it would cut the
    player off from any tile they can reach now - so no wall can seal you
    in, close a corridor, or hide something the trail needs."""
    if not in_sandbox(x, y):
        return False, "You can only build in ROCKY PASS."
    if (x, y) == tuple(player):
        return False, "You are standing there."
    if (x, y) in npc_tiles:
        return False, "Someone is standing there."
    if tile_at(x, y, edits) != ".":
        return False, "Walls go on bare ground."
    for dx, dy in DIRS4:
        n = (x + dx, y + dy)
        if n in npc_tiles or tile_at(n[0], n[1], edits) in INTERACTIVE:
            return False, "Too close to something you need."
    before = reachable(player, edits, picked, npc_tiles)
    after = reachable(player, with_edit(edits, x, y, WALL), picked, npc_tiles)
    if after != before - {(x, y)}:
        return False, "That would wall off part of the trail."
    return True, ""


# --- DARK CAVE horror kit: lantern, tension, the stalker, the PULSE --------

def mulberry32(seed):
    """A tiny seeded PRNG, bit-for-bit the same as the .html build's, so a
    stalker trace replays identically in both.  Returns rng() -> [0, 1)."""
    state = [seed & 0xFFFFFFFF]

    def rng():
        state[0] = (state[0] + 0x6D2B79F5) & 0xFFFFFFFF
        t = state[0]
        t = ((t ^ (t >> 15)) * (t | 1)) & 0xFFFFFFFF
        t ^= (t + (((t ^ (t >> 7)) * (t | 61)) & 0xFFFFFFFF)) & 0xFFFFFFFF
        return ((t ^ (t >> 14)) & 0xFFFFFFFF) / 4294967296
    return rng


CONDITION_SALT = 0xC0DE7   # keeps the battle seed off cave_rng = mulberry32(steps)
SCENE_SALT = 0x5CE7E       # keeps the scene's stream off the condition's


def condition_seed(steps, tx, ty):
    """The battle's condition/scene seed. Own salt, so it never tracks cave_rng."""
    return ((steps * 31 + tx * 977 + ty * 131) ^ CONDITION_SALT) & 0xFFFFFFFF


def battle_condition(region, trainer, hunt, seed):
    """Pure: the condition id for a battle. Never touches the random module."""
    if hunt:
        return "static"
    if trainer and trainer.get("id") == "gym":
        return "clear"
    pool = REGION_CONDITIONS.get(region) or REGION_CONDITIONS["THE TRAIL"]
    pick = mulberry32(seed)() * sum(w for _, w in pool)
    for cid, w in pool:
        pick -= w
        if pick < 0:
            return cid
    return pool[-1][0]


# Battle scene: cosmetic only, so it can never change an outcome.
SCENE_TIMES = [("day", 5), ("dusk", 2), ("dawn", 2), ("night", 1)]
SCENE_WEATHER = {"rain": "rain", "sun": "sun", "fog": "fog", "tremor": "dust", "static": "sparks", "night": "none"}
SCENE_EXTRA = {"meadow": "leaves", "pass": "snow", "ruins": "motes", "cave": "motes", "shore": "none"}
CAMERA_PRESETS = 4
DEFAULT_SCENE = dict(layout=0, time="day", weather="none", camera=0)   # today's look exactly
FORCE_SCENE = None         # test/playtest seam: a scene dict beats battle_scene; never saved


def arena_kind(region, tile, fishing, hunt, sandbox):
    """Which battle arena to draw. Pure; the .html battleArenaKind() calls its twin."""
    if hunt:
        return "cave"
    if fishing:
        return "shore"
    r = region.upper()
    if "CAVE" in r:
        return "cave"
    if "RUIN" in r:
        return "ruins"
    if "ROCK" in r or sandbox:
        return "pass"
    if tile == "~" or "SEASIDE" in r:
        return "shore"
    return "meadow"


def battle_scene(condition, kind, seed):
    """Cosmetic scene descriptor. Its own mulberry32: never random, never FX_RNG.
    Always draws exactly three values (layout, time, camera) so both builds agree."""
    rng = mulberry32((seed ^ SCENE_SALT) & 0xFFFFFFFF)
    layout = int(rng() * 4294967296)
    pick = rng() * sum(w for _, w in SCENE_TIMES)
    time = SCENE_TIMES[-1][0]
    for t, w in SCENE_TIMES:
        pick -= w
        if pick < 0:
            time = t
            break
    if condition == "night" or kind == "cave":
        time = "night"
    weather = SCENE_WEATHER.get(condition) or SCENE_EXTRA.get(kind, "none")
    return dict(layout=layout, time=time, weather=weather, camera=int(rng() * CAMERA_PRESETS))


# --- loot, coins, the shop, save cleaning (pure; never the random module) ---

def loot_seed(steps, tx, ty, foe_level, battles):
    """The battle's loot seed: its own salt, plus the battle counter so the
    same fishing tile can't farm the same roll twice."""
    return ((steps * 31 + tx * 977 + ty * 131 + foe_level * 7919 + battles * 104729) ^ LOOT_SALT) & 0xFFFFFFFF


def loot_roll(region, foe_types, caught, trainer, hunt, seed):
    """Pure: the loot id a battle drops, or None. Own mulberry32; never random.
    The draw order is fixed (both builds): the drop check, the area-or-type
    choice, then a weighted pick on the area branch only."""
    if trainer or hunt:
        return None
    rng = mulberry32(seed)
    if rng() >= LOOT_WIN_CHANCE and not caught:
        return None
    pool = LOOT_AREA.get(region)
    if rng() < LOOT_AREA_SHARE and pool:
        pick = rng() * sum(w for _, w in pool)
        for item, w in pool:
            pick -= w
            if pick < 0:
                return item
        return pool[-1][0]
    return LOOT_TYPE[foe_types[0]]


def coin_reward(foe_level, trainer_max_level, is_gym, gym_paid):
    """Coins for a win: WILD_COIN_RATE per wild level, or TRAINER_COIN_RATE per
    level of a trainer's top monster, plus GYM_BONUS the first time the gym falls. Hunts pay nothing
    (the caller never asks)."""
    if not trainer_max_level:
        return WILD_COIN_RATE * foe_level
    n = TRAINER_COIN_RATE * trainer_max_level
    if is_gym and not gym_paid:
        n += GYM_BONUS
    return n


def blackout_coins(coins):
    """What a blackout leaves you: a quarter is lost, rounded down."""
    return coins - coins // 4


def add_coins(coins, n):
    return clamp(coins + n, 0, COINS_MAX)


def bag_add(bag, item, n):
    """A new bag with ``n`` more (or fewer) ``item``, clamped, zeros dropped."""
    out = dict(bag)
    v = clamp(out.get(item, 0) + n, 0, BAG_MAX)
    if v > 0:
        out[item] = v
    else:
        out.pop(item, None)
    return out


def _qty_ok(qty):
    return type(qty) is int and 1 <= qty <= SHOP_QTY_MAX


def shop_buy(coins, balls, bag, item, qty):
    """-> (coins, balls, bag, ok, reason). "ball" fills the balls counter; any
    other non-loot GOODS id fills the bag. Coins fall by exactly price*qty.
    Reasons: "item", "qty", "coins", "full"."""
    if item == "ball":
        price = BALL_PRICE
    elif item in GOODS and GOODS[item]["kind"] != "loot":
        price = GOODS[item]["price"]
    else:
        return coins, balls, bag, False, "item"
    if not _qty_ok(qty):
        return coins, balls, bag, False, "qty"
    if price * qty > coins:
        return coins, balls, bag, False, "coins"
    have = balls if item == "ball" else bag.get(item, 0)
    if have + qty > BAG_MAX:
        return coins, balls, bag, False, "full"
    if item == "ball":
        return coins - price * qty, balls + qty, bag, True, None
    return coins - price * qty, balls, bag_add(bag, item, qty), True, None


def shop_sell(coins, bag, item, qty):
    """-> (coins, bag, ok, reason). Only loot sells, up to what you own; a sale
    that would pass COINS_MAX is refused ("full") rather than losing coins."""
    if item not in GOODS or GOODS[item]["kind"] != "loot":
        return coins, bag, False, "item"
    if not _qty_ok(qty) or bag.get(item, 0) < qty:
        return coins, bag, False, "qty"
    gain = GOODS[item]["price"] * qty
    if coins + gain > COINS_MAX:
        return coins, bag, False, "full"
    return coins + gain, bag_add(bag, item, -qty), True, None


def bag_toast(coins, balls):
    """The overworld BAG row's toast until the BAG screen exists."""
    return "COINS %d - BALLS %d" % (coins, balls)


def ball_safety_net(balls, coins):
    """The CENTRE's gift: SAFETY_BALLS when you have no balls and can't buy one."""
    return SAFETY_BALLS if balls == 0 and coins < BALL_PRICE else 0


def _whole(v):
    """A save value as an int, or None: finite integral numbers only, never bools."""
    if isinstance(v, bool) or not isinstance(v, (int, float)):
        return None
    if isinstance(v, float) and (not math.isfinite(v) or not v.is_integer()):
        return None
    return int(v)


def clean_bag(raw):
    """A saved bag: known GOODS ids with whole counts, clamped; junk dropped."""
    if not isinstance(raw, dict):
        return {}
    out = {}
    for k in GOODS:
        if k in raw:
            v = clamp(_whole(raw[k]) or 0, 0, BAG_MAX)
            if v > 0:
                out[k] = v
    return out


def clean_coins(raw):
    """Saved coins: absent or None -> START_COINS, junk -> 0, clamped."""
    if raw is None:
        return START_COINS
    return clamp(_whole(raw) or 0, 0, COINS_MAX)


def clean_count(raw):
    """A saved counter (battles): missing or junk -> 0, clamped."""
    return clamp(_whole(raw) or 0, 0, COUNT_MAX)


def lantern_frac(charge):
    return clamp(charge, 0, LANTERN["max"]) / LANTERN["max"]


def lantern_step(charge, cave):
    """The lantern after one completed step: it drains only inside the cave."""
    charge = clamp(int(charge), 0, LANTERN["max"])
    return max(0, charge - LANTERN["drain"]) if cave else charge


def lantern_bucket(charge):
    """0..LANTERN["buckets"]: the lit radius moves in these steps (ceil, so
    any light at all is bucket 1 or more)."""
    n, top = LANTERN["buckets"], LANTERN["max"]
    return -(-n * clamp(int(charge), 0, top) // top)


def lantern_radius(charge):
    """Lit radius in tiles: R_MIN at empty, R_MAX at full, sqrt-shaped so it
    stays generous early and falls away near empty.  Never below R_MIN."""
    f = lantern_bucket(charge) / LANTERN["buckets"]
    return LANTERN["r_min"] + (LANTERN["r_max"] - LANTERN["r_min"]) * math.sqrt(f)


def keep_out(charge, tension):
    """How close (Manhattan) the stalker may come: the light holds it off,
    fear lets it one tile nearer.  Never below 1 - it never shares your tile."""
    f = lantern_frac(charge)
    k = next(v for lo, v in KEEP_OUT if f >= lo)
    if tension >= TENSION["fear"]:
        k -= 1
    return max(1, k)


def in_safe_zone(x, y):
    """Within HUNT_AI["safe_r"] of a cave mouth: no stalker, no contact."""
    return min(abs(x - mx) + abs(y - my) for mx, my in HUNT_AI["mouths"]) <= HUNT_AI["safe_r"]


def tension_step(tension, charge, hunted, safe):
    """Tension after one cave step: it climbs in the dark and while hunted,
    and settles at the mouths (Gemini's sanity stations)."""
    if safe:
        d = TENSION["safe"]
    else:
        f = lantern_frac(charge)
        d = (TENSION["base"] + (TENSION["dim"] if f < 0.5 else 0)
             + (TENSION["dark"] if f < 0.2 else 0) + (TENSION["hunted"] if hunted else 0))
    return clamp(int(tension) + d, 0, TENSION["max"])


def tension_event(tension, event):
    return clamp(int(tension) + TENSION["events"].get(event, 0), 0, TENSION["max"])


def encounter_rate(tension):
    """The wild roll's threshold: ENC_BASE, up to +75% at full tension."""
    return ENC_BASE * (1 + TENSION["enc_bonus"] * clamp(tension, 0, TENSION["max"]) / TENSION["max"])


def stalker_walkable(x, y, edits, picked, npc_tiles):
    """The stalker's domain: the cave's middle rows, open floor (walls,
    unpicked balls and people are solid to it), and never near a mouth - so
    it can never stand in a chokepoint or at an entrance."""
    r0, r1 = HUNT_AI["rows"]
    if not r0 <= y <= r1:
        return False
    if tile_blocked(x, y, "none", edits, picked, npc_tiles):
        return False
    return not in_safe_zone(x, y)


def cave_dist(src, edits, picked, npc_tiles, roam=False):
    """BFS path lengths from src.  Default: through the stalker's domain
    (src itself always counts).  roam=True: through every open cave tile, as
    the player walks it - for spawning far away and for the PULSE's reach."""
    if roam:
        def ok(x, y):
            return in_cave(y) and not tile_blocked(x, y, "none", edits, picked, npc_tiles)
    else:
        def ok(x, y):
            return stalker_walkable(x, y, edits, picked, npc_tiles)
    src = tuple(src)
    dist = {src: 0}
    frontier = [src]
    while frontier:
        nxt = []
        for x, y in frontier:
            d = dist[(x, y)] + 1
            for dx, dy in STALKER_DIRS:
                n = (x + dx, y + dy)
                if n not in dist and ok(*n):
                    dist[n] = d
                    nxt.append(n)
        frontier = nxt
    return dist


def stalker_sense(charge, tension):
    """How far (by path) it smells you: further in the dark and in fear."""
    top = LANTERN["max"]
    c = clamp(int(charge), 0, top)
    dark = (HUNT_AI["sense_dark"] * (top - c) * 2 + top) // (2 * top)   # round half up
    return HUNT_AI["sense_base"] + dark + clamp(int(tension), 0, TENSION["max"]) // HUNT_AI["sense_div"]


def new_stalker(x, y, wp=0):
    return dict(x=x, y=y, mode="patrol", wp=wp, stun=0, grace=0, tick=0)


def stalker_spawn(player, edits, picked, npc_tiles):
    """(x, y, waypoint index): the patrol waypoint furthest (by the player's
    own path) from the player - so it always appears far away."""
    d = cave_dist(player, edits, picked, npc_tiles, roam=True)
    best, best_d = 0, -1
    for i, w in enumerate(HUNT_AI["patrol"]):
        if w in d and d[w] > best_d and stalker_walkable(w[0], w[1], edits, picked, npc_tiles):
            best, best_d = i, d[w]
    x, y = HUNT_AI["patrol"][best]
    return x, y, best


def _nearest_wp(x, y):
    pts = HUNT_AI["patrol"]
    return min(range(len(pts)), key=lambda i: (abs(pts[i][0] - x) + abs(pts[i][1] - y), i))


def stalker_tick(st, player, charge, tension, edits, picked, npc_tiles, rng):
    """One stalker turn, run once per completed player step.  Returns
    (new state, event); event is None, "hunt", "lost", "retreat" or "lunge".
    Pure: st is copied, and rng (a mulberry32) is drawn only on a patrol move."""
    s = dict(st)
    s["tick"] = st["tick"] + 1
    if s["grace"] > 0:
        s["grace"] -= 1
    if s["stun"] > 0:
        s["stun"] -= 1
        return s, None
    px, py = player
    here = (s["x"], s["y"])
    dist = cave_dist(player, edits, picked, npc_tiles)
    ko = keep_out(charge, tension)
    sense = stalker_sense(charge, tension)
    event = None
    d_here = dist.get(here)
    if s["mode"] == "hunt":
        if d_here is None or d_here > sense + HUNT_AI["lose_track"]:
            s["mode"], s["wp"], event = "patrol", _nearest_wp(*here), "lost"
    elif d_here is not None and d_here <= sense:
        s["mode"], event = "hunt", "hunt"

    def man(p):
        return abs(p[0] - px) + abs(p[1] - py)

    def steps():
        for dx, dy in STALKER_DIRS:
            n = (s["x"] + dx, s["y"] + dy)
            if n != (px, py) and stalker_walkable(n[0], n[1], edits, picked, npc_tiles):
                yield n

    if man(here) < ko:
        # The light pushes it back at once, whatever its pace.
        best = max(steps(), key=man, default=None)
        if best is not None and man(best) > man(here):
            s["x"], s["y"] = best
            return s, "retreat"
        return s, event

    num, den = HUNT_AI["pace_hunt"] if s["mode"] == "hunt" else HUNT_AI["pace_patrol"]
    if s["tick"] % den < num:
        if s["mode"] == "hunt":
            field, cur = dist, d_here
        else:
            if here == HUNT_AI["patrol"][s["wp"]]:
                s["wp"] = (s["wp"] + 1) % len(HUNT_AI["patrol"])
            field = None
            if rng() >= HUNT_AI["pause"]:
                field = cave_dist(HUNT_AI["patrol"][s["wp"]], edits, picked, npc_tiles)
                cur = field.get(here)
        if field is not None and cur is not None:
            best = None
            for n in steps():
                if man(n) >= ko and n in field and field[n] < cur and \
                        (best is None or field[n] < field[best]):
                    best = n
            if best is not None:
                s["x"], s["y"] = best

    if (ko == 1 and man((s["x"], s["y"])) <= 1 and s["grace"] == 0
            and not in_safe_zone(px, py)):
        return s, "lunge"
    return s, event


def bump(st, tile):
    """Walking onto an unstunned stalker is a deliberate fight; a stunned one
    is walked straight past."""
    return st is not None and st["stun"] == 0 and (st["x"], st["y"]) == tuple(tile)


def pulse_apply(st, player, edits, picked, npc_tiles):
    """(new state, hit): a stalker within PULSE["range"] by path (never
    through rock) is stunned and shoved up to PULSE["push"] tiles away."""
    if st is None:
        return None, False
    d = cave_dist(player, edits, picked, npc_tiles, roam=True)
    here = (st["x"], st["y"])
    if here not in d or d[here] > PULSE["range"]:
        return dict(st), False
    s = dict(st, stun=PULSE["stun"], mode="patrol", wp=_nearest_wp(*here))
    for _ in range(PULSE["push"]):
        cur = d.get((s["x"], s["y"]), 0)
        best = None
        for dx, dy in STALKER_DIRS:
            n = (s["x"] + dx, s["y"] + dy)
            if stalker_walkable(n[0], n[1], edits, picked, npc_tiles) and n in d and \
                    d[n] > cur and (best is None or d[n] > d[best]):
                best = n
        if best is None:
            break
        s["x"], s["y"] = best
    return s, True


# ============================== LAYER 3: STATE =============================

MENU_ITEMS = ["PARTY", "SAVE", "BAG", "CRAFT", "PULSE", "CLOSE"]
# The rows the overworld menu shows: the shared table with SETTINGS just before
# CLOSE, so CLOSE stays last (the HTML build's menuRows() without DESCEND).
MENU_ROWS = MENU_ITEMS[:-1] + ["SETTINGS", MENU_ITEMS[-1]]
# SETTINGS screen rows: (settings key, label, cycle order); None is BACK.
SETTINGS_ROWS = [("actionMode", "ACTION COMMANDS", ("ON", "ASSIST", "AUTO")),
                 ("reducedMotion", "REDUCED MOTION", (False, True)),
                 ("quality", "EFFECTS", ("STANDARD", "HIGH", "LOW")),
                 (None, "BACK", ())]


def command_context(hunt, trainer, team_idx):
    """Timing-window context for an action command: a hunt always wins, then
    a trainer's last team member is their ace, else normal.  The same rule as
    the HTML build's commandContext({hunt, trainer, teamIdx})."""
    if hunt:
        return "hunt"
    if trainer and team_idx == len(trainer["team"]) - 1:
        return "ace"
    return "normal"


def cycle_setting(settings, key):
    """settings with key advanced to its next value (wrapping); pure."""
    order = next(o for k, _, o in SETTINGS_ROWS if k == key)
    cur = settings.get(key)
    nxt = order[(order.index(cur) + 1) % len(order)] if cur in order else order[0]
    return normalize_settings(dict(settings, **{key: nxt}))


def settings_label(settings, row):
    key, label, _ = SETTINGS_ROWS[row]
    if key is None:
        return label
    v = settings[key]
    return "%s: %s" % (label, ("ON" if v else "OFF") if isinstance(v, bool) else v)


def menu_label(g, item):
    if item == "PULSE":
        return "PULSE x%d" % g.pulses
    return item


def cave_hud_text(g):
    return "LAMP %d%%  TENSION %d  PULSE %d" % (g.lantern, g.tension, g.pulses)


def craft_rows(g):
    """(name, detail, craftable) per CRAFT row: each recipe, BUILD, BACK."""
    tier = pick_tier(g.flags.get("pick"))
    m = g.materials
    have = dict(m, balls=g.balls, lantern=g.lantern, pulse=g.pulses)
    rows = []
    for r in RECIPES:
        need = ", ".join("%d %s" % (n, MATERIAL_LABEL[k]) for k, n in r["needs"].items())
        can = craft(have, r, tier) is not None
        if r.get("sets_tier"):
            owned = tier >= r["sets_tier"]
            rows.append((MATERIAL_LABEL[r["out"]],
                         "owned - it cracks seams" if owned else "from " + need + " - cracks seams",
                         not owned and can))
        elif r["out"] == "lantern":
            rows.append((MATERIAL_LABEL["lantern"], "from %s - lamp %d%%" % (need, g.lantern), can))
        elif "cap" in r:
            rows.append(("%d %s" % (r["count"], MATERIAL_LABEL[r["out"]]),
                         "from %s - have %d/%d" % (need, have[r["out"]], r["cap"]), can))
        else:
            rows.append(("%d %s" % (r["count"], MATERIAL_LABEL[r["out"]]), "from " + need, can))
    rows.append(("BUILD WALLS", "place WALLs in ROCKY PASS", m["wall"] > 0))
    rows.append(("BACK", "", True))
    return rows


# The overworld BAG screen and the CENTRE shop.  Pure list builders (the
# shell only draws them) and their strings, compared across builds by PARITY.
BAG_BALL_DESC = "A plain BALL for catching wild monsters. The CENTRE shop sells more."
BAG_MAT_DESC = {"stone": "Rough STONE from ROCKY PASS. CRAFT turns it into WALLs.",
                "ore": "Metal ORE from ROCKY PASS. CRAFT turns it into BALLs.",
                "wall": "A WALL block. Choose BUILD WALLS in CRAFT to place it."}
BAG_MSG = {"full": "It won't have any effect.", "fainted": "A POTION can't revive a fainted monster.",
           "healed": "%s recovered %d HP!", "pick": "Use %s on which monster?"}
SHOP_STOCK = ["ball", "greatball", "potion", "superpotion", "smoke"]   # the BUY list, in order
SHOP_OFFER = ["SHOP", "LEAVE"]           # after the CENTRE heal
SHOP_MAIN = ["BUY", "SELL", "BACK"]
SHOP_MSG = {"coins": "Not enough coins.", "full": "Your bag is full.",
            "purse": "Your coin purse is full.", "bought": "Bought %d %s for %d coins.",
            "sold": "Sold %d %s for %d coins.", "empty": "You have nothing to sell."}


def bag_name(item):
    """Display name of a BAG row id: the BALL, a GOODS entry or a material."""
    if item == "ball":
        return "BALL"
    if item in GOODS:
        return GOODS[item]["name"]
    return MATERIAL_LABEL.get(item, str(item).upper())


def bag_desc(item):
    if item == "ball":
        return BAG_BALL_DESC
    if item in GOODS:
        return GOODS[item]["desc"]
    return BAG_MAT_DESC.get(item, "")


def bag_rows(balls, bag, materials):
    """The BAG screen, top to bottom: (kind, id, count).  kind is "head" (a
    section title), "none" (an empty section), or a selectable row: "item"
    (BALL and the battle items), "mat" (read-only materials) or "loot"."""
    items = ([("item", "ball", balls)] if balls > 0 else []) + \
        [("item", k, bag[k]) for k in GOODS if GOODS[k]["kind"] != "loot" and bag.get(k, 0) > 0]
    loot = [("loot", k, bag[k]) for k in GOODS if GOODS[k]["kind"] == "loot" and bag.get(k, 0) > 0]
    mats = [("mat", k, materials.get(k, 0)) for k in MATERIALS]
    rows = []
    for title, part in (("ITEMS", items), ("MATERIALS", mats), ("LOOT", loot)):
        rows.append(("head", title, 0))
        rows.extend(part or [("none", title, 0)])
    return rows


def bag_entries(rows):
    """Indexes of the selectable rows (what the BAG cursor walks)."""
    return [i for i, r in enumerate(rows) if r[0] in ("item", "mat", "loot")]


def list_top(n, cur, size):
    """First visible row of a ``size``-row window over ``n`` rows that keeps
    row ``cur`` in view, a little above centre."""
    return max(0, min(cur - (size - 1) // 2, n - size))


def heal_refusal(mon):
    """None when a POTION can be used on ``mon``, else the BAG_MSG key."""
    if mon.hp <= 0:
        return "fainted"
    if mon.hp >= mon.maxhp:
        return "full"
    return None


def shop_rows(page, bag):
    """BUY: (id, name, price) for SHOP_STOCK.  SELL: (id, name, price, owned)
    for the loot you own, in GOODS order."""
    if page == "buy":
        return [(k, bag_name(k), BALL_PRICE if k == "ball" else GOODS[k]["price"]) for k in SHOP_STOCK]
    return [(k, GOODS[k]["name"], GOODS[k]["price"], bag[k]) for k in GOODS
            if GOODS[k]["kind"] == "loot" and bag.get(k, 0) > 0]


def shop_qty_cap(page, row):
    """The quantity picker's top: SHOP_QTY_MAX, or what you own when selling."""
    return SHOP_QTY_MAX if page == "buy" else max(1, min(SHOP_QTY_MAX, row[3]))


def load_edits(raw):
    """A saved overlay back to {(x, y): glyph}, keeping only edits the rules
    could have produced: ROCKY PASS interior, a boulder mined to ground, or a
    WALL on what was ground or boulder - or an authored seam (K) mined to cave
    floor.  Anything else in a save is dropped."""
    out = {}
    if not isinstance(raw, dict):
        return out
    for k, v in raw.items():
        try:
            x, y = (int(c) for c in str(k).split(","))
        except ValueError:
            continue
        base = tile_at(x, y)
        if v == base:
            continue
        b = BLOCKS.get(base)
        if b and b.get("authored_only"):
            if v == b["leaves"]:             # an authored seam, mined open
                out[(x, y)] = v
            continue
        if not in_sandbox(x, y):
            continue
        if (base == "#" and v in (".", WALL)) or (base == "." and v == WALL):
            out[(x, y)] = v
    return out


SAVE_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                         "monster-trail-save.json")

START_TILE = (43, 107)
GYM_REQUIREMENT = 6          # trainers you must beat before the doors open


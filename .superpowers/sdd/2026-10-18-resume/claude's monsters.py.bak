    (48, 7):   ["Beyond this point the wind does the talking."],
    (34, 13):  ["SPIRE RUINS. Older than the towns, older than the trail.",
                "The pillars hum at dusk. Nobody agrees why."],
    (52, 22):  ["Whatever drifts between these stones is not quite alive.",
                "DARK moves land hard on the mind-readers here."],
    (28, 40):  ["ROCKY PASS. Loose stone underfoot.",
                "The cave mouth north of here is unlit. Bring a strong team.",
                "Something big hunts in there. PSYCHIC tricks do nothing to it."],
    (45, 54):  ["RIDGE TOWN - halfway up, and the last bed before the cave."],
    (18, 59):  ["CENTRE: free healing, and a shop. No catch."],
    (52, 59):  ["North to ROCKY PASS. South to the SEASIDE.",
                "Mind the ledges - they only go one way."],
    (47, 69):  ["SEASIDE. Face the water and press the action button to fish.",
                "The plank bridge runs out to the bay island."],
    (24, 91):  ["DEEPWOOD. The path knots up in there.",
                "Keep heading north and you will come out the other side."],
    (27, 94):  ["MIRROR LAKE. Face the water and press the action button to fish."],
    (19, 107): ["CEDAR TOWN - where every trail starts."],
    (54, 107): ["PROF. CEDAR RUNS THE LAB. Knock before you wander in."],
}


# Sandbox slice: mining and building, ROCKY PASS only.  The authored MAP is
# never touched; Game.edits overlays it as {(x, y): glyph} and saves as a diff.
# Loop: get a PICK from the QUARRY HAND -> mine boulders for STONE (and ORE)
# -> craft WALLs to build with, or ORE into BALLs for the creature loop
# -> or 3 ORE + 6 STONE into an IRON PICK, which opens the one CRACKED SEAM
# (K) in the DARK CAVE and the sealed GEODE behind it.
WALL = "W"                       # a player-built wall; never authored in MAP
SEAM = "K"                       # a cracked seam; authored in MAP, IRON PICK only
MATERIALS = ["stone", "ore", "wall"]
MATERIAL_LABEL = {"stone": "STONE", "ore": "ORE", "wall": "WALL", "balls": "BALL",
                  "iron_pick": "IRON PICK", "lantern": "LAMP OIL", "pulse": "PULSE"}
BLOCKS = {                       # what a PICK can break, and what falls out
    "#": dict(name="BOULDER", drops={"stone": 1}, ore_one_in=4, leaves=".", tier=1),
    "W": dict(name="STONE WALL", drops={"stone": 2}, ore_one_in=0, leaves=".", tier=1),
    # authored_only: breakable only where MAP itself has the glyph (it is
    # outside ROCKY PASS, so in_sandbox does not apply), never anywhere else.
    "K": dict(name="CRACKED SEAM", drops={"ore": 2}, ore_one_in=0, leaves="c", tier=2,
              authored_only=True),
}
RECIPES = [                      # shapeless; "balls" is the existing pouch counter
    dict(id="wall", out="wall", count=1, needs={"stone": 2}),
    dict(id="ball", out="balls", count=1, needs={"ore": 2}),
    # sets_tier: a tool, not a material - it raises the PICK tier and is
    # never stored in materials, so it can be crafted once and only once.
    dict(id="iron_pick", out="iron_pick", count=1, needs={"ore": 3, "stone": 6}, sets_tier=2),
    # cap: a counter with a ceiling (Game.lantern, Game.pulses), not a
    # material - refused when already full, otherwise filled up to the cap.
    dict(id="oil", out="lantern", count=50, needs={"ore": 1}, cap=100),
    dict(id="pulse", out="pulse", count=1, needs={"ore": 1, "stone": 2}, cap=3),
]
PICK_MAX = 2                     # flags["pick"]: 0 none, 1 PICK, 2 IRON PICK
GEODE = (65, 30, 75, 34)         # x1, y1, x2, y2: the pocket behind the seam, entrance row included
BACKSTOP_ORE = 3                 # the QUARRY HAND's one-off top-up for a player out of ORE
INTERACTIVE = set("SoHDG")       # a wall may never be built right beside these
GRASS = (",", ";")               # tall grass and dark grass both hide wild monsters


"""MONSTER TRAIL - a single-file creature-collector RPG.

No image or audio assets: every sprite is drawn from pygame primitives and
every sound is synthesized into a raw PCM buffer at runtime.

Four layers, top to bottom:
    1. DATA    - types, moves, species, map. Pure tables.
    2. ENGINE  - stats, damage, catching, XP. Pure functions, injectable rng.
    3. STATE   - the Game object and its mode machine.
    4. SHELL   - pygame rendering, input, main loop.

Layers 1-3 import pygame but never touch the display, and main() is behind an
``if __name__ == "__main__"`` guard, so this module can be imported and tested
headlessly.  See "claude's monsters.test.py".

    .venv/Scripts/python.exe "claude's monsters.py"
"""

import json
import math
import os
import random
import struct
import sys
from combat.commands import PROFILES, create_command, step_command, judge_command, normalize_settings


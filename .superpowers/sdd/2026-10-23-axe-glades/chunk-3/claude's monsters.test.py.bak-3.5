    ok(set(sp["base"]) == set(mt.STAT_KEYS), "%s base stats keys %s" % (sid, sorted(sp["base"])))
    for lvl in range(1, 61):
        got = mt.moves_for_level(sid, lvl)
        ok(1 <= len(got) <= 4, "%s at L%d knows %d moves" % (sid, lvl, len(got)))


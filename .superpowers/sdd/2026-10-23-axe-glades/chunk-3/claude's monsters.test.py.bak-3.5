           "an empty BAG shows COINS, three sections and (none) twice: %s" % strs[:6])
        ok(not cue_px(bx + bw - 24, by + 56 + mt.BAG_ROW_H // 2)
           and not cue_px(bx + bw - 24, by + 56 + (mt.BAG_ROWS - 1) * mt.BAG_ROW_H + mt.BAG_ROW_H // 2),

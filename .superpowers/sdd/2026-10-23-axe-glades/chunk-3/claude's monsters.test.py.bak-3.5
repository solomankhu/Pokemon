# The same number of random() calls at any tension: only the threshold moves.
class _CountingRandom:
    def __init__(self, v):
        self.v, self.n = v, 0

    def random(self):
        self.n += 1
        return self.v

    def randint(self, a, b):
        self.n += 1
        return a

    def choice(self, seq):
        self.n += 1
        return seq[0]



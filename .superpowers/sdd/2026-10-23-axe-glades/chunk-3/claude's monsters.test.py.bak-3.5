            ok(want <= frozen_run(crit, ch[0]) <= want + 1,
               "crit hit-stop lasts ~%d frames (%d)" % (want, frozen_run(crit, ch[0])))
    ok(expect(0.5, False)[1] < expect(1, False)[1] < expect(2, False)[1] < expect(2, True)[1],

    def band_of(gy):
        if mt.in_cave(gy):
            return "cave"
        if mt.RUINS_BAND[0] <= gy <= mt.RUINS_BAND[1]:
            return "ruins"
        if mt.ROCK_BAND[0] <= gy <= mt.ROCK_BAND[1]:
            return "rock"
        return "normal"



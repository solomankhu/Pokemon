def face_and_mine(bx, by):
    for dx, dy, d in ((1, 0, "left"), (-1, 0, "right"), (0, 1, "up"), (0, -1, "down")):
        sx, sy = bx + dx, by + dy
        if g.blocked_for(sx, sy) or mt.tile_at(sx, sy, g.edits) == "v":
            continue
        res = walk_to(sx, sy)
        if res.get("arrived"):
            g.player.dir = d
            before = dict(g.materials)
            g.interact()
            return {k: g.materials[k] - before[k] for k in g.materials}
    return None



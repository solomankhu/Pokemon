    mt.REDUCED_MOTION = False
    pygame.display.quit()
    if os.path.exists(mt.SAVE_PATH):
        os.remove(mt.SAVE_PATH)
print("  %d render checks in %.1fs" % (PASSED - _render_p0, _time.perf_counter() - _render_t0))


        ok(mt.can_mine("#", bx, by, tier, axe) == (tier >= 1), "boulder: pick %d axe %d" % (tier, axe))
        ok(mt.can_mine(mt.SEAM, sx, sy, tier, axe) == (tier >= 2), "seam: pick %d axe %d" % (tier, axe))

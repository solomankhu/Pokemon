    if (sub) text(sub, x + w - 40, ry + 14, 11, can ? '#6f8ba8' : '#aaaeb4', 'right');
  }
  if (top > 0) scrollCue(x + w - 24, y + 92 + 8, true);
  if (end < rows.length) scrollCue(x + w - 24, y + 92 + (CRAFT_ROWS - 1) * CRAFT_ROW_H + 8, false);

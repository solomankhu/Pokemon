  const top = listTop(rows.length, G.craftCursor, CRAFT_ROWS), end = Math.min(rows.length, top + CRAFT_ROWS);
  for (let i = top; i < end; i++) {
    const [name, sub, can] = rows[i], ry = y + 92 + (i - top) * CRAFT_ROW_H;
    if (i === G.craftCursor) {
      ctx.fillStyle = '#e2ecf8';
      rr(x + 16, ry - 6, w - 32, CRAFT_ROW_H - 2, 6); ctx.fill();
      ctx.fillStyle = '#22303f';
      ctx.beginPath();
      ctx.moveTo(x + 24, ry + 4); ctx.lineTo(x + 34, ry + 9); ctx.lineTo(x + 24, ry + 14);
      ctx.closePath(); ctx.fill();
    }
    text(name, x + 44, ry + 14, 15, can ? '#22303f' : '#969ca4');

function drawActionCommand(b) {
  const c=b.command,p=CombatCommands.PROFILES[c.kind],scale=(c.mode==='ASSIST'?2:1)*(c.context==='hunt'?.8:c.context==='ace'?.9:1);
  if(!c.ready||c.waitingRelease){
    const guide={strike:['ATTACK: TIMED STRIKE','Press when the marker reaches the gold band.'],charge:['ATTACK: CHARGE','Hold, then release when the marker reaches gold.'],guard:['DEFENSE: RAISE YOUR SHIELD','Press in the gold band to reduce incoming damage.'],catch:['CATCH: AIM YOUR THROW','Hold, then release when the ring reaches gold.']}[c.kind];
    text(guide[0],W/2,H-91,15,'#22303f','center');
    text(c.mode==='AUTO'?'AUTO handles timing with normal power.':guide[1],W/2,H-67,12,'#52677c','center');
    text(c.waitingRelease?'Release to begin.':'Take your time. Z / ENTER / A when ready.',W/2,H-36,13,'#277957','center');return;
  }
  const labels={strike:'STRIKE - press Z / ENTER in the bright band',charge:c.armed?'CHARGE - release in the bright band':'CHARGE - hold Z / ENTER, then release',guard:'GUARD - press Z / ENTER on the cue',catch:c.armed?'THROW - release in the smallest ring':'THROW - hold Z / ENTER, then release'};
  text(labels[c.kind],W/2,H-82,13,'#22303f','center');
  text('Touch: A button    O: battle settings',W/2,H-60,10,'#52677c','center');
  const left=56,width=W-112,y=H-43,target=left+width*p.target/p.duration;
  ctx.fillStyle='#263e53';rr(left,y,width,13,5);ctx.fill();
  const outer=(p.good||p.nice)*scale*width/p.duration,inner=(p.perfect||p.excellent)*scale*width/p.duration;
  ctx.fillStyle='#5ca97c';ctx.fillRect(Math.max(left,target-outer),y,Math.min(width,outer*2),13);
  ctx.fillStyle='#ffe585';ctx.fillRect(target-inner,y,inner*2,13);
  const x=left+width*clamp(c.elapsed/p.duration,0,1);
  ctx.fillStyle='#fff';ctx.strokeStyle='#22303f';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(x,y-8);ctx.lineTo(x-7,y-17);ctx.lineTo(x+7,y-17);ctx.closePath();ctx.fill();ctx.stroke();
  if(c.kind==='guard'&&Math.abs(c.elapsed-p.target)<p.good*scale)text('!',W/2,H-94,20,'#a63e36','center');
  if(c.kind==='catch'){
    ctx.strokeStyle='#3e8875';ctx.lineWidth=2;ctx.beginPath();ctx.arc(W-50,H-70,7+16*(1-clamp(c.elapsed/p.duration,0,1)),0,Math.PI*2);ctx.stroke();
  }
}

const SCENE_SKY = {"day": [[159, 210, 240], [216, 238, 201]], "dusk": [[240, 170, 120], [250, 214, 170]], "dawn": [[236, 186, 206], [244, 226, 200]], "night": [[26, 36, 72], [58, 72, 104]]};
const WEATHER_2D = {"rain": {"n": 70, "vy": 420, "vx": -60, "len": 10, "color": [170, 200, 235]}, "snow": {"n": 50, "vy": 40, "vx": 10, "len": 2, "color": [245, 245, 250]}, "leaves": {"n": 18, "vy": 30, "vx": 24, "len": 3, "color": [206, 150, 70]}, "dust": {"n": 30, "vy": 6, "vx": 30, "len": 2, "color": [196, 170, 130]}, "sparks": {"n": 16, "vy": 0, "vx": 0, "len": 2, "color": [140, 220, 255]}, "motes": {"n": 20, "vy": -8, "vx": 4, "len": 2, "color": [220, 230, 210]}, "fog": {"n": 0, "vy": 0, "vx": 0, "len": 0, "color": [220, 226, 232]}, "sun": {"n": 0, "vy": 0, "vx": 0, "len": 0, "color": [255, 236, 180]}};
// Cosmetic pool, separate from battle/save state and the engine/juice RNGs.
function weather2DStep(prev,scene,dt,reduced){
 const s=scene||DEFAULT_SCENE,key=[s.layout,s.time,s.weather].join('|'),cfg=WEATHER_2D[s.weather];
 let pool=prev;if(!pool||pool.key!==key){const rng=mulberry32(s.layout>>>0);pool={key,age:0,parts:Array.from({length:cfg?cfg.n:0},()=>[rng()*640,rng()*360,rng()*Math.PI*2])};}
 if(reduced||!dt)return pool;
 return {key,age:pool.age+dt,parts:pool.parts.map(p=>[(p[0]+cfg.vx*dt+640)%640,(p[1]+cfg.vy*dt+360)%360,p[2]+dt])};
}
let weather2DPool=null,weather2DBattle=null;
function bindWeather2D(b,dt=0){if(b!==weather2DBattle){weather2DBattle=b;weather2DPool=null;}weather2DPool=weather2DStep(weather2DPool,b&&b.scene,dt,scareCalm());}
function drawWeather2D(b){
 bindWeather2D(b);const scene=b.scene||DEFAULT_SCENE,w=scene.weather,cfg=WEATHER_2D[w];
 const tint={night:'rgba(16,24,65,.22)',dusk:'rgba(185,85,45,.12)',dawn:'rgba(210,130,170,.10)'}[scene.time];
 if(tint){ctx.fillStyle=tint;ctx.fillRect(0,0,W,360);}
 if(w==='fog'){ctx.fillStyle='rgba(220,226,232,.30)';ctx.fillRect(0,120,W,120);}
 if(w==='sun'){ctx.fillStyle='rgba(255,236,180,.15)';ctx.fillRect(0,0,W,360);}
 if(!cfg)return;ctx.save();ctx.beginPath();ctx.rect(0,0,W,360);ctx.clip();ctx.fillStyle=ctx.strokeStyle='rgb('+cfg.color.join(',')+')';ctx.lineWidth=1;
 for(const p of weather2DPool.parts){if(w==='rain'){ctx.beginPath();ctx.moveTo(p[0],p[1]);ctx.lineTo(p[0]+cfg.vx/cfg.vy*cfg.len,p[1]+cfg.len);ctx.stroke();}
 else {ctx.globalAlpha=w==='sparks'?.5+.5*Math.abs(Math.sin(p[2]*4)):1;ctx.fillRect(p[0],p[1],cfg.len,cfg.len);}}
 ctx.restore();
}

function drawBattle() {
  const b = G.battle;
  if (!b) return;
  const live3D=battleHost&&battleHost.is3D();
  if (live3D) ctx.clearRect(0,0,W,H);
  if (live3D && b.hunt) {
    ctx.fillStyle='rgba(0,0,0,'+((b.scare==='dark'?SCARE_VEIL_DARK:SCARE_VEIL)/255).toFixed(3)+')';
    ctx.fillRect(0,0,W,H-118);
    if(b.scareFlash>0&&!scareCalm()){
      ctx.fillStyle='rgba(255,255,255,'+(SCARE_FLASH_ALPHA*b.scareFlash/SCARE_FLASH_TIME).toFixed(3)+')';
      ctx.fillRect(0,0,W,H-118);
    }
  }
  if (!live3D) {

  // Backdrop.
  const grd = ctx.createLinearGradient(0, 0, 0, H);
  const sky=SCENE_SKY[(b.scene||DEFAULT_SCENE).time]||SCENE_SKY.day;
  grd.addColorStop(0, 'rgb('+sky[0].join(',')+')');
  grd.addColorStop(1, 'rgb('+sky[1].join(',')+')');
  ctx.fillStyle = grd;
  ctx.fillRect(0, 0, W, H);
  // Trauma shake: offset = trauma^2 * SHAKE_MAX, applied to the arena only
  // (platforms, sprites, ball, particles) - never the HP boxes or text.
  const shk = b.trauma * b.trauma * SHAKE_MAX * SHAKE_SCALE;
  const ox = shk > 0 ? (fxRand() * 2 - 1) * shk : 0;
  const oy = shk > 0 ? (fxRand() * 2 - 1) * shk : 0;

  ctx.fillStyle = '#b6d9a0';
  ctx.beginPath(); ctx.ellipse(W * 0.66 + ox, 210 + oy, 130, 30, 0, 0, Math.PI * 2); ctx.fill();
  ctx.fillStyle = '#a8cf92';
  ctx.beginPath(); ctx.ellipse(W * 0.26 + ox, 340 + oy, 150, 34, 0, 0, Math.PI * 2); ctx.fill();

  drawWeather2D(b);

  // The hunt is fought in the dark: a veil over the arena, near black while
  // the foe is still hidden. Sprites draw on top of it.
  if (b.hunt) {
    ctx.fillStyle = 'rgba(0,0,0,' + ((b.scare === 'dark' ? SCARE_VEIL_DARK : SCARE_VEIL) / 255).toFixed(3) + ')';
    ctx.fillRect(0, 0, W, H - 118);
  }

  // White damage flash: fades out over FLASH_TIME (no strobing blink).
  const flashA = b.flashT > 0 ? FLASH_ALPHA * (b.flashT / FLASH_TIME) : 0;

  // Foe sprite (hidden while caught, or while the hunter is still in the dark).
  if (!b.hiddenFoe && !(b.ballAnim && b.ballAnim.caught && b.ballAnim.t > 0.4) && b.scare !== 'dark') {
    const [fx, fy, fs] = foePose(b);
    drawCreature(SPECIES[b.foe.id], fx + ox, fy + oy, fs, true, false, b.animT);
    if (flashA > 0 && b.flashSide === 'foe') {
      drawCreatureFlash(SPECIES[b.foe.id], fx + ox, fy + oy, fs, true, false, b.animT, flashA);
    }
  }

  // Player sprite (back view).
  if (b.mine.hp > 0&&!b.hiddenMine) {
    drawCreature(SPECIES[b.mine.id], W * 0.26 + ox, 306 + oy, 92, false, true, b.animT);
    if (flashA > 0 && b.flashSide === 'mine') {
      drawCreatureFlash(SPECIES[b.mine.id], W * 0.26 + ox, 306 + oy, 92, false, true, b.animT, flashA);
    }
  }

  drawParticles(ox, oy);

  // The same defensive cue remains readable in Basic presentation.
  const defense=b.command?.kind==='guard'||b.action&&(['GUARD','PERFECT'].includes(b.action.guardTier)||['harden','ironguard'].includes(b.action.moveId));
  if(defense){
    const foeDefense=b.action&&['harden','ironguard'].includes(b.action.moveId)&&b.action.actor==='foe';
    const sx=(foeDefense?W*.66-28:W*.26+38)+ox,sy=(foeDefense?150:260)+oy;
    ctx.save();ctx.translate(sx,sy);ctx.beginPath();ctx.moveTo(0,-38);ctx.lineTo(30,-25);ctx.lineTo(25,12);ctx.lineTo(0,38);ctx.lineTo(-25,12);ctx.lineTo(-30,-25);ctx.closePath();
    const perfect=b.action?.guardTier==='PERFECT';ctx.fillStyle=perfect?'rgba(255,216,107,.35)':'rgba(88,207,255,.32)';ctx.fill();ctx.strokeStyle=perfect?'#ffefb4':'#b8f4ff';ctx.lineWidth=3;ctx.stroke();ctx.restore();
  }

  // Thrown ball.
  if (b.ballAnim) {
    const t = clamp(b.ballAnim.t, 0, 1);
    const sx = W * 0.26 + ox, sy = 290 + oy, ex = W * 0.66 + ox, ey = 178 + oy;
    const bx = sx + (ex - sx) * Math.min(1, t * 2.2);
    const by = sy + (ey - sy) * Math.min(1, t * 2.2) - Math.sin(Math.min(1, t * 2.2) * Math.PI) * 70;
    const wobble = t > 0.45 ? Math.sin(b.ballAnim.t * 16) * Math.min(b.ballAnim.shakes, 3) * 3 : 0;
    ctx.save();
    ctx.translate(bx + wobble, by);
    ctx.rotate(t < 0.45 ? t * 12 : wobble * 0.04);
    ctx.fillStyle = '#e84a4a';
    ctx.beginPath(); ctx.arc(0, 0, 11, Math.PI, 0); ctx.fill();
    ctx.fillStyle = '#f4f4f4';
    ctx.beginPath(); ctx.arc(0, 0, 11, 0, Math.PI); ctx.fill();
    ctx.fillStyle = '#2a3340';
    ctx.fillRect(-11, -2, 22, 4);
    ctx.beginPath(); ctx.arc(0, 0, 4, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = '#e8eef4';
    ctx.beginPath(); ctx.arc(0, 0, 2, 0, Math.PI * 2); ctx.fill();
    ctx.restore();
  }

  // The single scare flash: white over the arena, fading out.
  if (b.scareFlash > 0) {
    ctx.fillStyle = 'rgba(255,255,255,' + (SCARE_FLASH_ALPHA * b.scareFlash / SCARE_FLASH_TIME).toFixed(3) + ')';
    ctx.fillRect(0, 0, W, H - 118);
  }
  }

  // While the hunter is still in the dark, nothing names it: no foe box or chips.
  text('1 vs 1',W/2,19,11,'#d6e8f5','center');
  const foeKnown = b.scare !== 'dark';
  if (foeKnown) hpBox(b.foe, 24, 28, 260, b.dispFoe, false);
  // Sits below the foe's platform (which ends at y=240), not across it.
  hpBox(b.mine, W - 284, live3D?286:248, 260, b.dispMine, true);
  if(b.actionFeedback&&b.actionFeedback.tier!=='OK')text((b.actionFeedback.tier==='GUARD'?'BLOCKED':b.actionFeedback.tier)+'!',W*.5,337,18,'#ffe585','center');

  // Type chips under the foe box, in declaration order.
  if (foeKnown) SPECIES[b.foe.id].types.forEach((t, i) => {
    // 11px on a 66x18 chip: legible at 1x, and the longest name (ELECTRIC)
    // fits without squeezing. Spans y 86-104, between the box (ends 80) and
    // anything else on the left of the arena.
    const cx = 30 + i * 72;
    ctx.fillStyle = TYPE_COLOR[t];
    rr(cx, 86, 66, 18, 4); ctx.fill();
    ctx.strokeStyle = 'rgba(0,0,0,0.35)'; ctx.lineWidth = 1; ctx.stroke();

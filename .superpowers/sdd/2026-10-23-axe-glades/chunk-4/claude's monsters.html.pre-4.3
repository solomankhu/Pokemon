'use strict';
/* ============================================================
   MONSTER TRAIL — a single-file creature-collector RPG.

   No image or audio assets: every sprite is drawn from canvas
   primitives and every sound is synthesized with WebAudio.

   Four layers, top to bottom:
     1. DATA     — types, moves, species, map. Pure tables.
     2. ENGINE   — stats, damage, catching, XP. Pure functions.
     3. STATE    — mode machine: title/overworld/battle/menu/...
     4. SHELL    — rendering, input, main loop.

   Layers 1 and 2 have no DOM dependency, so they can be loaded
   and exercised headlessly (see __GAME__ export at the bottom).
   ============================================================ */


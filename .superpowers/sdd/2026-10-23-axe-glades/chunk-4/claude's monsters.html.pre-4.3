<title>MONSTER TRAIL</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' shape-rendering='crispEdges'><rect width='16' height='16' rx='3' fill='%230b0d10'/><circle cx='8' cy='8' r='6.5' fill='%23f4f4f4' stroke='%23000' stroke-width='1'/><path d='M1.5 8a6.5 6.5 0 0 1 13 0z' fill='%23e8443a' stroke='%23000' stroke-width='1'/><rect x='1.5' y='7.3' width='13' height='1.4' fill='%23000'/><circle cx='8' cy='8' r='2' fill='%23f4f4f4' stroke='%23000' stroke-width='1'/></svg>">
<style>
  html, body {
    margin: 0;
    height: 100%;
    background: #000;
    overscroll-behavior: none;       /* no pull-to-refresh or rubber-band */
    touch-action: none;              /* no pinch zoom or page pan */
    scrollbar-width: none;
    color: #cfe3ff;
    font-family: 'Courier New', Courier, monospace;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }
  html::-webkit-scrollbar, body::-webkit-scrollbar { display: none; }
  img, canvas { -webkit-user-drag: none; user-drag: none; }
  /* Fullscreen (body.fs): just the canvas on black. The idle cursor hides (body.nocursor). */
  body.fs canvas { border: none; box-shadow: none; max-width: none; max-height: none; }
  body.fs:not(.touch) #hint { display: none; }
  body.fs:not(.touch) #wrap { gap: 0; }
  body.nocursor, body.nocursor * { cursor: none !important; }
  #wrap {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  canvas {
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    background: #000;
    border: 2px solid #2a3340;
    box-shadow: 0 0 40px rgba(60, 120, 200, 0.18);
    box-sizing: content-box;
    flex: none;
    /* Fallback only: fitCanvas() sets an explicit CSS width/height. */
    max-width: 98vw;
    max-height: 88vh;
  }
  #hint {
    font-size: 12px;
    color: #5d6b7d;
    letter-spacing: 1px;
    text-align: center;
    padding: 0 12px;
  }
  #hint .touch { display: none; }

  /* --- touch layout: active once body.touch is set (coarse pointer or first touch).
     fitCanvas() sizes the canvas to the space the controls leave free, so the
     controls never sit over the canvas (and so never over the battle menu or
     the dialogue box). */
  body.touch #wrap { touch-action: none; }
  body.touch canvas { max-width: none; max-height: none; }
  body.touch #hint .keys { display: none; }
  body.touch #hint .touch { display: inline; }
  body.touch.portrait #wrap {
    justify-content: flex-start;
    padding-top: calc(env(safe-area-inset-top, 0px) + 6px);
    box-sizing: border-box;
  }
  body.touch.landscape #hint { display: none; }

  #touch { display: none; }
  body.touch #touch { display: block; }
  #touch .pad, #touch .btn {
    position: fixed;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
    z-index: 10;
    opacity: 0.6;
  }
  /* D-pad: one 3x3 element, so a finger can slide between arms. */
  #dpad {
    left: calc(env(safe-area-inset-left, 0px) + var(--edge, 16px));
    bottom: calc(env(safe-area-inset-bottom, 0px) + var(--edge, 16px));
    width: calc(var(--cell, 56px) * 3);
    height: calc(var(--cell, 56px) * 3);
    display: grid;
    grid-template: repeat(3, 1fr) / repeat(3, 1fr);
  }
  #dpad .arm {
    background: rgba(207, 227, 255, 0.45);
    border: 2px solid rgba(207, 227, 255, 0.7);
    display: flex; align-items: center; justify-content: center;
    color: #0b0d10; font: bold 18px 'Courier New', monospace;
    pointer-events: none;
  }
  #dpad .up    { grid-area: 1 / 2; border-radius: 10px 10px 0 0; border-bottom: none; }
  #dpad .left  { grid-area: 2 / 1; border-radius: 10px 0 0 10px; border-right: none; }
  #dpad .mid   { grid-area: 2 / 2; border: none; }
  #dpad .right { grid-area: 2 / 3; border-radius: 0 10px 10px 0; border-left: none; }
  #dpad .down  { grid-area: 3 / 2; border-radius: 0 0 10px 10px; border-top: none; }
  #dpad .arm.on, #touch .btn.on { background: rgba(207, 227, 255, 0.95); }
  #touch .btn.on, #dpad.on { opacity: 0.9; }
  #touch .btn {
    width: var(--btn, 64px); height: var(--btn, 64px);
    border-radius: 50%;
    background: rgba(207, 227, 255, 0.45);
    border: 2px solid rgba(207, 227, 255, 0.7);
    color: #0b0d10;
    font: bold 22px 'Courier New', monospace;
    display: flex; align-items: center; justify-content: center;
    box-sizing: border-box;
  }
  #btnA {
    right: calc(env(safe-area-inset-right, 0px) + var(--edge, 16px));
    bottom: calc(env(safe-area-inset-bottom, 0px) + var(--edge, 16px) + var(--btn, 64px) * 0.6);
  }
  #btnB {
    right: calc(env(safe-area-inset-right, 0px) + var(--edge, 16px) + var(--btn, 64px) + 10px);
    bottom: calc(env(safe-area-inset-bottom, 0px) + var(--edge, 16px));
  }
  #touch #btnRun {
    right: calc(env(safe-area-inset-right, 0px) + var(--edge, 16px));
    bottom: calc(env(safe-area-inset-bottom, 0px) + var(--edge, 16px) + var(--btn, 64px) * 1.6 + 14px);
    width: 76px; height: 48px;
    border-radius: 12px;
    font-size: 15px;
  }
  #touch #btnRun.latched { background: rgba(255, 214, 102, 0.9); border-color: #ffd666; opacity: 0.9; }
  #safe-probe {
    position: fixed; left: 0; top: 0; visibility: hidden; pointer-events: none;
    padding: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px)
             env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px);
  }
</style>

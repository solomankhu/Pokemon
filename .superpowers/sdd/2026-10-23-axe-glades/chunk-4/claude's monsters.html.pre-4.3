/* --- update ------------------------------------------------------------- */
function updateOverworld(dt) {
  const p = G.player;
  if (G.fadeDir !== 0) return;

  if (p.moving) {
    const speed = (keys['shift'] ? 7.2 : 4.6);
    p.t += dt * speed;
    if (p.t >= 1) {
      p.t = 1; p.moving = false; p.hop = 0;
      p.px = p.tx * TILE; p.py = p.ty * TILE;
      G.steps++;
      if (G.steps % 2 === 0) sfx('step');
      // Step order: cave rules -> trainer sight -> stalker -> grass.
      caveStep();
      checkTrainerSight();
      if (!stalkerTurn() && G.mode === 'overworld' && G.fadeDir === 0) tryEncounter();
    } else {
      p.px = p.from.x * TILE + (p.tx - p.from.x) * TILE * p.t;
      p.py = p.from.y * TILE + (p.ty - p.from.y) * TILE * p.t;
    }
    return;
  }

  // TAPS: a press released before this frame still counts as a one-frame hold.
  let dx = 0, dy = 0, dir = null;
  if (keys['arrowup'] || keys['w'] || TAPS.up) { dy = -1; dir = 'up'; }
  else if (keys['arrowdown'] || keys['s'] || TAPS.down) { dy = 1; dir = 'down'; }
  else if (keys['arrowleft'] || keys['a'] || TAPS.left) { dx = -1; dir = 'left'; }
  else if (keys['arrowright'] || keys['d'] || TAPS.right) { dx = 1; dir = 'right'; }
  if (!dir) return;

  p.dir = dir;
  const nx = p.tx + dx, ny = p.ty + dy;

  // Soft gate: you need a partner before leaving town.
  if (!G.flags.starter && ny < REGIONS[REGIONS.length - 1][0]) {
    G.toast = { s: 'You need a partner first. See PROF. CEDAR.', t: 2.5 };
    return;
  }
  if (blockedFor(nx, ny, dir)) return;
  if (bump(G.stalker, [nx, ny]) && partyAlive()) { beginHunt(); return; }   // walked into it: a deliberate fight

  p.from = { x: p.tx, y: p.ty };
  if (tileHere(nx, ny) === 'v') {
    // Vault the ledge: clear it and land on the tile beyond.
    if (blockedFor(nx, ny + 1, 'down')) return;
    p.tx = nx; p.ty = ny + 1; p.hop = 1;
    sfx('hop');
  } else {
    p.tx = nx; p.ty = ny; p.hop = 0;
  }
  p.t = 0; p.moving = true;
}

// A few townsfolk drift around their post, so towns are not static.
function updateWander(dt) {
  G.wanderT -= dt;
  if (G.wanderT > 0) return;
  G.wanderT = 0.7;
  const p = G.player;
  for (const n of NPCS) {
    if (!n.wander || Math.random() < 0.55) continue;
    const opts = [[0, -1, 'up'], [0, 1, 'down'], [-1, 0, 'left'], [1, 0, 'right']];
    const [dx, dy, name] = opts[Math.floor(Math.random() * opts.length)];
    const nx = n.x + dx, ny = n.y + dy;
    if (!n.home) n.home = { x: n.x, y: n.y };
    if (Math.abs(nx - n.home.x) > n.wander || Math.abs(ny - n.home.y) > n.wander) {
      n.dir = name; continue;
    }
    const t = tileHere(nx, ny);
    if (SOLID.has(t) || t === 'v') { n.dir = name; continue; }
    if ((nx === p.tx && ny === p.ty) ||
        NPCS.some(o => o !== n && o.x === nx && o.y === ny)) { n.dir = name; continue; }
    n.x = nx; n.y = ny; n.dir = name;
  }
}

function updateBattle(dt) {
  const b = G.battle;
  if (!b) return;
  if (!battleFocused || combatModal) return;
  if (battleHost && !battleHost.isReady()) return;
  lastBattleFrameAt=typeof performance!=='undefined'?performance.now():0;
  if (b.actionFeedback) { b.actionFeedback.age+=dt; if(b.actionFeedback.age>1.5)b.actionFeedback=null; }
  updateJuice(b, dt);
  if (b.ballAnim) b.ballAnim.t += dt * 0.9;
  if (b.scare) b.scareT += dt;

  const rate = 60;
  if (b.dispMine !== b.mine.hp) {
    const d = Math.sign(b.mine.hp - b.dispMine) * rate * dt;
    b.dispMine = Math.abs(b.mine.hp - b.dispMine) <= Math.abs(d) ? b.mine.hp : b.dispMine + d;
  }
  if (b.dispFoe !== b.foe.hp) {
    const d = Math.sign(b.foe.hp - b.dispFoe) * rate * dt;
    b.dispFoe = Math.abs(b.foe.hp - b.dispFoe) <= Math.abs(d) ? b.foe.hp : b.dispFoe + d;
  }
  pumpQueue(b, dt);
}

function update(dt) {
  if (campaignBusy || combatModal) return;
  G.time += dt;
  if (G.toast) G.toast.t -= dt;

  if (G.fadeDir === 1) {
    G.fade += dt * 3.2;
    if (G.fade >= 1) {
      G.fade = 1; G.fadeDir = -1;
      const cb = G.fadeCb; G.fadeCb = null;
      if (cb) cb();
    }
  } else if (G.fadeDir === -1) {
    G.fade -= dt * 3.2;
    if (G.fade <= 0) { G.fade = 0; G.fadeDir = 0; }
  }

  if (G.mode === 'overworld') { updateOverworld(dt); updateWander(dt); }
  else if (G.mode === 'battle') {updateBattle(dt);bindWeather2D(G.battle,dt);}
  battleWeatherAudio(G.mode==='battle'&&G.battle?G.battle.condition:null);
  updateWorldFx(dt);
  updateCaveFx(dt);
  clearTaps();                  // a tap counts for exactly one frame
}

function render() {
  ctx.clearRect(0, 0, W, H);
  switch (G.mode) {
    case 'title': drawTitle(); break;
    case 'starter': drawStarter(); break;
    case 'victory': drawVictory(); break;
    case 'party': drawParty(false); break;
    case 'battle':
      if (CFX.lungeAge !== null && G.battle && G.battle.hunt) drawOverworld();   // the flare, then the cut
      else drawBattle();
      break;
    case 'menu': drawOverworld(); drawMenu(); break;
    case 'craft': drawOverworld(); drawCraft(); break;
    case 'bag': drawOverworld(); drawBag(); break;
    case 'shop': drawOverworld(); drawShop(); break;
    case 'dialogue': (G.prev === 'battle' ? drawBattle : drawOverworld)(); drawDialogue(); break;
    default: drawOverworld();
  }
  if (G.fade > 0) {
    ctx.fillStyle = 'rgba(0,0,0,' + G.fade + ')';
    ctx.fillRect(0, 0, W, H);
  }
}

/* --- the overworld BAG screen and the CENTRE shop ----------------------- */
function openBag() { G.bagCursor = 0; G.bagPick = null; G.bagMsg = ''; G.mode = 'bag'; G.menu = null; }
function bagSelected() {         // the [kind, id, count] row under the BAG cursor (clamping it)
  const rows = bagRows(G.balls, G.bag, G.materials), ent = bagEntries(rows);
  G.bagCursor = Math.max(0, Math.min(G.bagCursor, ent.length - 1));
  return rows[ent[G.bagCursor]];
}
function confirmBag() {
  if (G.bagPick) {
    const item = G.bagPick;
    if (!G.party.length || !((G.bag[item] || 0) > 0)) { G.bagPick = null; return; }
    const m = G.party[G.bagPickCursor % G.party.length], why = healRefusal(m);
    if (why) { sfx('cancel'); G.bagMsg = BAG_MSG[why]; return; }   // refused: nothing used, the picker stays open
    const n = Math.min(GOODS[item].heal, m.maxhp - m.hp);
    m.hp += n;
    G.bag = bagAdd(G.bag, item, -1);
    sfx('heal');
    G.bagMsg = fmtMsg(BAG_MSG.healed, m.name, n);
    G.bagPick = null;
    return;
  }
  const [kind, item] = bagSelected();
  if (kind === 'item' && isGood(item) && GOODS[item].kind === 'heal' && G.party.length) {
    sfx('select'); G.bagPick = item; G.bagPickCursor = 0; G.bagMsg = '';
  } else sfx('cancel');          // BALLs, SMOKE, materials, loot: read-only here
}
function openShop() { G.shop = { page: 'offer', cursor: 0, qty: 1, msg: '' }; G.mode = 'shop'; }   // the CENTRE heal's onDone
function closeShop() { G.shop = null; G.mode = 'overworld'; }
function shopCount() {
  const page = G.shop.page;
  if (page === 'offer') return SHOP_OFFER.length;
  if (page === 'main') return SHOP_MAIN.length;
  return shopRows(page, G.bag).length;
}
function moveShop(dx, dy) {
  const s = G.shop;
  if (!s) return;
  const n = shopCount();
  if (s.page === 'offer' || s.page === 'main') {
    if (dy) { s.cursor = (s.cursor + dy + n) % n; sfx('cursor'); }
    return;
  }
  if (dy && s.cursor + dy >= 0 && s.cursor + dy < n) { s.cursor += dy; s.qty = 1; s.msg = ''; sfx('cursor'); }
  else if (dx && n) {
    const row = shopRows(s.page, G.bag)[Math.min(s.cursor, n - 1)];
    const q = Math.max(1, Math.min(s.qty + dx, shopQtyCap(s.page, row)));
    if (q !== s.qty) { s.qty = q; s.msg = ''; sfx('cursor'); }
  }
}
function confirmShop() {
  const s = G.shop;
  if (!s) { G.mode = 'overworld'; return; }
  let page = s.page;
  if (page === 'offer') {
    if (s.cursor === 0) { sfx('select'); Object.assign(s, { page: 'main', cursor: 0, qty: 1, msg: '' }); }
    else { sfx('cancel'); closeShop(); }
    return;
  }
  if (page === 'main') {
    const pick = SHOP_MAIN[s.cursor];
    if (pick === 'BACK') { sfx('cancel'); closeShop(); return; }
    sfx('select');
    page = pick.toLowerCase();
    Object.assign(s, { page, cursor: 0, qty: 1, msg: shopRows(page, G.bag).length ? '' : SHOP_MSG.empty });
    return;
  }
  const rows = shopRows(page, G.bag);
  if (!rows.length) { sfx('cancel'); s.msg = SHOP_MSG.empty; return; }
  s.cursor = Math.max(0, Math.min(s.cursor, rows.length - 1));
  const row = rows[s.cursor], qty = Math.max(1, Math.min(s.qty, shopQtyCap(page, row)));
  let ok;
  if (page === 'buy') {
    const [coins, balls, bag, done, why] = shopBuy(G.coins, G.balls, G.bag, row[0], qty);
    ok = done;
    if (ok) { G.coins = coins; G.balls = balls; G.bag = bag; s.msg = fmtMsg(SHOP_MSG.bought, qty, row[1], row[2] * qty); }
    else s.msg = SHOP_MSG[why === 'coins' ? 'coins' : 'full'];
  } else {
    const [coins, bag, done, why] = shopSell(G.coins, G.bag, row[0], qty);
    ok = done;
    if (ok) {
      G.coins = coins; G.bag = bag;
      s.msg = fmtMsg(SHOP_MSG.sold, qty, row[1], row[2] * qty);
      const left = shopRows('sell', G.bag);
      s.cursor = Math.max(0, Math.min(s.cursor, left.length - 1));
      s.qty = 1;
      if (!left.length) s.msg += ' ' + SHOP_MSG.empty;
    } else s.msg = SHOP_MSG[why === 'full' ? 'purse' : 'empty'];
  }
  sfx(ok ? 'select' : 'cancel');
}

/* --- input -------------------------------------------------------------- */
function confirmKey() {
  audio();  // resume/unlock on first gesture

  if (G.fadeDir !== 0) return;

  if (G.mode === 'title') {
    const opts = hasSave() ? 2 : 1;
    sfx('select');
    if (G.newGameConfirm) {
      G.newGameConfirm = false;
      if (G.starterCursor === 0) return;
    } else if (G.starterCursor === 1 && opts === 2) {
      if (loadGame()) { G.mode = 'overworld'; G.toast = { s: 'Save loaded.', t: 2 }; if (campaignHost) campaignHost.resumeIfNeeded(); }
      else G.toast = { s: 'Could not load save. Your save has been kept.', t: 4 };
      return;
    } else if (opts === 2) {
      G.newGameConfirm = true; G.starterCursor = 0; return;
    }
    G.starterCursor = 0;
    G.party = []; G.balls = 20; G.flags = { starter: false, gym: false, huntBeaten: 0, gymBonus: false, axe: 0 };
    G.bag = {}; G.coins = START_COINS; G.battles = 0;
    G.chapter = Campaign ? Campaign.normalizeChapter(null, false) : null;
    G.beaten = {}; G.steps = 0; G.picked = new Set();
    G.edits = {}; G.materials = zeroMaterials(); G.building = false;
    loadCave(null);
    G.lastCentre = START_TILE.slice();
    G.player.tx = START_TILE[0]; G.player.ty = START_TILE[1];
    G.player.px = START_TILE[0] * TILE; G.player.py = START_TILE[1] * TILE;
    G.player.dir = 'up'; G.player.moving = false;
    G.mode = 'overworld';
    say(['CEDAR TOWN. The trail north has been closed for a season.',
         'PROF. CEDAR is waiting by the lab on the east side of town.']);
    saveGame();
    return;
  }

  if (G.mode === 'dialogue') { advanceDialogue(); return; }

  if (G.mode === 'starter') { sfx('select'); chooseStarter(G.starterCursor); return; }

  if (G.mode === 'victory') { sfx('select'); G.mode = 'overworld'; if (campaignHost) campaignHost.showChapterMenu(); return; }

  if (G.mode === 'party') { sfx('cancel'); G.mode = 'overworld'; G.menu = null; return; }

  if (G.mode === 'menu') {
    sfx('select');
    const c = G.menu.cursor;
    if (menuRows()[c]==='SETTINGS') { G.mode='overworld';G.menu=null;openCombatSettings();return; }
    if (c === 0) { G.menu = { cursor: 0 }; G.mode = 'party'; }
    else if (c === 1) {
      const ok = saveGame();
      G.mode = 'overworld'; G.menu = null;
      G.toast = { s: ok ? 'Game saved.' : 'Could not save (storage blocked).', t: 2.5 };
    } else if (c === 2) {
      openBag();
    } else if (c === 3) {
      G.craftCursor = 0; G.craftMsg = ''; G.mode = 'craft'; G.menu = null;
    } else if (c === 4) {
      if (G.pulses > 0) { G.mode = 'overworld'; G.menu = null; }
      firePulse(false);
    } else if (c === 5 && G.flags.gym && campaignHost) {
      G.mode = 'overworld'; G.menu = null; campaignHost.showChapterMenu();
    } else { G.mode = 'overworld'; G.menu = null; }
    return;
  }

  if (G.mode === 'bag') { confirmBag(); return; }
  if (G.mode === 'shop') { confirmShop(); return; }

  if (G.mode === 'craft') {
    const c = G.craftCursor;
    if (c < RECIPES.length) craftRecipe(c);
    else if (c === RECIPES.length) {
      sfx('select');
      G.building = true;
      G.mode = 'overworld';
      G.toast = { s: 'BUILDING: face bare ground and confirm.', t: 3 };
    } else { sfx('cancel'); G.mode = 'overworld'; }
    return;
  }

  if (G.mode === 'overworld') { interact(); return; }

  if (G.mode === 'battle') {
    const b = G.battle;
    if (b.step && b.step.t === 'msg') { b.step = null; sfx('cursor'); return; }
    if(b.phase==='choice'){const action=b.pendingChoice;b.pendingChoice=null;sfx('select');takeTurn(b,action);return;}
    if (b.phase === 'menu') {
      sfx('select');
      if (b.cursor === 0) { b.phase = 'fight'; b.cursor = 0; }
      else if (b.cursor === 1) {
        if (!battleBagItems().length) { b.phase = 'anim'; qMsg(b, 'Your bag is empty!'); qDo(b, () => { b.phase = 'menu'; b.cursor = 0; }); }
        else { b.phase = 'bag'; b.cursor = 0; }
      } else if (b.cursor === 2) {
        if (G.party.filter(m => m.hp > 0 && m !== b.mine).length === 0) {
          b.phase = 'anim';
          qMsg(b, 'No one else can battle!');
          qDo(b, () => { b.phase = 'menu'; b.cursor = 0; });
        } else { b.phase = 'swap'; b.cursor = 0; b.forcedSwap = false; }
      } else if(b.cursor===4&&CombatCommands){b.pendingChoice={t:'defend'};b.phase='choice';}
      else takeTurn(b, { t: 'run' });
      return;
    }
    if (b.phase === 'fight') {
      sfx('select');
      const action={t:'attack',move:b.mine.moves[b.cursor]};
      if(CombatCommands){b.pendingChoice=action;b.phase='choice';}else takeTurn(b,action);
      return;
    }
    if (b.phase === 'bag') {
      const items = battleBagItems();
      if (!items.length) { b.phase = 'menu'; b.cursor = 0; return; }
      const item = items[Math.min(b.cursor, items.length - 1)];
      sfx('select');
      const kind = item === 'ball' ? 'ball' : GOODS[item].kind;
      takeTurn(b, { t: kind === 'ball' ? 'ball' : 'item', item });
      return;
    }
    if (b.phase === 'swap') {
      const m = G.party[b.cursor];
      if (!m || m.hp <= 0 || m === b.mine) { sfx('cancel'); return; }
      sfx('select');
      if (b.forcedSwap) {
        b.forcedSwap = false;
        b.mine = m; b.dispMine = m.hp; b.stagesMine = {};
        b.hiddenMine=true;
        b.phase = 'anim';
        qMsg(b, 'Go, ' + m.name + '!');
        eventAction(b,'sendout','mine');
        qDo(b, () => { b.phase = 'menu'; b.cursor = 0; });
      } else {
        takeTurn(b, { t: 'swap', index: b.cursor });
      }
      return;
    }
  }
}

function cancelKey() {
  if (G.fadeDir !== 0) return;
  if (G.mode === 'title' && G.newGameConfirm) {
    sfx('cancel'); G.newGameConfirm = false; G.starterCursor = 0; return;
  }
  if (G.mode === 'overworld' && G.building) {
    sfx('cancel'); G.building = false; G.toast = { s: 'Stopped building.', t: 2.5 }; return;
  }
  if (G.mode === 'overworld') {
    sfx('select'); G.menu = { cursor: 0 }; G.mode = 'menu'; return;
  }
  if (G.mode === 'craft') { sfx('cancel'); G.mode = 'overworld'; return; }
  if (G.mode === 'bag') {
    sfx('cancel');
    if (G.bagPick) { G.bagPick = null; G.bagMsg = ''; } else G.mode = 'overworld';   // the picker, then the BAG
    return;
  }
  if (G.mode === 'shop') {
    sfx('cancel');
    const s = G.shop;
    if (s && (s.page === 'buy' || s.page === 'sell')) Object.assign(s, { page: 'main', cursor: SHOP_MAIN.indexOf(s.page.toUpperCase()), qty: 1, msg: '' });
    else closeShop();
    return;
  }
  if (G.mode === 'menu') { sfx('cancel'); G.mode = 'overworld'; G.menu = null; return; }
  if (G.mode === 'party') { sfx('cancel'); G.mode = 'overworld'; G.menu = null; return; }
  if (G.mode === 'battle') {
    const b = G.battle;
    if(b.phase==='choice'){sfx('cancel');b.phase=b.pendingChoice?.t==='attack'?'fight':'menu';b.pendingChoice=null;return;}
    if (b.phase === 'fight' || b.phase === 'bag') { sfx('cancel'); b.phase = 'menu'; b.cursor = 0; return; }
    if (b.phase === 'swap' && !b.forcedSwap) { sfx('cancel'); b.phase = 'menu'; b.cursor = 0; return; }
  }
}

function moveCursor(dx, dy) {
  if (G.mode === 'title') {
    const n = G.newGameConfirm || hasSave() ? 2 : 1;
    if (dy) { G.starterCursor = (G.starterCursor + dy + n) % n; sfx('cursor'); }
    return;
  }
  if (G.mode === 'starter') {
    if (dx) { G.starterCursor = (G.starterCursor + dx + STARTERS.length) % STARTERS.length; sfx('cursor'); }
    return;
  }
  if (G.mode === 'menu') {
    const n = menuRows().length;
    if (dy) { G.menu.cursor = (G.menu.cursor + dy + n) % n; sfx('cursor'); }
    return;
  }
  if (G.mode === 'craft') {
    const n = RECIPES.length + 2;
    if (dy) { G.craftCursor = (G.craftCursor + dy + n) % n; sfx('cursor'); }
    return;
  }
  if (G.mode === 'bag') {
    if (G.bagPick) {
      if (dy && G.party.length) { G.bagPickCursor = (G.bagPickCursor + dy + G.party.length) % G.party.length; G.bagMsg = ''; sfx('cursor'); }
      return;
    }
    const n = bagEntries(bagRows(G.balls, G.bag, G.materials)).length, c = G.bagCursor + dy;   // one column, clamped (it scrolls)
    if (dy && c >= 0 && c < n) { G.bagCursor = c; G.bagMsg = ''; sfx('cursor'); }
    return;
  }
  if (G.mode === 'shop') { moveShop(dx, dy); return; }
  if (G.mode === 'party') {
    if (dy && G.party.length) {
      G.menu = G.menu || { cursor: 0 };
      G.menu.cursor = (G.menu.cursor + dy + G.party.length) % G.party.length;
      sfx('cursor');
    }
    return;
  }
  if (G.mode === 'battle') {
    const b = G.battle;
    if (b.step && b.step.t === 'msg') return;
    if (b.phase === 'bag') {                 // one column: rows only, clamped
      const c = b.cursor + dy;
      if (dy && c >= 0 && c < battleBagItems().length) { b.cursor = c; sfx('cursor'); }
      return;
    }
    if(b.phase==='menu'&&CombatCommands){
      const order=[0,4,1,2,3],i=order.indexOf(b.cursor),next=i+(dx||dy*3);
      if(next>=0&&next<order.length){b.cursor=order[next];sfx('cursor');}return;
    }
    let n = 0;
    if (b.phase === 'menu') n = 4;
    else if (b.phase === 'fight') n = b.mine.moves.length;
    else if (b.phase === 'swap') n = G.party.length;
    if (!n) return;
    const cols = 2;
    let c = b.cursor;
    if (dx) c += dx;
    if (dy) c += dy * cols;
    if (c < 0 || c >= n) return;
    b.cursor = c;
    sfx('cursor');
  }
}

/* --- input: ONE path ------------------------------------------------------
   press(k)/release(k) take a lower-cased key name. Keyboard, the touch
   controls (and any future gamepad/remap) all feed these with the canonical
   keys 'arrowup' 'arrowdown' 'arrowleft' 'arrowright' 'z' 'x' 'shift', so
   game logic never learns which device a press came from. */
let runLatched = false;         // touch RUN toggle holds 'shift' down

function press(k) {
  if (campaignBusy || combatModal) return;
  if (keys[k]) return;          // ignore auto-repeat for one-shot actions
  keys[k] = true;
  if (k === FULLSCREEN_KEY) { toggleFullscreen(); return; }
  if (k==='o' && G.mode==='battle') { openCombatSettings();return; }
  if (G.mode==='battle' && G.battle && G.battle.command && ['z','enter',' '].includes(k)) { commandInput(true,false);return; }
  if (G.mode === 'overworld') {
    if (k === 'arrowup' || k === 'w') TAPS.up = true;
    else if (k === 'arrowdown' || k === 's') TAPS.down = true;
    else if (k === 'arrowleft' || k === 'a') TAPS.left = true;
    else if (k === 'arrowright' || k === 'd') TAPS.right = true;
  }

  if (k === 'arrowup' || k === 'w') moveCursor(0, -1);
  else if (k === 'arrowdown' || k === 's') moveCursor(0, 1);
  else if (k === 'arrowleft' || k === 'a') moveCursor(-1, 0);
  else if (k === 'arrowright' || k === 'd') moveCursor(1, 0);
  else if (k === 'z' || k === 'enter' || k === ' ') {
    if (CFX.lungeAge !== null) CFX.pendingConfirm = true;   // replayed when the lunge flare ends
    else confirmKey();
  }
  else if (k === 'x' || k === 'escape' || k === 'backspace') cancelKey();
}

function release(k) {
  if (k === 'shift' && runLatched) return;   // the RUN latch outlives a Shift tap
  keys[k] = false;
  if (['z','enter',' '].includes(k)) commandInput(false,true);
}

function releaseAll() {
  webcamPauseGen++;
  for (const k in keys) keys[k] = false;
  setRunLatch(false);
  touchReset();
  if(G.battle && G.battle.command && CombatCommands) { G.battle.command=CombatCommands.stepCommand(G.battle.command,0,{paused:true});if(G.battle.command.waitingRelease){G.battle.command.waitingRelease=false;G.battle.command.ready=false;}G.battle.commandInput={}; }
}

function onKeyDown(e) {
  if (campaignBusy || combatModal) return;
  const k = e.key.toLowerCase();
  if (k === FULLSCREEN_KEY && (e.ctrlKey || e.metaKey || e.altKey)) return;   // Ctrl+F etc. is not the toggle
  if (['arrowup', 'arrowdown', 'arrowleft', 'arrowright', ' ', 'enter'].includes(k)) e.preventDefault();
  press(k);
}

function onKeyUp(e) { release(e.key.toLowerCase()); }

/* --- touch controls (DOM overlay) ------------------------------------------ */
const TOUCH_CELL = 56;          // D-pad arm size, CSS px (portrait / roomy)
const TOUCH_CELL_MIN = 48;      // never smaller than a 48px target
const TOUCH_BTN = 64;           // A/B diameter, CSS px
const TOUCH_EDGE = 16;          // gap from the screen edge (plus safe-area inset)
const TOUCH_GAP = 12;           // gap between the canvas and a control cluster
const DPAD_DEADZONE = 0.28;     // fraction of the pad's half-size with no direction

let touchOn = false;
let dpadPointer = null, dpadKey = null;
const btnPointers = new Map();  // pointerId -> { el, key }
let touchEls = null;

function setRunLatch(on) {
  runLatched = on;
  if (on) press('shift'); else keys['shift'] = false;
  if (touchEls) touchEls.run.classList.toggle('latched', on);
}

function unlockAudio() {
  // Touch pointerdown is not a user-activation event, so an AudioContext made
  // there can start suspended. Resume it on the activating pointerup.
  const a = audio();
  if (a && a.state === 'suspended' && a.resume) a.resume().catch(() => {});
}

function dpadDir(e) {
  const r = touchEls.dpad.getBoundingClientRect();
  const dx = e.clientX - (r.left + r.width / 2), dy = e.clientY - (r.top + r.height / 2);
  const half = r.width / 2;
  if (Math.hypot(dx, dy) < half * DPAD_DEADZONE) return null;
  if (Math.abs(dx) > Math.abs(dy)) return dx < 0 ? 'arrowleft' : 'arrowright';
  return dy < 0 ? 'arrowup' : 'arrowdown';
}

function setDpad(k) {
  if (k === dpadKey) return;
  if (dpadKey) { release(dpadKey); touchEls.arms[dpadKey].classList.remove('on'); }
  dpadKey = k;
  if (k) { press(k); touchEls.arms[k].classList.add('on'); }
  touchEls.dpad.classList.toggle('on', !!k);
}

function touchReset() {
  if (!touchEls) return;
  if (dpadKey) setDpad(null);
  dpadPointer = null;
  for (const [, b] of btnPointers) { release(b.key); b.el.classList.remove('on'); }
  btnPointers.clear();
}

function enableTouch() {
  if (touchOn) return;
  touchOn = true;
  document.body.classList.add('touch');
  fitCanvas();
}

function initTouch() {
  const $ = id => document.getElementById(id);
  const dpad = $('dpad');
  touchEls = {
    dpad, run: $('btnRun'),
    arms: {
      arrowup: dpad.querySelector('.up'), arrowdown: dpad.querySelector('.down'),
      arrowleft: dpad.querySelector('.left'), arrowright: dpad.querySelector('.right')
    }
  };
  const root = $('touch');
  root.addEventListener('contextmenu', e => e.preventDefault());

  // D-pad: capture the finger, re-evaluate the direction as it slides.
  dpad.addEventListener('pointerdown', e => {
    e.preventDefault();
    if (dpadPointer !== null) return;
    dpadPointer = e.pointerId;
    try { dpad.setPointerCapture(e.pointerId); } catch (err) { /* synthetic events */ }
    setDpad(dpadDir(e));
  });
  dpad.addEventListener('pointermove', e => {
    if (e.pointerId !== dpadPointer) return;
    e.preventDefault();
    setDpad(dpadDir(e));
  });
  const dpadEnd = e => {
    if (e.pointerId !== dpadPointer) return;
    dpadPointer = null;
    setDpad(null);
    unlockAudio();
  };
  for (const ev of ['pointerup', 'pointercancel', 'lostpointercapture']) dpad.addEventListener(ev, dpadEnd);

  // A / B: press while held.
  for (const el of [$('btnA'), $('btnB')]) {
    const key = el.dataset.key;
    el.addEventListener('pointerdown', e => {
      e.preventDefault();
      try { el.setPointerCapture(e.pointerId); } catch (err) { /* synthetic events */ }
      btnPointers.set(e.pointerId, { el, key });
      el.classList.add('on');
      press(key);
    });
    const end = e => {
      const b = btnPointers.get(e.pointerId);
      if (!b || b.el !== el) return;
      btnPointers.delete(e.pointerId);
      el.classList.remove('on');
      release(key);
      unlockAudio();
    };
    for (const ev of ['pointerup', 'pointercancel', 'lostpointercapture']) el.addEventListener(ev, end);
  }

  // RUN: a toggle that latches 'shift'.
  touchEls.run.addEventListener('pointerdown', e => {
    e.preventDefault();
    setRunLatch(!runLatched);
  });
  touchEls.run.addEventListener('pointerup', unlockAudio);

  // Show the controls on a coarse pointer, or the first time a finger lands.
  if (typeof matchMedia === 'function' && matchMedia('(pointer: coarse)').matches) enableTouch();
  window.addEventListener('pointerdown', e => { if (e.pointerType === 'touch') enableTouch(); }, true);
  window.addEventListener('touchstart', enableTouch, { capture: true, passive: true });
}

/* --- responsive canvas: internal 640x480, CSS size fits the free space ---- */
function safeInsets() {
  const cs = getComputedStyle(document.getElementById('safe-probe'));
  return {
    t: parseFloat(cs.paddingTop) || 0, r: parseFloat(cs.paddingRight) || 0,
    b: parseFloat(cs.paddingBottom) || 0, l: parseFloat(cs.paddingLeft) || 0
  };
}

function fitScale(availW, availH) {
  let s = Math.min(availW / W, availH / H);
  if (s >= 2) s = Math.floor(s);   // crisp integer scaling once there's room
  return Math.max(s, 0.1);
}

function fitCanvas() {
  const vw = window.innerWidth, vh = window.innerHeight;
  const ins = safeInsets();
  const body = document.body;
  const fs = body.classList.contains('fs');
  const BORDER = fs ? 0 : 4;        // canvas border, both sides (none in fullscreen)
  let s;
  if (!touchOn && fs) {
    // Fullscreen: the whole screen, letterboxed on black, no hint line.
    s = fitScale(vw, vh);
    body.classList.remove('portrait', 'landscape');
  } else if (!touchOn) {
    // Desktop: the old max-width 98vw / max-height 88vh envelope (88vh leaves the hint room).
    s = fitScale(vw * 0.98 - BORDER, vh * 0.88 - BORDER);
    body.classList.remove('portrait', 'landscape');
  } else {
    // Portrait: canvas on top, controls in a band below.
    const cellP = TOUCH_CELL;
    const bandP = TOUCH_EDGE + Math.max(cellP * 3, TOUCH_BTN * 1.6 + 14 + 48) + TOUCH_GAP + 26; // +hint line
    const sP = fitScale(vw - ins.l - ins.r - 8 - BORDER, vh - ins.t - ins.b - 6 - bandP - BORDER);
    // Landscape: controls in side gutters wide enough for the D-pad / A+B cluster.
    const cellL = vh < 520 ? TOUCH_CELL_MIN : TOUCH_CELL;
    const gutter = TOUCH_EDGE + Math.max(cellL * 3, TOUCH_BTN * 2 + 10) + TOUCH_GAP;
    const sL = fitScale(vw - 2 * gutter - ins.l - ins.r - BORDER, vh - ins.t - ins.b - 8 - BORDER);
    const portrait = sP >= sL;
    s = portrait ? sP : sL;
    body.classList.toggle('portrait', portrait);
    body.classList.toggle('landscape', !portrait);
    const cell = portrait ? cellP : cellL;
    body.style.setProperty('--cell', cell + 'px');
    body.style.setProperty('--btn', TOUCH_BTN + 'px');
    body.style.setProperty('--edge', TOUCH_EDGE + 'px');
  }
  canvas.style.width = Math.floor(W * s) + 'px';
  canvas.style.height = Math.floor(H * s) + 'px';
}

/* --- game window: behave like a game, not a page (shell only) -------------
   Everything here is DOM plumbing installed by boot(); none of it is reached
   headlessly unless a test hands installHardening() a fake window/document.
   Keys go to preventDefault only - press()/release() still see every one, so
   Backspace keeps working as cancel. F11 / F12 are never touched. */
const FULLSCREEN_KEY = 'f';          // unused by press(); THE STATIC BELOW also uses F, but its frame owns its keys
const CURSOR_IDLE_MS = 2000;         // fullscreen: hide the mouse cursor after this long without movement
const FULLSCREEN_HINT = 'Press F11 to leave fullscreen.';
// The launcher asks for --start-fullscreen, but Chrome/Edge ignore that flag when
// the browser is already running. In an app window (no location bar) the first
// key or click then enters fullscreen instead - once per load, never in a tab.
const FULLSCREEN_AUTO_APP = true;
const BLOCKED_KEYS = ['f5', 'f3', 'backspace', 'browserback', 'browserforward', 'browserrefresh'];
const BLOCKED_CTRL_KEYS = ['r', 'p', 's', 'f', 'g', 'o', 'u', 'h', 'j', '+', '=', '-', '_', '0'];

// Pure: should the browser's default action for this keydown be suppressed?
// Text fields (none exist today, but the battle settings modal is DOM) keep
// their own editing keys.
function browserKeyBlocked(e) {
  if (!e || typeof e.key !== 'string') return false;
  const k = e.key.toLowerCase();
  if (k === 'f11' || k === 'f12') return false;
  const t = e.target, tag = t && t.tagName ? String(t.tagName).toLowerCase() : '';
  const editable = tag === 'textarea' || (tag === 'input' && !/^(button|checkbox|radio|range|submit|reset)$/i.test(t.type || 'text')) || !!(t && t.isContentEditable);
  if (editable && !e.ctrlKey && !e.metaKey) return false;
  if ((e.ctrlKey || e.metaKey) && BLOCKED_CTRL_KEYS.includes(k)) return true;
  if (e.altKey && (k === 'arrowleft' || k === 'arrowright')) return true;    // history back / forward
  return BLOCKED_KEYS.includes(k);
}

let hardenDoc = null, hardenWin = null, cursorTimer = null, autoFsDone = false;

function isAppWindow(w) {
  return !!(w && w.locationbar && w.locationbar.visible === false);
}

function autoFullscreen() {
  if (autoFsDone) return;
  autoFsDone = true;
  if (FULLSCREEN_AUTO_APP && isAppWindow(hardenWin) && !isFullscreen()) toggleFullscreen();
}

// True for element fullscreen (the F toggle) and for browser fullscreen
// (F11 or the launcher's --start-fullscreen), which the Fullscreen API can't see.
function isFullscreen() {
  const d = hardenDoc, w = hardenWin;
  if (!d || !w) return false;
  if (d.fullscreenElement || d.webkitFullscreenElement) return true;
  if (w.matchMedia && w.matchMedia('(display-mode: fullscreen)').matches) return true;
  const s = w.screen;
  return !!(s && s.width && w.innerWidth >= s.width && w.innerHeight >= s.height);
}

function lockEscape(on) {
  // In element fullscreen the browser eats Escape to exit, and Escape is our
  // cancel key. Keyboard Lock (Chrome/Edge) passes it through; hold Esc to leave.
  const kb = hardenWin && hardenWin.navigator && hardenWin.navigator.keyboard;
  if (!kb) return;
  try { if (on && kb.lock) { const p = kb.lock(['Escape']); if (p && p.catch) p.catch(() => {}); } else if (!on && kb.unlock) kb.unlock(); } catch (err) { /* unsupported */ }
}

function toggleFullscreen() {
  const d = hardenDoc;
  if (!d) return false;
  const el = d.documentElement;
  try {
    if (d.fullscreenElement || d.webkitFullscreenElement) {
      lockEscape(false);
      const p = (d.exitFullscreen || d.webkitExitFullscreen).call(d);
      if (p && p.catch) p.catch(() => {});
      return true;
    }
    if (isFullscreen()) {                 // browser fullscreen: only the browser can leave it
      G.toast = { s: FULLSCREEN_HINT, t: 3 };
      return false;
    }
    const req = el && (el.requestFullscreen || el.webkitRequestFullscreen);
    if (!req) return false;
    const p = req.call(el, { navigationUI: 'hide' });
    if (p && p.then) p.then(() => lockEscape(true), () => {});
    return true;
  } catch (err) { return false; }
}

function syncFullscreenUi() {
  const d = hardenDoc;
  if (!d || !d.body) return;
  const fs = isFullscreen();
  d.body.classList.toggle('fs', fs);
  if (!fs) showCursor();
  else armCursorHide();
  if (typeof fitCanvas === 'function' && canvas) fitCanvas();
}

function showCursor() {
  if (hardenDoc && hardenDoc.body) hardenDoc.body.classList.remove('nocursor');
}

function armCursorHide() {
  if (!hardenWin) return;
  if (cursorTimer !== null) hardenWin.clearTimeout(cursorTimer);
  cursorTimer = hardenWin.setTimeout(() => {
    cursorTimer = null;
    if (isFullscreen() && hardenDoc && hardenDoc.body) hardenDoc.body.classList.add('nocursor');
  }, CURSOR_IDLE_MS);
}

// Installs every page-hardening listener on the given window/document. Each
// API is feature-tested, so a missing one (or a test fake) is simply skipped.
function installHardening(w, d) {
  if (!w || !d || typeof w.addEventListener !== 'function' || typeof d.addEventListener !== 'function') return false;
  hardenWin = w; hardenDoc = d; autoFsDone = false;   // once per installed page
  const stop = e => { if (e && e.preventDefault) e.preventDefault(); };
  const notField = e => {
    const t = e && e.target, tag = t && t.tagName ? String(t.tagName).toLowerCase() : '';
    return tag !== 'input' && tag !== 'textarea' && tag !== 'select';
  };
  // Capture phase, so it runs before onKeyDown and before any modal stops propagation.
  w.addEventListener('keydown', e => {
    if (browserKeyBlocked(e)) stop(e);
    const k = e && typeof e.key === 'string' ? e.key.toLowerCase() : '';
    if (k !== FULLSCREEN_KEY && k !== 'f11' && k !== 'escape') autoFullscreen();
  }, true);
  w.addEventListener('pointerdown', autoFullscreen, true);
  d.addEventListener('contextmenu', stop);
  d.addEventListener('selectstart', e => { if (notField(e)) stop(e); });
  d.addEventListener('dragstart', stop);
  w.addEventListener('wheel', e => { if (e.ctrlKey) stop(e); }, { passive: false });           // Ctrl+wheel and trackpad pinch
  w.addEventListener('touchmove', e => { if (e.touches && e.touches.length > 1) stop(e); }, { passive: false });  // pinch
  for (const ev of ['gesturestart', 'gesturechange', 'gestureend']) d.addEventListener(ev, stop);  // iOS Safari pinch
  d.addEventListener('fullscreenchange', syncFullscreenUi);
  d.addEventListener('webkitfullscreenchange', syncFullscreenUi);
  w.addEventListener('resize', syncFullscreenUi);
  w.addEventListener('mousemove', () => { showCursor(); if (isFullscreen()) armCursorHide(); });
  w.addEventListener('mousedown', () => { showCursor(); if (isFullscreen()) armCursorHide(); });
  syncFullscreenUi();
  return true;
}

/* --- boot --------------------------------------------------------------- */
function boot() {
  canvas = document.getElementById('c');
  ctx = canvas.getContext('2d');
  installHardening(window, document);
  window.addEventListener('keydown', onKeyDown);
  window.addEventListener('keyup', onKeyUp);
  window.addEventListener('blur', releaseAll);
  initTouch();
  if(globalThis.MonsterWebcam)webcam=globalThis.MonsterWebcam.createWebcamController(Object.assign(webcamOptions(),{onStatus:s=>{if(battleHost&&WEBCAM_MESSAGES[s])battleHost.notify(WEBCAM_MESSAGES[s]);}}));
  window.addEventListener('pagehide',e=>{if(!webcam)return;if(e&&e.persisted)webcam.sync(false);else webcam.dispose();});   // bfcache: stop, stay reusable
  if(globalThis.MonsterBattleHost)battleHost=globalThis.MonsterBattleHost.createHost({webcam,
    canvas,species:SPECIES,getSettings:()=>({...G.settings,reducedMotion:G.settings.reducedMotion||REDUCED_MOTION}),
    setSettings:value=>{G.settings=CombatCommands.normalizeSettings(value);},save:saveGame,
    onModal:on=>{combatModal=on;if(on)webcamPauseGen++;},onInputReset:releaseAll
  });
  window.addEventListener('blur',()=>{battleFocused=false;if(battleHost)battleHost.suspend();if(webcam)webcam.sync(false);});
  window.addEventListener('focus',()=>{battleFocused=!document.hidden;releaseAll();});
  document.addEventListener('visibilitychange',()=>{battleFocused=!document.hidden&&document.hasFocus();releaseAll();if(!battleFocused&&battleHost)battleHost.suspend();if(document.hidden&&webcam)webcam.sync(false);});
  if (Campaign) campaignHost = Campaign.createHost({
    getChapter: () => G.chapter, setChapter: value => { G.chapter = value; }, gymWon: () => G.flags.gym,
    save: saveGame, lead: firstAlive,
    resetInput: () => { releaseAll(); clearTaps(); G.player.moving = false; G.player.px = G.player.tx * TILE; G.player.py = G.player.ty * TILE; },
    suspend: on => { campaignBusy = on; if (actx && actx.state !== 'closed') { const p = on ? actx.suspend() : actx.resume(); if (p && p.catch) p.catch(() => {}); } },
    focus: () => { canvas.tabIndex = -1; canvas.focus({ preventScroll: true }); },
    onReturn: (completed, memoryOnly) => { G.mode = 'overworld'; G.menu = null; G.toast = { s: memoryOnly ? 'Back above. Not saved to disk.' : completed ? 'Signal silenced. Welcome back!' : 'Back above. Checkpoint saved.', t: 5 }; }
  });
  fitCanvas();
  window.addEventListener('resize', fitCanvas);
  window.addEventListener('orientationchange', () => setTimeout(fitCanvas, 60));

  let last = performance.now();
  function frame(now) {
    const dt = Math.min((now - last) / 1000, 0.05);
    last = now;
    if (!campaignBusy) { update(dt); render(); }
    if(battleHost){
      if(!campaignBusy&&G.mode==='battle'&&G.battle){
        if(battleFocused&&!combatModal)battleHost.sync(battleSnapshot(),dt);else battleHost.suspend();
        battlePresenter=battleHost.presenter;
      }else{if(battleHost.diagnostics.active)battleHost.leave();battlePresenter=null;}
    }
    if(webcam)webcam.sync(webcamActive());
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
}

if (typeof document !== 'undefined' && document.getElementById) boot();


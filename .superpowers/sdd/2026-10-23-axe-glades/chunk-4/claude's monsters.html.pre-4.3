  });

  if(!live3D&&foeKnown&&b.condition!=='clear'&&CONDITIONS[b.condition]){ctx.fillStyle='#243646';rr(30,108,66,16,3);ctx.fill();text(CONDITIONS[b.condition].name,63,120,11,'#fff','center');}

  // Message / command box.
  panel(16, H - 118, W - 32, 102);
  if(b.result==='lose'){
    ctx.fillStyle='rgba(45,7,25,.48)';ctx.fillRect(0,0,W,H-118);
    text('TEAM DEFEATED',W/2,185,30,'#ffc0cb','center');
    text('Returning to the Centre...',W/2,H-65,16,'#603044','center');
    return;
  }
  if (b.command) { drawActionCommand(b); return; }
  if (!battleFocused) { text('PAUSED - return to the game window',W/2,H-70,14,'#22303f','center');return; }

  if (b.step && b.step.t === 'msg') {
    wrapText(b.step.s, 36, H - 82, W - 76, 20, 15, '#22303f');
    if (Math.sin(G.time * 6) > 0) {
      ctx.fillStyle = '#22303f';
      ctx.beginPath();
      ctx.moveTo(W - 46, H - 38); ctx.lineTo(W - 34, H - 38); ctx.lineTo(W - 40, H - 30);
      ctx.closePath(); ctx.fill();
    }
    return;
  }

  if (b.phase === 'menu') {
    if(CombatCommands){
      const choices=[['ATTACK',0],['DEFEND',4],['BAG',1],['SWAP',2],['RUN',3]];
      const hints={0:'Choose a move, read its guide, then confirm.',4:'Skip your attack. Shield reduces the next hit.',1:'Throw a BALL or use an item from your bag.',2:'Switch to another creature.',3:'Try escaping this encounter.'};
      text(hints[b.cursor]||hints[0],36,H-93,12,'#52677c');
      choices.forEach(([label,id],i)=>{const x=42+(i%3)*195,y=H-63+Math.floor(i/3)*30;text((b.cursor===id?'> ':'  ')+label,x,y,15,b.cursor===id?'#1f7658':'#22303f');});return;
    }
    text('What will ' + b.mine.name + ' do?', 36, H - 78, 15, '#22303f');
    const opts = ['FIGHT', 'BAG', 'SWAP', 'RUN'];
    opts.forEach((o, i) => {
      const ox = W / 2 + 40 + (i % 2) * 110;
      const oy = H - 86 + Math.floor(i / 2) * 30;
      if (i === b.cursor) {
        ctx.fillStyle = '#22303f';

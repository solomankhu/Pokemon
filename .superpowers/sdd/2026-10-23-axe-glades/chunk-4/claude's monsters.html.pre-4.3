const SCENE_WEATHER = { rain: 'rain', sun: 'sun', fog: 'fog', tremor: 'dust', static: 'sparks', night: 'none' };
const SCENE_EXTRA = { meadow: 'leaves', pass: 'snow', ruins: 'motes', cave: 'motes', shore: 'none' };

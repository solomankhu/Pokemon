// The DARK CAVE's ambient drone: three sine partials (55 / 55.5 / 82.5 Hz, so
// it beats slowly) into one gain that follows tension. Built once, only after
// a gesture has made the AudioContext; vol 0 fades it out. Never schedules notes.
// Weather audio uses its own seeded noise, never the engine RNG. Stop/disconnect on exit.
let weatherAudio=null;
function battleWeatherAudio(condition){
 const id=['rain','static'].includes(condition)?condition:null,a=actx;
 if(weatherAudio&&(!id||weatherAudio.id!==id)){try{weatherAudio.source.stop();weatherAudio.source.disconnect();weatherAudio.filter.disconnect();weatherAudio.gain.disconnect();}catch(_){}weatherAudio=null;}
 if(!id||!a||weatherAudio)return;
 try{const buffer=a.createBuffer(1,a.sampleRate*2,a.sampleRate),data=buffer.getChannelData(0),rng=mulberry32(0xA11CE);
 for(let i=0;i<data.length;i++)data[i]=(rng()*2-1)*(id==='static'?(i%(a.sampleRate/8)<a.sampleRate/100?1:.03):1);
 const source=a.createBufferSource(),filter=a.createBiquadFilter(),gain=a.createGain();source.buffer=buffer;source.loop=true;filter.type=id==='rain'?'lowpass':'bandpass';filter.frequency.value=id==='rain'?900:1800;gain.gain.value=.08;
 source.connect(filter);filter.connect(gain);gain.connect(a.destination);source.start();weatherAudio={id,source,filter,gain};}catch(_){}
}

let drone = null;
function caveDrone(vol) {
  const a = actx;
  if (!a) return;
  try {
    if (!drone) {
      if (vol <= 0) return;
      const g = a.createGain();
      g.gain.value = 0;
      g.connect(a.destination);
      for (const [f, v] of [[55, 0.5], [55.5, 0.35], [82.5, 0.2]]) {
        const o = a.createOscillator(), og = a.createGain();
        o.type = 'sine'; o.frequency.value = f; og.gain.value = v;
        o.connect(og); og.connect(g); o.start();
      }
      drone = { g, vol: 0 };
    }
    if (Math.abs(drone.vol - vol) > 0.002) {
      drone.g.gain.setTargetAtTime(vol * 0.25, a.currentTime, 0.4);   // WebAudio gains run ~4x hotter than the PCM mix
      drone.vol = vol;
    }
  } catch (e) { /* audio is optional */ }
}
function sfx(n) { try { if (SFX[n]) SFX[n](); } catch (e) { /* audio is optional */ } }

/* --- drawing helpers ---------------------------------------------------- */
function rr(x, y, w, h, r) {
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.arcTo(x + w, y, x + w, y + h, r);
  ctx.arcTo(x + w, y + h, x, y + h, r);
  ctx.arcTo(x, y + h, x, y, r);
  ctx.arcTo(x, y, x + w, y, r);
  ctx.closePath();
}

function panel(x, y, w, h, fill, edge) {
  ctx.fillStyle = fill || '#f8f8f0';
  rr(x, y, w, h, 8); ctx.fill();
  ctx.strokeStyle = edge || '#2a3340';
  ctx.lineWidth = 3;
  rr(x, y, w, h, 8); ctx.stroke();
  ctx.strokeStyle = 'rgba(0,0,0,0.12)';
  ctx.lineWidth = 1;
  rr(x + 4, y + 4, w - 8, h - 8, 5); ctx.stroke();
}

/* In-canvas control prompts name the input the player is actually using:
   keyboard keys by default, the DOM touch buttons once touchOn is set
   (enableTouch - coarse pointer or first touch). Touch labels are never
   longer than the key labels, so every prompt still fits its box. */
const PROMPT_KEYS  = { confirm: 'Z', confirmFull: 'Z / ENTER', cancel: 'X', move: 'ARROWS', run: 'SHIFT' };
const PROMPT_TOUCH = { confirm: 'A', confirmFull: 'A',         cancel: 'B', move: 'D-PAD',  run: 'RUN' };
function promptLabel(action) {
  return (touchOn ? PROMPT_TOUCH : PROMPT_KEYS)[action];
}

function text(s, x, y, size, color, align) {
  ctx.font = 'bold ' + (size || 14) + 'px "Courier New", monospace';
  ctx.fillStyle = color || '#22303f';
  ctx.textAlign = align || 'left';
  ctx.textBaseline = 'alphabetic';
  ctx.fillText(s, x, y);
  ctx.textAlign = 'left';
}

// Deterministic per-tile noise so scenery doesn't shimmer between frames.
function hash(x, y) {
  let h = x * 374761393 + y * 668265263;
  h = (h ^ (h >> 13)) * 1274126177;
  return ((h ^ (h >> 16)) >>> 0) / 4294967296;
}

/* --- procedural creature sprites ---------------------------------------- */
// amt < 0 darkens by that many units; amt > 0 lightens by that fraction
// toward white.  Keeps a palette to two authored colours per species.
function shadeBy(hex, amt) {
  const n = parseInt(hex.slice(1), 16);
  const ch = [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  return 'rgb(' + ch.map(v => Math.round(amt < 0
    ? Math.max(0, v + amt)
    : v + (255 - v) * amt)).join(',') + ')';
}

function drawCreature(sp, cx, cy, s, flip, backView, t) {
  // Animation clock: the battle passes its own, which stops during hit-stop.
  const T = t === undefined ? G.time : t;
  const a = sp.art;
  const scale = a.big ? s * 1.15 : s;
  ctx.save();
  ctx.translate(cx, cy);
  if (flip) ctx.scale(-1, 1);

  // Ground shadow.
  ctx.fillStyle = 'rgba(0,0,0,0.22)';
  ctx.beginPath();
  ctx.ellipse(0, scale * 0.52, scale * 0.52, scale * 0.14, 0, 0, Math.PI * 2);
  ctx.fill();

  const eye = (ex, ey, r) => {
    if (backView) return;
    ctx.fillStyle = '#16181c';
    ctx.beginPath(); ctx.arc(ex, ey, r, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = '#fff';
    ctx.beginPath(); ctx.arc(ex + r * 0.3, ey - r * 0.35, r * 0.34, 0, Math.PI * 2); ctx.fill();
  };
  const blob = (x, y, rx, ry, col) => {
    ctx.fillStyle = col;
    ctx.beginPath(); ctx.ellipse(x, y, rx, ry, 0, 0, Math.PI * 2); ctx.fill();
  };
  const poly = (col, pts) => {
    ctx.fillStyle = col;
    ctx.beginPath();
    pts.forEach(([x, y], i) => i ? ctx.lineTo(x, y) : ctx.moveTo(x, y));
    ctx.closePath(); ctx.fill();
  };

  switch (a.kind) {
    case 'quad': {
      if (a.flame) {  // tail flame
        const f = 1 + Math.sin(T * 8) * 0.12;
        blob(scale * 0.46, -scale * 0.1, scale * 0.16 * f, scale * 0.26 * f, '#ff7a1a');
        blob(scale * 0.46, -scale * 0.12, scale * 0.09 * f, scale * 0.16 * f, '#ffd86a');
      }
      ctx.fillStyle = a.c1;
      ctx.beginPath(); ctx.ellipse(0, scale * 0.16, scale * 0.42, scale * 0.3, 0, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = a.c2;
      ctx.beginPath(); ctx.ellipse(0, scale * 0.26, scale * 0.28, scale * 0.16, 0, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = a.c1;
      for (const lx of [-0.26, -0.02, 0.24]) {
        ctx.fillRect(lx * scale, scale * 0.36, scale * 0.13, scale * 0.16);
      }
      if (a.mane) {
        ctx.fillStyle = '#ffb347';
        ctx.beginPath(); ctx.arc(-scale * 0.3, -scale * 0.16, scale * 0.32, 0, Math.PI * 2); ctx.fill();
      }
      blob(-scale * 0.32, -scale * 0.16, scale * 0.26, scale * 0.24, a.c1);
      ctx.fillStyle = a.c1;
      ctx.beginPath();
      ctx.moveTo(-scale * 0.46, -scale * 0.34);
      ctx.lineTo(-scale * 0.52, -scale * 0.58);
      ctx.lineTo(-scale * 0.3, -scale * 0.4);
      ctx.closePath(); ctx.fill();
      ctx.beginPath();
      ctx.moveTo(-scale * 0.2, -scale * 0.36);
      ctx.lineTo(-scale * 0.16, -scale * 0.6);
      ctx.lineTo(-scale * 0.05, -scale * 0.34);
      ctx.closePath(); ctx.fill();
      blob(-scale * 0.44, -scale * 0.08, scale * 0.1, scale * 0.07, a.c2);
      eye(-scale * 0.38, -scale * 0.2, scale * 0.055);
      break;
    }
    case 'serpent': {
      ctx.strokeStyle = a.c1;
      ctx.lineWidth = scale * 0.2;
      ctx.lineCap = 'round';
      ctx.beginPath();
      for (let i = 0; i <= 26; i++) {
        const t = i / 26;
        const x = (t - 0.5) * scale * 0.86;
        const y = scale * 0.3 + Math.sin(t * Math.PI * 2.4 + T * 2) * scale * 0.14;
        i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
      }
      ctx.stroke();
      if (a.fins) {
        ctx.fillStyle = a.c2;
        ctx.beginPath();
        ctx.moveTo(scale * 0.34, scale * 0.24);
        ctx.lineTo(scale * 0.5, scale * 0.02);
        ctx.lineTo(scale * 0.5, scale * 0.42);
        ctx.closePath(); ctx.fill();
      }
      blob(-scale * 0.3, -scale * 0.1, scale * 0.3, scale * 0.27, a.c1);
      blob(-scale * 0.3, -scale * 0.02, scale * 0.19, scale * 0.14, a.c2);
      ctx.fillStyle = a.c2;
      ctx.beginPath();
      ctx.moveTo(-scale * 0.42, -scale * 0.3);
      ctx.lineTo(-scale * 0.3, -scale * 0.6);
      ctx.lineTo(-scale * 0.16, -scale * 0.28);
      ctx.closePath(); ctx.fill();
      eye(-scale * 0.4, -scale * 0.14, scale * 0.055);
      break;
    }
    case 'plant': {
      ctx.fillStyle = '#3f7a34';
      for (const ang of [-0.9, -0.3, 0.3, 0.9]) {
        ctx.save();
        ctx.translate(0, -scale * 0.22);
        ctx.rotate(ang + Math.sin(T * 1.6 + ang) * 0.06);
        ctx.beginPath();
        ctx.ellipse(0, -scale * 0.3, scale * 0.1, scale * 0.28, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }
      blob(0, scale * 0.1, scale * 0.42, scale * 0.38, a.c1);
      blob(0, scale * 0.2, scale * 0.28, scale * 0.2, a.c2);
      if (a.thorns) {
        ctx.fillStyle = '#e8f0b0';
        for (const ang of [-1.2, -0.4, 0.4, 1.2]) {
          ctx.save();
          ctx.rotate(ang);
          ctx.beginPath();
          ctx.moveTo(-scale * 0.05, -scale * 0.34);
          ctx.lineTo(0, -scale * 0.52);
          ctx.lineTo(scale * 0.05, -scale * 0.34);
          ctx.closePath(); ctx.fill();
          ctx.restore();
        }
      }
      ctx.fillStyle = a.c1;
      for (const lx of [-0.24, 0.16]) ctx.fillRect(lx * scale, scale * 0.4, scale * 0.12, scale * 0.12);
      eye(-scale * 0.15, scale * 0.02, scale * 0.06);
      eye(scale * 0.15, scale * 0.02, scale * 0.06);
      break;
    }
    case 'rodent': {
      if(a.pickajoo){
        poly(a.c1,[[scale*.22,scale*.28],[scale*.52,scale*.1],[scale*.42,-scale*.05],[scale*.7,-scale*.25],[scale*.56,-scale*.36],[scale*.3,-scale*.13],[scale*.4,scale*.02]]);
        blob(0,scale*.18,scale*.3,scale*.36,a.c1);blob(0,scale*.27,scale*.21,scale*.22,a.c2);
        for(const side of [-1,1]){poly(a.c1,[[side*scale*.1,-scale*.14],[side*scale*.21,-scale*.73],[side*scale*.34,-scale*.16]]);poly('#26202a',[[side*scale*.18,-scale*.56],[side*scale*.21,-scale*.73],[side*scale*.25,-scale*.49]]);blob(side*scale*.18,scale*.47,scale*.15,scale*.08,a.c1);}
        blob(0,-scale*.05,scale*.34,scale*.28,a.c1);eye(-scale*.15,-scale*.08,scale*.055);eye(scale*.15,-scale*.08,scale*.055);
        if(!backView)for(const side of [-1,1])blob(side*scale*.23,scale*.05,scale*.075,scale*.06,'#ef4545');
        break;
      }
      ctx.fillStyle = a.c1;
      ctx.lineWidth = scale * 0.06;
      ctx.strokeStyle = a.c1;
      ctx.beginPath();
      ctx.moveTo(scale * 0.32, scale * 0.24);
      ctx.quadraticCurveTo(scale * 0.62, scale * 0.1, scale * 0.5, -scale * 0.24);
      ctx.stroke();
      blob(-scale * 0.24, -scale * 0.3, scale * 0.14, scale * 0.18, a.c1);
      blob(scale * 0.02, -scale * 0.32, scale * 0.14, scale * 0.18, a.c1);
      blob(-scale * 0.24, -scale * 0.3, scale * 0.07, scale * 0.1, a.c2);
      blob(scale * 0.02, -scale * 0.32, scale * 0.07, scale * 0.1, a.c2);
      blob(0, scale * 0.14, scale * 0.4, scale * 0.34, a.c1);
      blob(0, scale * 0.24, scale * 0.26, scale * 0.2, a.c2);
      if (a.tusks) {
        ctx.fillStyle = '#fff8e0';
        ctx.fillRect(-scale * 0.1, scale * 0.16, scale * 0.06, scale * 0.16);
        ctx.fillRect(scale * 0.04, scale * 0.16, scale * 0.06, scale * 0.16);
      }
      eye(-scale * 0.16, scale * 0.04, scale * 0.06);
      eye(scale * 0.14, scale * 0.04, scale * 0.06);
      ctx.fillStyle = '#e07a8a';
      ctx.beginPath(); ctx.arc(0, scale * 0.16, scale * 0.045, 0, Math.PI * 2); ctx.fill();
      break;
    }
    case 'bug': {
      const flap = Math.sin(T * 10) * 0.3;
      if (a.glow) {
        const pulse = 1 + Math.sin(T * 5) * 0.12;
        const gl = ctx.createRadialGradient(0, scale * 0.08, 0, 0, scale * 0.08,
                                            scale * 0.46 * pulse);
        gl.addColorStop(0, a.c2);
        gl.addColorStop(1, 'rgba(255,255,255,0)');
        ctx.globalAlpha = 0.5;
        ctx.fillStyle = gl;
        ctx.beginPath();
        ctx.arc(0, scale * 0.08, scale * 0.46 * pulse, 0, Math.PI * 2);
        ctx.fill();
        ctx.globalAlpha = 1;
      }
      ctx.fillStyle = 'rgba(255,255,255,0.55)';
      ctx.strokeStyle = a.c2;
      ctx.lineWidth = 2;
      for (const sgn of [-1, 1]) {
        ctx.save();
        ctx.rotate(sgn * (0.5 + flap * sgn));
        ctx.beginPath();
        ctx.ellipse(sgn * scale * 0.3, -scale * 0.18, scale * 0.3, scale * 0.18, 0, 0, Math.PI * 2);
        ctx.fill(); ctx.stroke();
        ctx.restore();
      }
      blob(0, scale * 0.08, scale * 0.2, scale * 0.32, a.c1);
      blob(0, -scale * 0.2, scale * 0.19, scale * 0.17, a.c1);
      ctx.strokeStyle = a.c1;
      ctx.lineWidth = scale * 0.035;
      for (const sgn of [-1, 1]) {
        ctx.beginPath();
        ctx.moveTo(sgn * scale * 0.08, -scale * 0.32);
        ctx.quadraticCurveTo(sgn * scale * 0.24, -scale * 0.56, sgn * scale * 0.1, -scale * 0.62);
        ctx.stroke();
      }
      eye(-scale * 0.09, -scale * 0.22, scale * 0.05);
      eye(scale * 0.09, -scale * 0.22, scale * 0.05);
      break;
    }
    case 'bat': {
      const beat = Math.sin(T * 8) * 0.55;
      const bdark = shadeBy(a.c1, -34);
      for (const sgn of [-1, 1]) {
        const span = 0.60 + 0.10 * Math.cos(beat);
        const lift = beat * 0.16 * sgn;
        poly(sgn < 0 ? bdark : a.c1, [
          [0, -scale * 0.06],
          [sgn * scale * span, -scale * (0.34 + lift)],
          [sgn * scale * (span - 0.06), -scale * (0.06 + lift)],
          [sgn * scale * (span - 0.16), -scale * (0.16 + lift)],
          [sgn * scale * (span - 0.24), scale * 0.04],
          [sgn * scale * (span - 0.34), -scale * 0.06],
          [sgn * scale * 0.14, scale * 0.16]]);
      }
      blob(0, scale * 0.04, scale * 0.20, scale * 0.26, a.c1);
      blob(0, scale * 0.12, scale * 0.12, scale * 0.14, a.c2);
      blob(0, -scale * 0.22, scale * 0.19, scale * 0.17, a.c1);
      for (const sgn of [-1, 1]) {
        poly(a.c1, [[sgn * scale * 0.04, -scale * 0.34],
                    [sgn * scale * 0.20, -scale * 0.66],
                    [sgn * scale * 0.21, -scale * 0.30]]);
        poly(a.c2, [[sgn * scale * 0.08, -scale * 0.36],
                    [sgn * scale * 0.17, -scale * 0.56],
                    [sgn * scale * 0.18, -scale * 0.34]]);
      }
      if (a.horns) {
        for (const sgn of [-1, 1]) {
          poly(a.c2, [[sgn * scale * 0.26, -scale * 0.30],
                      [sgn * scale * 0.40, -scale * 0.52],
                      [sgn * scale * 0.32, -scale * 0.24]]);
        }
      }
      if (!backView) {
        poly('#ffffff', [[-scale * 0.06, -scale * 0.12], [-scale * 0.02, -scale * 0.02],
                         [scale * 0.01, -scale * 0.12]]);
      }
      eye(-scale * 0.08, -scale * 0.24, scale * 0.05);
      eye(scale * 0.08, -scale * 0.24, scale * 0.05);
      break;
    }
    case 'gear': {
      const spin = T * 1.1;
      const gdark = shadeBy(a.c1, -40);
      const teeth = 10;
      const outer = [];
      for (let i = 0; i < teeth * 2; i++) {
        const ang = spin + i * Math.PI / teeth;
        const r = scale * (i % 2 === 0 ? 0.50 : 0.38);
        outer.push([Math.cos(ang) * r, Math.sin(ang) * r * 0.96 + scale * 0.04]);
      }
      poly(gdark, outer);
      blob(0, scale * 0.04, scale * 0.34, scale * 0.33, a.c1);
      blob(0, scale * 0.04, scale * 0.20, scale * 0.19, a.c2);
      if (a.spikes) {
        for (const ang of [-1.05, 0, 1.05]) {
          ctx.save(); ctx.rotate(ang);
          poly(a.c2, [[-scale * 0.06, -scale * 0.30], [0, -scale * 0.58],
                      [scale * 0.06, -scale * 0.30]]);
          ctx.restore();
        }
      }
      for (let i = 0; i < 4; i++) {
        const ang = spin * -0.7 + i * Math.PI / 2;
        blob(Math.cos(ang) * scale * 0.26, Math.sin(ang) * scale * 0.25 + scale * 0.04,
             scale * 0.035, scale * 0.035, gdark);
      }
      eye(-scale * 0.08, scale * 0.02, scale * 0.055);
      eye(scale * 0.08, scale * 0.02, scale * 0.055);
      break;
    }
    case 'crab': {
      const cdark = shadeBy(a.c1, -44);
      const snap = Math.abs(Math.sin(T * 4)) * 0.32;
      ctx.lineCap = 'round';
      for (const sgn of [-1, 1]) {
        ctx.strokeStyle = cdark;
        ctx.lineWidth = scale * 0.07;
        ctx.beginPath();
        ctx.moveTo(sgn * scale * 0.22, scale * 0.16);
        ctx.lineTo(sgn * scale * 0.42, scale * 0.02);
        ctx.stroke();
        ctx.save();
        ctx.translate(sgn * scale * 0.42, 0);
        ctx.rotate(sgn * -snap);
        poly(a.c1, [[0, 0], [sgn * scale * 0.22, -scale * 0.10],
                    [sgn * scale * 0.26, scale * 0.06], [sgn * scale * 0.08, scale * 0.10]]);
        poly(cdark, [[sgn * scale * 0.06, -scale * 0.02],
                     [sgn * scale * 0.24, -scale * 0.12], [sgn * scale * 0.22, 0]]);
        ctx.restore();
        ctx.strokeStyle = cdark;
        ctx.lineWidth = scale * 0.045;
        for (let i = 0; i < 3; i++) {
          ctx.beginPath();
          ctx.moveTo(sgn * scale * 0.18, scale * 0.26);
          ctx.lineTo(sgn * scale * (0.30 + i * 0.07), scale * 0.42);
          ctx.stroke();
        }
      }
      blob(0, scale * 0.18, scale * 0.36, scale * 0.24, a.c1);
      blob(0, scale * 0.22, scale * 0.24, scale * 0.14, a.c2);
      ctx.strokeStyle = cdark;
      ctx.lineWidth = scale * 0.04;
      ctx.beginPath();
      ctx.moveTo(-scale * 0.24, scale * 0.10);
      ctx.lineTo(0, scale * 0.02);
      ctx.lineTo(scale * 0.24, scale * 0.10);
      ctx.stroke();
      for (const sgn of [-1, 1]) {
        ctx.strokeStyle = a.c1;
        ctx.lineWidth = scale * 0.05;
        ctx.beginPath();
        ctx.moveTo(sgn * scale * 0.12, scale * 0.02);
        ctx.lineTo(sgn * scale * 0.14, -scale * 0.20);
        ctx.stroke();
        eye(sgn * scale * 0.14, -scale * 0.24, scale * 0.06);
      }
      break;
    }
    case 'bird': {
      const flap = Math.sin(T * 7) * 0.42;
      const dark = shadeBy(a.c1, -42);
      const light = shadeBy(a.c1, 0.34);
      const gold = '#eeb048';
      // Tail fan and far wing first, so the body overlaps both.
      poly(dark, [[scale * 0.22, scale * 0.02], [scale * 0.52, -scale * 0.12],
                  [scale * 0.63, scale * 0.02], [scale * 0.57, scale * 0.19],
                  [scale * 0.26, scale * 0.24]]);
      ctx.save();
      ctx.translate(scale * 0.04, scale * 0.04);
      ctx.rotate(-flap * 0.5);
      poly(dark, [[0, 0], [scale * 0.34, -scale * 0.02], [scale * 0.22, scale * 0.18]]);
      ctx.restore();
      blob(0, scale * 0.10, scale * 0.34, scale * 0.30, a.c1);
      blob(-scale * 0.05, scale * 0.16, scale * 0.21, scale * 0.18, a.c2);
      // Near wing in a mid slate, so it reads against the pale belly rather
      // than merging into it, with a darker feather layered on top.
      ctx.save();
      ctx.rotate(flap);
      poly(light, [[-scale * 0.06, -scale * 0.04], [scale * 0.40, -scale * 0.16],
                   [scale * 0.27, scale * 0.16]]);
      poly(dark, [[scale * 0.01, scale * 0.01], [scale * 0.31, -scale * 0.10],
                  [scale * 0.23, scale * 0.11]]);
      ctx.restore();
      ctx.fillStyle = gold;
      ctx.fillRect(-scale * 0.10, scale * 0.36, scale * 0.05, scale * 0.12);
      ctx.fillRect(scale * 0.06, scale * 0.36, scale * 0.05, scale * 0.12);
      blob(-scale * 0.22, -scale * 0.22, scale * 0.19, scale * 0.19, a.c1);
      poly(a.c2, [[-scale * 0.32, -scale * 0.36], [-scale * 0.25, -scale * 0.60],
                  [-scale * 0.14, -scale * 0.34]]);
      poly(gold, [[-scale * 0.36, -scale * 0.26], [-scale * 0.60, -scale * 0.18],
                  [-scale * 0.36, -scale * 0.10]]);
      eye(-scale * 0.24, -scale * 0.27, scale * 0.055);
      break;
    }
    case 'spark': {
      const p = 1 + Math.sin(T * 9) * 0.08;
      ctx.fillStyle = a.c2;
      ctx.globalAlpha = 0.35;
      ctx.beginPath(); ctx.arc(0, 0, scale * 0.55 * p, 0, Math.PI * 2); ctx.fill();
      ctx.globalAlpha = 1;
      ctx.fillStyle = a.c1;
      ctx.beginPath();
      for (let i = 0; i < 8; i++) {
        const ang = (i / 8) * Math.PI * 2 - Math.PI / 2;
        const r = (i % 2 ? 0.24 : 0.46) * scale * p;
        const x = Math.cos(ang) * r, y = Math.sin(ang) * r;
        i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
      }
      ctx.closePath(); ctx.fill();
      blob(0, 0, scale * 0.2, scale * 0.2, a.c2);
      eye(-scale * 0.08, -scale * 0.02, scale * 0.045);
      eye(scale * 0.08, -scale * 0.02, scale * 0.045);
      break;
    }
    case 'rock': {
      ctx.fillStyle = a.c1;
      ctx.beginPath();
      const pts = [[-0.44, 0.18], [-0.34, -0.26], [-0.06, -0.44], [0.28, -0.32],
                   [0.46, 0.02], [0.36, 0.38], [-0.12, 0.46], [-0.4, 0.38]];
      pts.forEach(([x, y], i) => i ? ctx.lineTo(x * scale, y * scale) : ctx.moveTo(x * scale, y * scale));
      ctx.closePath(); ctx.fill();
      ctx.fillStyle = a.c2;
      ctx.beginPath();
      ctx.moveTo(-scale * 0.2, -scale * 0.3);
      ctx.lineTo(scale * 0.1, -scale * 0.36);
      ctx.lineTo(scale * 0.02, -scale * 0.12);
      ctx.closePath(); ctx.fill();
      if (a.crystals) {
        ctx.fillStyle = '#7fd8e8';
        for (const [bx, by] of [[-0.3, -0.34], [0.22, -0.42], [0.42, -0.06]]) {
          ctx.beginPath();
          ctx.moveTo(bx * scale, by * scale);
          ctx.lineTo((bx + 0.07) * scale, (by - 0.22) * scale);
          ctx.lineTo((bx + 0.14) * scale, by * scale);
          ctx.closePath(); ctx.fill();
        }
      }
      ctx.strokeStyle = 'rgba(0,0,0,0.25)';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(-scale * 0.26, scale * 0.3);
      ctx.lineTo(-scale * 0.06, scale * 0.12);
      ctx.lineTo(scale * 0.16, scale * 0.34);
      ctx.stroke();
      eye(-scale * 0.16, scale * 0.02, scale * 0.06);
      eye(scale * 0.16, scale * 0.02, scale * 0.06);
      break;
    }
    case 'ooze': {
      ctx.fillStyle = a.c1;
      ctx.beginPath();
      for (let i = 0; i <= 32; i++) {
        const ang = (i / 32) * Math.PI * 2;
        const wob = 1 + Math.sin(ang * 3 + T * 3) * 0.08;
        const r = scale * 0.42 * wob;
        const x = Math.cos(ang) * r, y = Math.sin(ang) * r * 0.92 + scale * 0.08;
        i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
      }
      ctx.closePath(); ctx.fill();
      ctx.fillStyle = a.c2;
      ctx.globalAlpha = 0.7;
      for (const [bx, by, br] of [[-0.16, -0.12, 0.08], [0.18, 0.04, 0.06], [0.02, 0.22, 0.05]]) {
        ctx.beginPath(); ctx.arc(bx * scale, by * scale + scale * 0.08, br * scale, 0, Math.PI * 2); ctx.fill();
      }
      ctx.globalAlpha = 1;
      eye(-scale * 0.14, -scale * 0.02, scale * 0.06);
      eye(scale * 0.14, -scale * 0.02, scale * 0.06);
      ctx.strokeStyle = '#16181c';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(0, scale * 0.14, scale * 0.12, 0.15 * Math.PI, 0.85 * Math.PI);
      ctx.stroke();
      break;
    }
    case 'wisp': {
      const bob = Math.sin(T * 3) * scale * 0.06;
      ctx.globalAlpha = 0.3;
      ctx.fillStyle = a.c2;
      ctx.beginPath(); ctx.arc(0, bob, scale * 0.5, 0, Math.PI * 2); ctx.fill();
      ctx.globalAlpha = 1;
      if (a.relic) {
        // DUNEGHAST wears a broken stone halo rather than a smooth ring.
        for (let i = 0; i < 7; i++) {
          const ang = T * 0.6 + i * (Math.PI * 2 / 7);
          const px = Math.cos(ang) * scale * 0.46;
          const py = Math.sin(ang) * scale * 0.20;
          poly(a.c2, [[px - scale * 0.06, py + bob - scale * 0.05],
                      [px + scale * 0.06, py + bob - scale * 0.06],
                      [px + scale * 0.05, py + bob + scale * 0.06],
                      [px - scale * 0.06, py + bob + scale * 0.05]]);
        }
      } else {
        ctx.strokeStyle = a.c2;
        ctx.lineWidth = scale * 0.05;
        ctx.beginPath();
        ctx.ellipse(0, bob, scale * 0.46, scale * 0.2, T % (Math.PI * 2), 0, Math.PI * 2);
        ctx.stroke();
      }
      blob(0, bob, scale * 0.3, scale * 0.3, a.c1);
      ctx.fillStyle = a.c1;
      ctx.beginPath();
      ctx.moveTo(-scale * 0.1, bob + scale * 0.26);
      ctx.quadraticCurveTo(0, bob + scale * 0.62, scale * 0.12, bob + scale * 0.3);
      ctx.closePath(); ctx.fill();
      eye(-scale * 0.1, bob - scale * 0.02, scale * 0.055);
      eye(scale * 0.1, bob - scale * 0.02, scale * 0.055);
      break;
    }
  }
  ctx.restore();
}

/* --- overworld tiles ---------------------------------------------------- */
// Signs, item balls and ledges sit on whatever ground surrounds them.
// Without this they always painted a grass square, which looked wrong on the
// beach and plain broken on a cave floor.
// The glyph a collected item ball leaves behind: the same ground groundTone
// paints under it, so a taken cave ball is cave floor, not a square of lawn.
function pickedGround(gx, gy) {
  const near = [[0, 1], [0, -1], [-1, 0], [1, 0]].map(([dx, dy]) => tileAt(gx + dx, gy + dy));
  return ['c', 's', '_'].find(g => near.includes(g)) || '.';
}

const PICKED_TEXT = { c: 'a scuff on the cave floor', s: 'a hollow in the sand',
                      _: 'a scuff on the path', scree: 'a scrape in the scree',
                      '.': 'a dent in the grass' };

// What a collected item ball leaves behind, by the ground pickedGround paints
// there (ROCKY PASS ground is scree, not grass).
function pickedText(gx, gy) {
  let g = pickedGround(gx, gy);
  if (g === '.' && gy >= ROCK_BAND[0] && gy <= ROCK_BAND[1]) g = 'scree';
  return PICKED_TEXT[g];
}

function groundTone(gx, gy) {
  const near = [[0, 1], [0, -1], [-1, 0], [1, 0]].map(([dx, dy]) => tileAt(gx + dx, gy + dy));
  if (near.includes('c')) return '#383440';
  if (near.includes('s')) return '#e0cc96';
  if (near.includes('_')) return '#c0a87c';
  if (gy >= ROCK_BAND[0] && gy <= ROCK_BAND[1]) return '#948c7c';
  return '#5aa557';
}

// The forest tree '#' draws outside ROCK_BAND; the THICK TREE (T) draws it
// too, then its marked trunk, so the two can't drift.
function deepwoodTree(sx, sy, n, ground) {
  ctx.fillStyle = ground;
  ctx.fillRect(sx, sy, TILE, TILE);
  ctx.fillStyle = '#6b4a2a';
  ctx.fillRect(sx + 13, sy + 18, 6, 14);
  ctx.fillStyle = n > 0.5 ? '#2c6b33' : '#275e2d';
  ctx.beginPath(); ctx.arc(sx + 16, sy + 14, 13, 0, Math.PI * 2); ctx.fill();
  ctx.fillStyle = 'rgba(255,255,255,0.09)';
  ctx.beginPath(); ctx.arc(sx + 11, sy + 9, 5, 0, Math.PI * 2); ctx.fill();
}

function drawTile(t, sx, sy, gx, gy) {
  const n = hash(gx, gy);
  const rocky = gy >= ROCK_BAND[0] && gy <= ROCK_BAND[1];
  switch (t) {
    case '.':
      if (rocky) {
        // Scree rather than lawn, so the pass reads as a pass.
        ctx.fillStyle = n > 0.85 ? '#9e9686' : '#948c7c';
        ctx.fillRect(sx, sy, TILE, TILE);
        if (n > 0.8) {
          ctx.fillStyle = '#847c6e';
          ctx.fillRect(sx + 7 + n * 10, sy + 9 + n * 9, 5, 3);
        }
        if (n < 0.2) { ctx.fillStyle = '#a8a090'; ctx.fillRect(sx + 20, sy + 22, 4, 3); }
      } else {
        ctx.fillStyle = n > 0.85 ? '#63ac5e' : '#5aa557';
        ctx.fillRect(sx, sy, TILE, TILE);
        if (n > 0.93) {
          ctx.fillStyle = '#4f9a4d';
          ctx.fillRect(sx + 8 + n * 10, sy + 10 + n * 8, 4, 3);
        }
      }
      break;
    case '_':
      ctx.fillStyle = n > 0.8 ? '#c8b083' : '#c0a87c';
      ctx.fillRect(sx, sy, TILE, TILE);
      ctx.fillStyle = 'rgba(140,116,80,0.5)';
      if (n > 0.6) ctx.fillRect(sx + 6, sy + 18, 5, 3);
      if (n < 0.3) ctx.fillRect(sx + 20, sy + 8, 4, 3);
      break;
    case ',': {
      ctx.fillStyle = '#3f8a44';
      ctx.fillRect(sx, sy, TILE, TILE);
      ctx.strokeStyle = '#2f6e34';
      ctx.lineWidth = 2;
      const sway = Math.sin(G.time * 2 + gx * 0.7 + gy * 0.4) * 2;
      for (let i = 0; i < 4; i++) {
        const bx = sx + 5 + i * 7;
        ctx.beginPath();
        ctx.moveTo(bx, sy + TILE - 2);
        ctx.quadraticCurveTo(bx + sway, sy + 14, bx + sway * 1.6, sy + 5);
        ctx.stroke();
      }
      break;
    }
    case '~': {
      ctx.fillStyle = '#3a72b8';
      ctx.fillRect(sx, sy, TILE, TILE);
      ctx.strokeStyle = 'rgba(180,220,255,0.45)';
      ctx.lineWidth = 2;
      const off = Math.sin(G.time * 1.8 + gx * 0.5 + gy * 0.3) * 3;
      ctx.beginPath();
      ctx.moveTo(sx + 4, sy + 12 + off);
      ctx.lineTo(sx + 14, sy + 12 + off);
      ctx.moveTo(sx + 18, sy + 22 - off);
      ctx.lineTo(sx + 28, sy + 22 - off);
      ctx.stroke();
      break;
    }
    case '#':
      if (rocky) {
        // A boulder, not a pine.
        ctx.fillStyle = '#948c7c';
        ctx.fillRect(sx, sy, TILE, TILE);
        ctx.fillStyle = n > 0.5 ? '#767066' : '#6c665e';
        ctx.beginPath();
        [[4, 24], [7, 12], [14, 6], [24, 9], [29, 18], [27, 28], [10, 29]]
          .forEach(([bx, by], i) => i ? ctx.lineTo(sx + bx, sy + by)
                                      : ctx.moveTo(sx + bx, sy + by));
        ctx.closePath(); ctx.fill();
        ctx.fillStyle = '#928c82';
        ctx.beginPath();
        ctx.moveTo(sx + 12, sy + 11); ctx.lineTo(sx + 21, sy + 13);
        ctx.lineTo(sx + 16, sy + 19);
        ctx.closePath(); ctx.fill();
        ctx.strokeStyle = '#544f48';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(sx + 9, sy + 25); ctx.lineTo(sx + 20, sy + 21);
        ctx.stroke();
      } else {
        deepwoodTree(sx, sy, n, '#4f9a4d');
      }
      break;
    case TREE: {
      // A THICK TREE: the same forest tree, stripped to a pale trunk band
      // with axe notches - it reads as "thinner, marked" among the '#'
      // forest the way the seam reads against cave rock. Static art.
      deepwoodTree(sx, sy, n, groundTone(gx, gy));
      const [bx, by, bw, bh] = TREE_BAND;
      ctx.fillStyle = rgbStr(TREE_TRUNK);
      ctx.fillRect(sx + bx, sy + by, bw, bh);
      ctx.fillStyle = rgbStr(TREE_NOTCH);
      for (const ny of TREE_NOTCHES) {
        ctx.beginPath();
        ctx.moveTo(sx + bx, sy + ny - 1); ctx.lineTo(sx + bx + bw, sy + ny + 1);
        ctx.lineTo(sx + bx, sy + ny + 2);
        ctx.closePath(); ctx.fill();
      }
      break;
    }
    case 'B': {
      const ruin = gy >= RUINS_BAND[0] && gy <= RUINS_BAND[1];
      ctx.fillStyle = ruin ? '#928c80' : '#9aa3ad';
      ctx.fillRect(sx, sy, TILE, TILE);
      ctx.fillStyle = ruin ? '#787268' : '#7f8892';
      ctx.fillRect(sx, sy, TILE, 3);
      ctx.fillStyle = ruin ? '#5c574f' : '#5b6672';
      ctx.fillRect(sx + 2, sy + 2, TILE - 4, 2);
      if (ruin) {
        // Weathered pillar stone: seams and chips, never windows.
        ctx.strokeStyle = '#706a60';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(sx, sy + 14); ctx.lineTo(sx + TILE, sy + 14);
        ctx.moveTo(sx + 16, sy + 14); ctx.lineTo(sx + 16, sy + TILE);
        ctx.stroke();
        if (n > 0.7) {
          ctx.fillStyle = '#787268';
          ctx.beginPath();
          ctx.moveTo(sx + 6, sy + 22); ctx.lineTo(sx + 12, sy + 19);
          ctx.lineTo(sx + 10, sy + 26);
          ctx.closePath(); ctx.fill();
        }
      } else if ((gx + gy) % 3 === 0) {
        ctx.fillStyle = '#c9e6ff';
        ctx.fillRect(sx + 8, sy + 10, 16, 12);
        ctx.strokeStyle = '#5b6672';
        ctx.lineWidth = 2;
        ctx.strokeRect(sx + 8, sy + 10, 16, 12);
      }
      break;
    }
    case ';': {
      // Dark grass: rarer, meaner encounters than ordinary tall grass.
      ctx.fillStyle = '#263e36';
      ctx.fillRect(sx, sy, TILE, TILE);
      ctx.strokeStyle = '#182c26';
      ctx.lineWidth = 2;
      const dsway = Math.sin(G.time * 1.6 + gx * 0.7 + gy * 0.4) * 2;
      for (let i = 0; i < 4; i++) {
        const bx = sx + 5 + i * 7;
        ctx.beginPath();
        ctx.moveTo(bx, sy + TILE - 2);
        ctx.quadraticCurveTo(bx + dsway, sy + 13, bx + dsway * 1.6, sy + 3);
        ctx.stroke();
      }
      if (n > 0.88) {
        ctx.fillStyle = '#78b096';
        ctx.beginPath(); ctx.arc(sx + 16, sy + 12, 2, 0, Math.PI * 2); ctx.fill();
      }
      break;
    }
    case 'c':
      ctx.fillStyle = n > 0.8 ? '#3e3a46' : '#383440';
      ctx.fillRect(sx, sy, TILE, TILE);
      if (n > 0.9) { ctx.fillStyle = '#302c38'; ctx.fillRect(sx + 9, sy + 12, 7, 4); }
      if (n < 0.12) {
        ctx.fillStyle = '#4a4654';
        ctx.beginPath(); ctx.arc(sx + 22, sy + 20, 3, 0, Math.PI * 2); ctx.fill();
      }
      break;
    case 'K': {
      // A CRACKED SEAM: cave rock split by a fault with ORE lit in the gap -
      // warm, high-contrast lines so it reads inside the lantern.
      ctx.fillStyle = '#282430';
      ctx.fillRect(sx, sy, TILE, TILE);
      ctx.fillStyle = '#36303e';
      ctx.fillRect(sx, sy, TILE, 5);
      const fault = [[6, 2], [14, 11], [10, 18], [19, 24], [15, 31]];
      ctx.lineJoin = 'round';
      for (const [col, wdt] of [['#0e0c14', 6], [SEAM_EDGE, 2]]) {
        ctx.strokeStyle = col; ctx.lineWidth = wdt;
        ctx.beginPath();
        fault.forEach(([fx, fy], i) => (i ? ctx.lineTo : ctx.moveTo).call(ctx, sx + fx, sy + fy));
        ctx.stroke();
      }
      for (const [col, wdt] of [['#0e0c14', 4], [SEAM_EDGE, 1]]) {
        ctx.strokeStyle = col; ctx.lineWidth = wdt;
        ctx.beginPath(); ctx.moveTo(sx + 14, sy + 11); ctx.lineTo(sx + 27, sy + 7); ctx.stroke();
      }
      ctx.lineJoin = 'miter'; ctx.lineWidth = 1;
      ctx.fillStyle = ORE_GLINT;
      for (const [ox, oy] of [[11, 17], [18, 23], [23, 8]]) ctx.fillRect(sx + ox, sy + oy, 3, 3);
      break;
    }
    case 'C':
      ctx.fillStyle = '#282430';
      ctx.fillRect(sx, sy, TILE, TILE);
      ctx.fillStyle = '#36303e';
      ctx.fillRect(sx, sy, TILE, 5);
      ctx.fillStyle = '#1e1b26';
      ctx.beginPath();
      ctx.moveTo(sx, sy + 8); ctx.lineTo(sx + 12, sy + 16); ctx.lineTo(sx, sy + 24);
      ctx.closePath(); ctx.fill();
      ctx.fillStyle = '#302b38';
      ctx.beginPath();
      ctx.moveTo(sx + TILE, sy + 10); ctx.lineTo(sx + 20, sy + 19);
      ctx.lineTo(sx + TILE, sy + 28);
      ctx.closePath(); ctx.fill();
      break;
    case 's':
      ctx.fillStyle = n > 0.8 ? '#e8d6a2' : '#e0cc96';
      ctx.fillRect(sx, sy, TILE, TILE);
      ctx.fillStyle = '#ceb882';
      if (n > 0.86) { ctx.beginPath(); ctx.arc(sx + 10, sy + 20, 2, 0, Math.PI * 2); ctx.fill(); }
      if (n < 0.15) { ctx.beginPath(); ctx.arc(sx + 23, sy + 9, 2, 0, Math.PI * 2); ctx.fill(); }
      break;
    case '=':
      ctx.fillStyle = '#3a72b8';
      ctx.fillRect(sx, sy, TILE, TILE);
      ctx.fillStyle = '#967042';
      ctx.fillRect(sx, sy + 4, TILE, TILE - 8);
      ctx.strokeStyle = '#70522e';
      ctx.lineWidth = 2;
      for (let i = 0; i < 4; i++) {
        ctx.beginPath();
        ctx.moveTo(sx + i * 8, sy + 4); ctx.lineTo(sx + i * 8, sy + TILE - 5);
        ctx.stroke();
      }
      ctx.strokeStyle = '#ba9460';
      ctx.beginPath(); ctx.moveTo(sx, sy + 6); ctx.lineTo(sx + TILE, sy + 6); ctx.stroke();
      break;
    case 'f': {
      ctx.fillStyle = '#5aa557';
      ctx.fillRect(sx, sy, TILE, TILE);
      const petals = ['#e87896', '#f0dc6e', '#c88ce6'];
      [[8, 10], [21, 17], [13, 24]].forEach(([fx2, fy2], i) => {
        ctx.fillStyle = petals[(gx + gy + i) % 3];
        ctx.beginPath(); ctx.arc(sx + fx2, sy + fy2, 3, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = '#faf5dc';
        ctx.beginPath(); ctx.arc(sx + fx2, sy + fy2, 1, 0, Math.PI * 2); ctx.fill();
      });
      break;
    }
    case 'S':
      ctx.fillStyle = groundTone(gx, gy);
      ctx.fillRect(sx, sy, TILE, TILE);
      ctx.fillStyle = '#6e4e2e';
      ctx.fillRect(sx + 14, sy + 18, 5, 13);
      ctx.fillStyle = '#a8804a';
      ctx.fillRect(sx + 5, sy + 6, TILE - 10, 15);
      ctx.strokeStyle = '#6e4e2e';
      ctx.lineWidth = 2;
      ctx.strokeRect(sx + 5, sy + 6, TILE - 10, 15);
      ctx.strokeStyle = '#5c4228';
      ctx.lineWidth = 1;
      for (let i = 0; i < 3; i++) {
        ctx.beginPath();
        ctx.moveTo(sx + 8, sy + 10 + i * 4);
        ctx.lineTo(sx + TILE - 9, sy + 10 + i * 4);
        ctx.stroke();
      }
      break;
    case 'o': {
      ctx.fillStyle = groundTone(gx, gy);
      ctx.fillRect(sx, sy, TILE, TILE);
      const bcx = sx + TILE / 2, bcy = sy + TILE / 2 + 2;
      ctx.fillStyle = '#e84a4a';
      ctx.beginPath(); ctx.arc(bcx, bcy, 8, Math.PI, 0); ctx.fill();
      ctx.fillStyle = '#f4f4f4';
      ctx.beginPath(); ctx.arc(bcx, bcy, 8, 0, Math.PI); ctx.fill();
      ctx.fillStyle = '#2a3340';
      ctx.fillRect(bcx - 8, bcy - 1.5, 16, 3);
      ctx.beginPath(); ctx.arc(bcx, bcy, 3, 0, Math.PI * 2); ctx.fill();
      break;
    }
    case 'v':
      // A ledge: ground on top, a shadowed lip you drop off southward.
      ctx.fillStyle = groundTone(gx, gy);
      ctx.fillRect(sx, sy, TILE, TILE);
      ctx.fillStyle = '#7a603a';
      ctx.fillRect(sx, sy + 14, TILE, 12);
      ctx.fillStyle = '#96784a';
      ctx.fillRect(sx, sy + 14, TILE, 4);
      ctx.fillStyle = '#403220';
      ctx.fillRect(sx, sy + 26, TILE, 4);
      ctx.fillStyle = '#c4aa6e';
      for (let i = 0; i < 2; i++) {
        ctx.beginPath();
        ctx.moveTo(sx + 9 + i * 14, sy + 30);
        ctx.lineTo(sx + 15 + i * 14, sy + 30);
        ctx.lineTo(sx + 12 + i * 14, sy + 35);
        ctx.closePath(); ctx.fill();
      }
      break;
    case 'H': case 'D': case 'G': {
      ctx.fillStyle = '#9aa3ad';
      ctx.fillRect(sx, sy, TILE, TILE);
      const col = t === 'H' ? '#e05a72' : t === 'G' ? '#e8c22e' : '#6fa8d8';
      ctx.fillStyle = '#3a4149';
      ctx.fillRect(sx + 5, sy + 6, TILE - 10, TILE - 6);
      ctx.fillStyle = col;
      ctx.fillRect(sx + 7, sy + 8, TILE - 14, 8);
      ctx.fillStyle = '#c9e6ff';
      ctx.fillRect(sx + 8, sy + 19, TILE - 16, 13);
      break;
    }
    case 'W': {
      // A player-built wall: coursed stone blocks on the pass's scree.
      ctx.fillStyle = '#948c7c';
      ctx.fillRect(sx, sy, TILE, TILE);
      drawWallBody(sx, sy);
      break;
    }
    default:
      ctx.fillStyle = '#5aa557';
      ctx.fillRect(sx, sy, TILE, TILE);
  }
}

// The WALL without its ground, so the pop-in can scale just the stones.
function drawWallBody(sx, sy) {
  ctx.fillStyle = '#54504c';
  ctx.fillRect(sx + 1, sy + 3, TILE - 2, TILE - 4);
  for (let row = 0; row < 3; row++) {
    const off = row % 2 === 0 ? 0 : 7;
    for (let col = -1; col < 3; col++) {
      const bx = sx + 2 + off + col * 14;
      const x0 = Math.max(bx, sx + 2), x1 = Math.min(bx + 12, sx + TILE - 2);
      if (x1 - x0 < 3) continue;
      ctx.fillStyle = (col + row) % 2 ? '#b0aa9e' : '#a29c92';
      ctx.fillRect(x0, sy + 5 + row * 9, x1 - x0, 7);
    }
  }
  ctx.fillStyle = '#c6c0b4';
  ctx.fillRect(sx + 1, sy + 3, TILE - 2, 2);
}

function drawHuman(cx, cy, dir, c1, c2, bob) {
  ctx.save();
  ctx.translate(cx, cy);
  ctx.fillStyle = 'rgba(0,0,0,0.22)';
  ctx.beginPath(); ctx.ellipse(0, 13, 10, 3.5, 0, 0, Math.PI * 2); ctx.fill();
  const b = bob ? Math.sin(bob) * 1.5 : 0;
  ctx.translate(0, b);
  // legs
  ctx.fillStyle = '#39414d';
  ctx.fillRect(-6, 4, 5, 9);
  ctx.fillRect(1, 4, 5, 9);
  // body
  ctx.fillStyle = c1;
  ctx.fillRect(-8, -6, 16, 12);
  ctx.fillStyle = c2;
  ctx.fillRect(-8, -6, 16, 4);
  // head
  ctx.fillStyle = '#e8c39a';
  ctx.beginPath(); ctx.arc(0, -13, 8, 0, Math.PI * 2); ctx.fill();
  // hair / cap
  ctx.fillStyle = c2;
  ctx.beginPath();
  ctx.arc(0, -14, 8, Math.PI, Math.PI * 2);
  ctx.closePath(); ctx.fill();
  if (dir !== 'up') {
    ctx.fillStyle = '#16181c';
    if (dir === 'down') {
      ctx.fillRect(-4, -14, 2.5, 3);
      ctx.fillRect(2, -14, 2.5, 3);
    } else if (dir === 'left') {
      ctx.fillRect(-5, -14, 2.5, 3);
    } else {
      ctx.fillRect(3, -14, 2.5, 3);
    }
  }
  ctx.restore();
}

/* --- overworld render --------------------------------------------------- */
// DARK CAVE is unlit: you see a lantern's worth of floor and no more, with a
// soft warm edge that follows the charge in LANTERN buckets. One small hole
// sprite (and one flicker ring) per bucket is built once and cached; the rest
// of the screen is filled flat around it. The hole is clear inside
// LANTERN.corePx, so the 4 neighbouring tiles are lit even at empty.
const caveMasks = new Map();      // bucket -> { hole, ring }
const CAVE_DARK = rgbStr(LAMP_DARK, (LAMP_DARK_ALPHA / 255).toFixed(3));
function lampSprites(charge) {
  const b = lanternBucket(charge);
  let got = caveMasks.get(b);
  if (!got) {
    const lit = Math.round(lanternRadius(charge) * TILE), r = lampHoleRadius(charge), core = LANTERN.corePx;
    const hole = document.createElement('canvas');
    hole.width = hole.height = r * 2;
    const m = hole.getContext('2d');
    const gr = m.createRadialGradient(r, r, core, r, r, r);
    const N = 32;
    for (let i = 0; i <= N; i++) {
      const [rgb, a] = lampProfile(core + (r - core) * i / N, lit);
      gr.addColorStop(i / N, rgbStr(i === 0 ? LAMP_TINT : rgb, (a / 255).toFixed(3)));
    }
    m.fillStyle = gr;
    m.fillRect(0, 0, r * 2, r * 2);
    const ring = document.createElement('canvas');
    ring.width = ring.height = r * 2;
    const n = ring.getContext('2d');
    const rg = n.createRadialGradient(r, r, core, r, r, r);
    rg.addColorStop(0, rgbStr(LAMP_DARK, 0));
    rg.addColorStop(1, rgbStr(LAMP_DARK, (LAMP_FLICKER_ALPHA / 255).toFixed(3)));
    n.fillStyle = rg;
    n.beginPath(); n.arc(r, r, r, 0, Math.PI * 2); n.fill();
    got = { hole, ring };
    caveMasks.set(b, got);
  }
  return got;
}

function drawCaveDark(cx, cy) {
  const { hole, ring } = lampSprites(G.lantern);
  const r = hole.width / 2;
  const x0 = Math.round(cx) - r, y0 = Math.round(cy) - r;
  ctx.fillStyle = CAVE_DARK;
  ctx.fillRect(0, 0, W, Math.max(0, y0));
  ctx.fillRect(0, y0 + 2 * r, W, Math.max(0, H - (y0 + 2 * r)));
  ctx.fillRect(0, y0, Math.max(0, x0), 2 * r);
  ctx.fillRect(x0 + 2 * r, y0, Math.max(0, W - (x0 + 2 * r)), 2 * r);
  ctx.drawImage(hole, x0, y0);
  const f = CFX.flicker * lampFlickerAmp(G.lantern, caveCalm());
  if (f > 0.01) { ctx.globalAlpha = Math.min(1, f); ctx.drawImage(ring, x0, y0); ctx.globalAlpha = 1; }
}

// A cached additive glow (transparent outside), radius r px.
const eyeGlows = new Map();
function eyeGlow(r) {
  let c = eyeGlows.get(r);
  if (!c) {
    c = document.createElement('canvas');
    c.width = c.height = r * 2;
    const m = c.getContext('2d');
    const gr = m.createRadialGradient(r, r, 0, r, r, r);
    gr.addColorStop(0, rgbStr(EYE_COL, 0.6));
    gr.addColorStop(1, rgbStr(EYE_COL, 0));
    m.fillStyle = gr;
    m.fillRect(0, 0, r * 2, r * 2);
    eyeGlows.set(r, c);
  }
  return c;
}

// The GLOOMSTALK in the overworld. eyes=false: a shadow of its body, drawn
// under the darkness so the lantern decides whether you see it. eyes=true:
// glowing eyes over the darkness while it hunts within sense (blinking,
// drifting, a fading trail as it moves), dimmed eyes and a daze while
// stunned, and the swelling flare of a lunge.
let shadeCv = null;
function drawStalker(eyes) {
  const st = G.stalker;
  if (!st) return;
  const [wx, wy] = stalkerPx(st);
  const sx = wx - camX, sy = wy - camY;
  if (!eyes) {
    if (!shadeCv) { shadeCv = document.createElement('canvas'); shadeCv.width = shadeCv.height = 96; }
    const m = shadeCv.getContext('2d');
    m.globalCompositeOperation = 'source-over';
    m.clearRect(0, 0, 96, 96);
    const keep = ctx;
    ctx = m;                                     // drawCreature draws on ctx
    try { drawCreature(SPECIES[HUNT.species], 48, 50, 30, false, false, G.time); } finally { ctx = keep; }
    // Darken it to a shadow inside its own shape (pygame multiplies by
    // STALKER_SHADE; a dark wash over the sprite reads the same).
    m.globalCompositeOperation = 'source-atop';
    m.fillStyle = 'rgba(14,10,24,0.78)';
    m.fillRect(0, 0, 96, 96);
    m.globalCompositeOperation = 'source-over';
    ctx.drawImage(shadeCv, Math.round(sx) - 48, Math.round(sy) + 2 - 50);
    return;
  }
  const lunge = CFX.lungeAge !== null;
  const kind = lunge ? 'hunt' : stalkerEyes(st, [G.player.tx, G.player.ty], G.lantern, G.tension);
  if (!kind) return;
  const calm = caveCalm();
  if (kind === 'stun') {
    ctx.fillStyle = rgbStr(EYE_STUN_COL);
    for (const dx of [-5, 5]) { ctx.beginPath(); ctx.arc(sx + dx, sy - 4, 2, 0, Math.PI * 2); ctx.fill(); }
    if (calm) text('z', sx + 10, sy - 12, 11, rgbStr(EYE_STUN_COL));
    else {
      ctx.fillStyle = '#c4cee2';
      for (let i = 0; i < 3; i++) {                // a small daze, circling its head
        const a = G.time * 4 + i * Math.PI * 2 / 3;
        ctx.fillRect(Math.round(sx + Math.cos(a) * 9) - 1, Math.round(sy - 17 + Math.sin(a) * 3) - 1, 2, 2);
      }
    }
    return;
  }
  if (!calm) {
    for (const tr of CFX.trail) {
      if (tr.t <= 0) continue;
      ctx.fillStyle = rgbStr(EYE_COL, (0.5 * tr.t / TRAIL_TIME).toFixed(3));
      for (const dx of [-5, 5]) { ctx.beginPath(); ctx.arc(tr.x - camX + dx, tr.y - camY - 4, 2, 0, Math.PI * 2); ctx.fill(); }
    }
  }
  const u = lunge ? Math.min(1, CFX.lungeAge / LUNGE_TIME) : 0;
  const scale = 1 + (LUNGE_EYE_SCALE - 1) * smoothstep(u);
  const bob = calm || lunge ? 0 : Math.sin(G.time * Math.PI * 2 * 0.9) * EYE_BOB;
  const ey = Math.round(sy - 4 + bob), gr = Math.round(6 * scale);
  const glow = eyeGlow(gr), blink = CFX.blink > 0 && !lunge;
  for (const dx of [-5, 5]) {
    const ex = Math.round(sx + dx * scale);
    ctx.globalCompositeOperation = 'lighter';
    ctx.drawImage(glow, ex - gr, ey - gr);
    ctx.globalCompositeOperation = 'source-over';
    ctx.fillStyle = rgbStr(EYE_COL);
    if (blink) ctx.fillRect(ex - 2, ey, 5, 1);
    else {
      ctx.beginPath(); ctx.arc(ex, ey, Math.max(2, 2 * scale), 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = '#ffd6dc'; ctx.fillRect(ex - 1, ey - 1, 1, 1);
    }
  }
}

// The PULSE wavefront: it runs out over the tiles the pulse reaches by path
// (pulseRing), so it pours round rock and stops at PULSE.range.
function drawPulseRing() {
  const r = CFX.ring;
  if (!r) return;
  ctx.fillStyle = rgbStr(r.hit ? PULSE_HIT_COL : PULSE_MISS_COL);
  for (const [x, y, d] of r.tiles) {
    const a = ringAlpha(d);
    if (a <= 0) continue;
    ctx.globalAlpha = a / 255;
    ctx.fillRect(Math.round(x * TILE - camX), Math.round(y * TILE - camY), TILE, TILE);
  }
  ctx.globalAlpha = 1;
}

// Cached screen layers for the tension effects (built once, never per frame).
let vignetteCv = null, grainPat = null;
function vignetteLayer() {
  if (!vignetteCv) {
    vignetteCv = document.createElement('canvas');
    vignetteCv.width = W; vignetteCv.height = H;
    const m = vignetteCv.getContext('2d');
    m.translate(W / 2, H / 2);
    m.scale(W / 2, H / 2);                      // an ellipse: 1.0 at the edge midpoints
    const gr = m.createRadialGradient(0, 0, 0.45, 0, 0, 1.05);
    for (let i = 0; i <= 8; i++) gr.addColorStop(i / 8, 'rgba(8,0,4,' + smoothstep(i / 8).toFixed(3) + ')');
    m.fillStyle = gr;
    m.fillRect(-1.5, -1.5, 3, 3);
  }
  return vignetteCv;
}
function grainPattern() {
  if (!grainPat) {
    const c = document.createElement('canvas');
    c.width = c.height = GRAIN_TILE;
    const m = c.getContext('2d'), img = m.createImageData(GRAIN_TILE, GRAIN_TILE), d = img.data;
    for (let i = 0; i < d.length; i += 4) {
      const lvl = fxRand() < 0.55 ? 190 + Math.floor(fxRand() * 66) : 0;
      d[i] = d[i + 1] = d[i + 2] = lvl;
      d[i + 3] = Math.floor(GRAIN_ALPHA * fxRand());
    }
    m.putImageData(img, 0, 0);
    grainPat = ctx.createPattern(c, 'repeat');
  }
  return grainPat;
}

// Tension on screen: the edge vignette (t >= VIGNETTE_FROM), and at fear its
// heartbeat pulse, film grain and tear lines - none of those three with
// reduced motion. Then the lunge's single red flash. Drawn under the HUD.
function drawTensionFx() {
  const fx = tensionFx(G.tension, caveCalm());
  let a = fx.vignette;
  if (fx.pulse) a += VIGNETTE_PULSE * heartEnv(CFX.hbPhase);
  if (a > 0) { ctx.globalAlpha = Math.min(255, a) / 255; ctx.drawImage(vignetteLayer(), 0, 0); ctx.globalAlpha = 1; }
  if (fx.grain) {
    ctx.save();
    ctx.translate(-CFX.grainX, -CFX.grainY);
    ctx.fillStyle = grainPattern();
    ctx.fillRect(CFX.grainX, CFX.grainY, W, H);
    ctx.restore();
  }
  if (fx.tears) {
    for (const te of CFX.tears) {
      if (te.t <= 0) continue;
      ctx.drawImage(canvas, 0, te.y, W, te.h, te.dx, te.y, W, te.h);
      ctx.fillStyle = 'rgba(200,210,230,0.27)';
      ctx.fillRect(0, te.y, W, 1);
    }
  }
  const flare = lungeFlare(CFX.lungeAge);
  if (flare > 0) { ctx.fillStyle = 'rgba(140,0,16,' + (LUNGE_FLASH_ALPHA * flare / 255).toFixed(3) + ')'; ctx.fillRect(0, 0, W, H); }
}

// LAMP bar + %, TENSION bar + number from HUD_TENSION_FROM (labelled FEAR! at
// fear, so colour is never the only cue), and PULSE xN.
function drawCaveHud() {
  const [x, y, w, h] = HUD_CAVE_RECT;
  ctx.globalAlpha = 0.85;
  panel(x, y, w, h, '#1d2733', '#4a6a8a');
  ctx.globalAlpha = 1;
  const hb = caveHudBars(G.lantern, G.tension);
  const [bx, by, bw, bh] = hb.lamp;
  text('LAMP', x + 8, by + 6, 10, '#dcc8a0');
  ctx.fillStyle = '#39414d'; ctx.fillRect(bx, by, bw, bh);
  ctx.fillStyle = hb.low ? '#f06e3c' : '#ffbe5a'; ctx.fillRect(bx, by, hb.lampFill, bh);
  text(clamp(Math.trunc(G.lantern), 0, LANTERN.max) + '%', bx + bw + 30, by + 6, 10, '#dcc8a0', 'right');
  if (hb.tension) {
    const [tx, ty, tw, th] = hb.tension, col = hb.fear ? '#ff5f5f' : '#bea0f0';
    text(hb.label, x + 8, ty + 6, 10, col);
    ctx.fillStyle = '#39414d'; ctx.fillRect(tx, ty, tw, th);
    ctx.fillStyle = hb.fear ? '#ec404c' : '#a078e6'; ctx.fillRect(tx, ty, hb.tensionFill, th);
    text(String(clamp(Math.trunc(G.tension), 0, TENSION.max)), tx + tw + 30, ty + 6, 10, col, 'right');
  }
  const pc = G.pulses ? rgbStr(PULSE_HIT_COL) : '#6f8ba8';
  text('PULSE', x + w - 22, by + 6, 10, pc, 'center');
  text('x' + G.pulses, x + w - 22, by + 18, 10, pc, 'center');
}

function drawOverworld() {
  const p = G.player;
  camX = clamp(p.px + TILE / 2 - W / 2, 0, MAP_W * TILE - W);
  camY = clamp(p.py + TILE / 2 - H / 2, 0, MAP_H * TILE - H);
  const [ox, oy] = worldOffset();             // the world nudges; the HUD below does not
  camX += ox; camY += oy;
  const fxTiles = WFX.cracks.size > 0 || WFX.pops.size > 0;
  const opened = geodeOpen();

  const x0 = Math.floor(camX / TILE), y0 = Math.floor(camY / TILE);
  for (let y = y0; y <= y0 + VIEW_H; y++) {
    for (let x = x0; x <= x0 + VIEW_W; x++) {
      let t = overworldGlyph(x, y, opened);
      if (fxTiles) {
        const k = x + ',' + y;
        if (WFX.cracks.has(k)) t = WFX.cracks.get(k).tile;   // the broken tile lingers, cracked
        else if (WFX.pops.has(k)) t = '.';                   // ground; the popping WALL goes on top
      }
      drawTile(t, x * TILE - camX, y * TILE - camY, x, y);
    }
  }
  drawSandboxFx();

  if (G.building) {
    const [fx, fy] = facingTile(p);
    if (!WFX.pops.has(fx + ',' + fy)) drawBuildBox();   // let a fresh WALL pop unboxed
  }

  // Sort actors by Y so lower ones overlap higher ones.
  const actors = NPCS
    .map(n => ({ y: n.y * TILE, draw: () => {
      drawHuman(n.x * TILE - camX + TILE / 2, n.y * TILE - camY + TILE / 2 + 4,
                n.dir, n.c1, n.c2, G.time * 2 + n.x);
      if (n.kind === 'trainer' && !G.beaten[n.id]) {
        const t = Math.sin(G.time * 4) > 0.2;
        if (t) {
          ctx.fillStyle = '#ffe14d';
          text('!', n.x * TILE - camX + TILE / 2, n.y * TILE - camY - 4, 18, '#ffe14d', 'center');
        }
      }
    } }));

  actors.push({ y: p.py, draw: () => {
    const arc = p.moving ? Math.sin(p.t * Math.PI) * 16 * p.hop : 0;
    drawHuman(p.px - camX + TILE / 2, p.py - camY + TILE / 2 + 4 - arc,
              p.dir, '#d84b4b', '#8e2f2f', p.moving ? G.time * 14 : 0);
  } });

  actors.sort((a, b) => a.y - b.y).forEach(a => a.draw());

  // Location banner.
  const cave = inCave(p.ty);
  if (cave) {
    drawStalker(false);
    drawCaveDark(p.px - camX + TILE / 2, p.py - camY + TILE / 2);
    drawGeodeLight();
    drawSeamTells();
    drawPulseRing();
    drawStalker(true);
  }
  drawWorldFx();
  if (cave) drawTensionFx();     // the world's edges close in; the HUD below stays clean

  const zone = regionName(p.ty);
  ctx.globalAlpha = 0.85;
  panel(8, 8, 150, 30, '#1d2733', '#4a6a8a');
  ctx.globalAlpha = 1;
  text(zone, 20, 28, 13, '#bfe0ff');
  const tier = pickTier(G.flags.pick);
  if (tier) {
    const m = G.materials, [hx, hy, hw, hh] = HUD_MAT_RECT;
    ctx.globalAlpha = 0.85;
    panel(hx, hy, hw, hh, '#1d2733', '#4a6a8a');
    ctx.globalAlpha = 1;
    const label = CRAFT_TIER_NAME[tier];
    text(label, hx + 10, hy + 16, 11, HUD_TIER_COL[tier]);
    const lw = ctx.measureText(label + '  ').width;           // text() just set the 11 px font
    text('STONE ' + m.stone + '  ORE ' + m.ore + '  WALL ' + m.wall, hx + 10 + lw, hy + 16, 11, '#dccea9');
  }
  if (cave) drawCaveHud();
  if (G.building) {
    ctx.globalAlpha = 0.9;

  }

  if(b.phase==='choice'){
    const a=b.pendingChoice,m=a.t==='attack'?MOVES[a.move]:null;
    text(m?'ATTACK: '+m.name:'DEFEND: SHIELD',36,H-91,16,'#22303f');
    const detail=m?(m.cat==='status'?'Changes battle stats. No direct damage.':m.type.toUpperCase()+' | Power '+m.pow+' | Accuracy '+(m.acc>=999?'--':m.acc)+'%'):'Skip attacking; take 20% less damage this turn.';
    text(detail,36,H-67,13,'#52677c');
    text('Z / ENTER / A: confirm     X / B: choose again',36,H-33,13,'#277957');return;
  }

  if (b.phase === 'fight') {
    b.mine.moves.forEach((mid, i) => {
      const mv = MOVES[mid];
      const ox = 40 + (i % 2) * 270;
      const oy = H - 86 + Math.floor(i / 2) * 32;
      if (i === b.cursor) {
        ctx.fillStyle = '#22303f';
        ctx.beginPath();
        ctx.moveTo(ox - 16, oy - 10); ctx.lineTo(ox - 6, oy - 5); ctx.lineTo(ox - 16, oy);
        ctx.closePath(); ctx.fill();
      }
      ctx.fillStyle = TYPE_COLOR[mv.type];
      rr(ox + 168, oy - 11, 58, 15, 4); ctx.fill();
      text(mv.type.toUpperCase().slice(0, 7), ox + 197, oy + 1, 9, '#fff', 'center');
      text(mv.name, ox, oy, 14, '#22303f');
    });
    const cur = MOVES[b.mine.moves[b.cursor]];
    text(cur.cat === 'status' ? 'STATUS' : 'POWER ' + cur.pow, 40, H - 24, 12, '#4a5a6a');
    text('ACC ' + (cur.acc >= 999 ? '--' : cur.acc), 160, H - 24, 12, '#4a5a6a');
    text(promptLabel('cancel') + ' back', W - 40, H - 24, 12, '#6a7a8a', 'right');
    return;
  }

  if (b.phase === 'bag') {
    // The battle BAG: a scrolling list on the left (BBAG_ROWS at a time), the
    // selected item's description on the right.
    const items = battleBagItems();
    text('BAG', 36, H - 101, 11, CUE_COL);
    if (items.length) {
      const cur = Math.max(0, Math.min(b.cursor, items.length - 1));
      const top = listTop(items.length, cur, BBAG_ROWS), end = Math.min(items.length, top + BBAG_ROWS);
      for (let i = top; i < end; i++) {
        const k = items[i], oy = H - 94 + (i - top) * BBAG_ROW_H;
        if (i === cur) {
          ctx.fillStyle = '#e2ecf8'; rr(28, oy - 3, BBAG_SPLIT_X - 40, BBAG_ROW_H - 2, 5); ctx.fill();
          cursorArrow(34, oy + 2);
        }
        text(bagName(k), 50, oy + 12, 13, '#22303f');
        text('x' + (k === 'ball' ? G.balls : (G.bag[k] || 0)), BBAG_SPLIT_X - 30, oy + 12, 13, '#4a5a6a', 'right');
      }
      if (top > 0) scrollCue(BBAG_SPLIT_X - 18, H - 94 + 6, true);
      if (end < items.length) scrollCue(BBAG_SPLIT_X - 18, H - 94 + (BBAG_ROWS - 1) * BBAG_ROW_H + 6, false);
      ctx.fillStyle = '#c8ced6'; ctx.fillRect(BBAG_SPLIT_X, H - 106, 1, 76);
      wrapText(bagDesc(items[cur]), BBAG_SPLIT_X + 14, H - 96, W - 50 - BBAG_SPLIT_X - 14, 15, 11, '#4a5a6a');
    }
    text(promptLabel('cancel') + ' back', W - 40, H - 24, 12, '#6a7a8a', 'right');
    return;
  }

  if (b.phase === 'swap') {
    text(b.forcedSwap ? 'Send out which monster?' : 'Swap to which monster?', 36, H - 92, 14, '#22303f');
    G.party.forEach((m, i) => {
      const ox = 40 + (i % 2) * 280;
      const oy = H - 66 + Math.floor(i / 2) * 22;
      if (i === b.cursor) {
        ctx.fillStyle = '#22303f';
        ctx.beginPath();
        ctx.moveTo(ox - 16, oy - 9); ctx.lineTo(ox - 6, oy - 4); ctx.lineTo(ox - 16, oy);
        ctx.closePath(); ctx.fill();
      }
      const dead = m.hp <= 0, active = m === b.mine;
      const col = dead ? '#a04040' : active ? '#7a8a9a' : '#22303f';
      text(m.name + '  L' + m.level + '  ' + m.hp + '/' + m.maxhp + (active ? ' (out)' : ''),
           ox, oy, 12, col);
    });
    if (!b.forcedSwap) text(promptLabel('cancel') + ' back', W - 40, H - 24, 12, '#6a7a8a', 'right');
  }
}


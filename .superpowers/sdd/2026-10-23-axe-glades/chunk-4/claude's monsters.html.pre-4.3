    for (const [x, y] of frontier) {
      const d = dist.get(x + ',' + y) + 1;
      for (const [dx, dy] of STALKER_DIRS) {
        const nx = x + dx, ny = y + dy, k = nx + ',' + ny;
        if (!dist.has(k) && ok(nx, ny)) { dist.set(k, d); nxt.push([nx, ny]); }
      }
    }
    frontier = nxt;
  }
  return dist;
}

// How far (by path) it smells you: further in the dark and in fear.
function stalkerSense(charge, tension) {
  const top = LANTERN.max, c = clamp(Math.trunc(charge), 0, top);
  const dark = Math.floor((HUNT_AI.senseDark * (top - c) * 2 + top) / (2 * top));   // round half up
  return HUNT_AI.senseBase + dark + Math.floor(clamp(Math.trunc(tension), 0, TENSION.max) / HUNT_AI.senseDiv);
}

function newStalker(x, y, wp) { return { x, y, mode: 'patrol', wp: wp || 0, stun: 0, grace: 0, tick: 0 }; }

// [x, y, waypoint index]: the patrol waypoint furthest (by the player's own
// path) from the player - so it always appears far away.
function stalkerSpawn(player, edits, picked, npcTiles) {
  const d = caveDist(player, edits, picked, npcTiles, true);
  let best = 0, bestD = -1;
  HUNT_AI.patrol.forEach(([x, y], i) => {
    const k = x + ',' + y;
    if (d.has(k) && d.get(k) > bestD && stalkerWalkable(x, y, edits, picked, npcTiles)) { best = i; bestD = d.get(k); }
  });
  const [x, y] = HUNT_AI.patrol[best];
  return [x, y, best];
}

function nearestWp(x, y) {
  let best = 0, bd = Infinity;
  HUNT_AI.patrol.forEach(([wx, wy], i) => {
    const d = Math.abs(wx - x) + Math.abs(wy - y);
    if (d < bd) { bd = d; best = i; }
  });
  return best;
}

// One stalker turn, run once per completed player step. Returns [new state,
// event]; event is null, 'hunt', 'lost', 'retreat' or 'lunge'. Pure: st is
// copied, and rng (a mulberry32) is drawn only on a patrol move.
function stalkerTick(st, player, charge, tension, edits, picked, npcTiles, rng) {
  const s = Object.assign({}, st);
  s.tick = st.tick + 1;
  if (s.grace > 0) s.grace -= 1;
  if (s.stun > 0) { s.stun -= 1; return [s, null]; }
  const [px, py] = player;
  const dist = caveDist(player, edits, picked, npcTiles, false);
  const ko = keepOut(charge, tension), sense = stalkerSense(charge, tension);
  let event = null;
  const hk = s.x + ',' + s.y;
  const dHere = dist.has(hk) ? dist.get(hk) : null;
  if (s.mode === 'hunt') {
    if (dHere === null || dHere > sense + HUNT_AI.loseTrack) { s.mode = 'patrol'; s.wp = nearestWp(s.x, s.y); event = 'lost'; }
  } else if (dHere !== null && dHere <= sense) { s.mode = 'hunt'; event = 'hunt'; }

  const man = ([x, y]) => Math.abs(x - px) + Math.abs(y - py);
  const steps = () => STALKER_DIRS.map(([dx, dy]) => [s.x + dx, s.y + dy])
    .filter(([x, y]) => !(x === px && y === py) && stalkerWalkable(x, y, edits, picked, npcTiles));

  if (man([s.x, s.y]) < ko) {
    // The light pushes it back at once, whatever its pace.
    let best = null;
    for (const n of steps()) if (best === null || man(n) > man(best)) best = n;
    if (best !== null && man(best) > man([s.x, s.y])) { s.x = best[0]; s.y = best[1]; return [s, 'retreat']; }
    return [s, event];
  }

  const [num, den] = s.mode === 'hunt' ? HUNT_AI.paceHunt : HUNT_AI.pacePatrol;
  if (s.tick % den < num) {
    let field = null, cur = null;
    if (s.mode === 'hunt') { field = dist; cur = dHere; }
    else {
      const wp = HUNT_AI.patrol[s.wp];
      if (s.x === wp[0] && s.y === wp[1]) s.wp = (s.wp + 1) % HUNT_AI.patrol.length;
      if (rng() >= HUNT_AI.pause) {
        field = caveDist(HUNT_AI.patrol[s.wp], edits, picked, npcTiles, false);
        cur = field.has(hk) ? field.get(hk) : null;
      }
    }
    if (field !== null && cur !== null) {
      let best = null;
      for (const n of steps()) {
        const k = n[0] + ',' + n[1];
        if (man(n) >= ko && field.has(k) && field.get(k) < cur &&
            (best === null || field.get(k) < field.get(best[0] + ',' + best[1]))) best = n;
      }
      if (best !== null) { s.x = best[0]; s.y = best[1]; }
    }
  }

  if (ko === 1 && man([s.x, s.y]) <= 1 && s.grace === 0 && !inSafeZone(px, py)) return [s, 'lunge'];
  return [s, event];
}

// Walking onto an unstunned stalker is a deliberate fight; a stunned one is
// walked straight past.
function bump(st, tile) { return !!st && st.stun === 0 && st.x === tile[0] && st.y === tile[1]; }

// [new state, hit]: a stalker within PULSE.range by path (never through rock)
// is stunned and shoved up to PULSE.push tiles away.
function pulseApply(st, player, edits, picked, npcTiles) {
  if (!st) return [null, false];
  const d = caveDist(player, edits, picked, npcTiles, true);
  const hk = st.x + ',' + st.y;
  if (!d.has(hk) || d.get(hk) > PULSE.range) return [Object.assign({}, st), false];
  const s = Object.assign({}, st, { stun: PULSE.stun, mode: 'patrol', wp: nearestWp(st.x, st.y) });
  for (let i = 0; i < PULSE.push; i++) {
    const cur = d.get(s.x + ',' + s.y) || 0;
    let best = null, bd = -1;
    for (const [dx, dy] of STALKER_DIRS) {
      const nx = s.x + dx, ny = s.y + dy, k = nx + ',' + ny;
      if (stalkerWalkable(nx, ny, edits, picked, npcTiles) && d.has(k) && d.get(k) > cur &&
          (best === null || d.get(k) > bd)) { best = [nx, ny]; bd = d.get(k); }
    }
    if (best === null) break;
    s.x = best[0]; s.y = best[1];
  }
  return [s, true];
}

function zeroMaterials() {
  const m = {};
  for (const k of MATERIALS) m[k] = 0;
  return m;
}

/* ====================== LAYER 3: STATE ====================== */

const SAVE_KEY = 'monster-trail-save-v1';
const Campaign = globalThis.MonsterCampaign || null;
const CombatCommands = globalThis.MonsterCommands || null;
let campaignHost = null, campaignBusy = false;
let battlePresenter = null, battleFocused = true, actionSerial = 0;
let combatModal = false, battleHost = null, lastBattleFrameAt = 0;
let webcam = null, webcamPauseGen = 0;   // webcam battle controls (combat/webcam.js); the counter drops gestures that straddle a pause

const G = {
  mode: 'title',           // title | overworld | dialogue | menu | craft | bag | shop | party | battle | starter | victory
  prev: null,
  player: { tx: START_TILE[0], ty: START_TILE[1], px: START_TILE[0] * 32,
            py: START_TILE[1] * 32, dir: 'up', moving: false, t: 0, from: null, hop: 0 },
  party: [],
  chapter: null,
  settings: CombatCommands ? CombatCommands.normalizeSettings({}) : { actionMode:'ON', quality:'STANDARD', reducedMotion:false, basicMode:false },
  balls: 20,
  bag: {},                 // GOODS id -> count (loot and battle items)
  coins: START_COINS,
  battles: 0,              // every startBattle; feeds lootSeed
  flags: { starter: false, gym: false, huntBeaten: 0, gymBonus: false, axe: 0 },
  picked: new Set(),       // item-ball tiles already collected, as 'x,y'
  edits: {},               // sandbox overlay { 'x,y': glyph }; MAP is never mutated
  materials: zeroMaterials(),
  building: false,         // overworld sub-state: confirm places a WALL
  // DARK CAVE horror kit. Counters like balls; the stalker itself is transient
  // (never saved) and respawns far away on entry or load.
  lantern: LANTERN.max,
  tension: 0,
  pulses: 0,
  huntRest: 0,             // cave steps until the stalker returns
  huntGone: false,         // beaten: gone until the next healParty
  stalker: null,           // { x, y, mode, wp, stun, grace, tick } or null
  caveIn: false,           // was the last settled tile inside CAVE_BAND?
  caveRng: mulberry32(0),
  craftCursor: 0,
  craftMsg: '',
  bagCursor: 0,            // BAG screen: index into bagEntries
  bagPick: null,           // BAG screen: the POTION being used, while the party picker is open
  bagPickCursor: 0,
  bagMsg: '',
  shop: null,              // CENTRE shop: { page offer|main|buy|sell, cursor, qty, msg }
  lastCentre: START_TILE.slice(),
  wanderT: 0,
  beaten: {},
  steps: 0,
  dialogue: null,          // { lines, i, onDone }
  menu: null,
  battle: null,
  newGameConfirm: false,
  starterCursor: 0,
  time: 0,
  fade: 0,                 // 0 = clear, 1 = black
  fadeDir: 0,
  pendingEncounter: null,
  toast: null
};

function npcById(id) { return NPCS.find(n => n.id === id); }

function partyAlive() { return G.party.some(m => m.hp > 0); }
function firstAlive() { return G.party.find(m => m.hp > 0) || null; }

// Heal everyone; returns the safety-net BALLs given (callers own the nurse line).
function healParty() {
  for (const m of G.party) { m.hp = m.maxhp; }
  const n = ballSafetyNet(G.balls, G.coins);
  G.balls += n;
  G.lantern = LANTERN.max;           // the centre refills the lantern...
  G.tension = 0;                     // ...steadies your nerve...
  G.huntGone = false;                // ...and the beaten stalker returns
  return n;
}

function say(lines, onDone) {
  G.dialogue = { lines: Array.isArray(lines) ? lines : [lines], i: 0, onDone: onDone || null };
  G.prev = G.mode === 'dialogue' ? G.prev : G.mode;
  G.mode = 'dialogue';
}

function advanceDialogue() {
  const d = G.dialogue;
  if (!d) return;
  d.i++;
  if (d.i >= d.lines.length) {
    G.dialogue = null;
    G.mode = G.prev || 'overworld';
    if (d.onDone) d.onDone();
  }
}

// The tile as the player sees it: MAP under the sandbox overlay.
function tileHere(x, y) { return tileAt(x, y, G.edits); }

function npcTiles() { return new Set(NPCS.map(n => n.x + ',' + n.y)); }

// Ledges are the one conditional tile: passable only downward, which makes
// them shortcuts on the way home and walls on the way up. Mined boulders
// and built walls come from the overlay.
function blockedFor(x, y, moving) {
  return tileBlocked(x, y, moving || 'none', G.edits, G.picked, npcTiles());
}

function facingTile(p) {
  const d = { up: [0, -1], down: [0, 1], left: [-1, 0], right: [1, 0] }[p.dir];
  return [p.tx + d[0], p.ty + d[1]];
}

function startBattle(foe, opts) {
  const mine = firstAlive();
  if (!mine) return;
  G.battle = {
    mine, foe,
    arena: 'meadow', condition: 'clear', scene: null,   // rolled below; never saved
    command: null, commandInput: {}, action: null, actionFeedback: null,
    hiddenMine:!(opts&&opts.hunt),hiddenFoe:!(opts&&opts.hunt),
    trainer: opts && opts.trainer ? opts.trainer : null,
    teamIdx: 0,
    stagesMine: {}, stagesFoe: {},
    phase: 'intro',          // intro | menu | fight | bag | swap | anim | over
    cursor: 0,
    queue: [],
    step: null,
    waitKey: false,
    timer: 0,
    dispMine: mine.hp, dispFoe: foe.hp,
    // Cosmetic juice state (shell only - never read by battle logic):
    // trauma -> shake, freeze -> hit-stop, animT -> sprite idle clock.
    trauma: 0, freeze: 0, flashSide: null, flashT: 0, animT: 0,
    ballAnim: null,
    result: null,
    ran: false,
    hunt: !!(opts && opts.hunt),   // the DARK CAVE's forced hunt: no BALL, fixed RUN odds
    // Jumpscare intro phase: 'dark' (foe hidden) -> 'reveal' -> null.
    // Cosmetic only; the shell reads it, battle logic never does.
    scare: null, scareT: 0, scareFlash: 0,
    huntPaid: false,               // endBattle has run huntOver for this fight
    fishing: !!(opts && opts.fishing),   // hooked by fishing: loot uses the FISHING row
    rewardPaid: false,             // endBattle has queued this fight's coins/loot
    lootSeed: 0                    // fixed below; never saved
  };
  G.mode = 'battle';
  const b = G.battle;
  // The battle's condition and scene: own mulberry32 seeds, never Math.random.
  {
    const fishing = !!(opts && opts.fishing), px = G.player.tx, py = G.player.ty;
    const seed = conditionSeed(G.steps, px, py), region = regionName(py);
    G.battles = Math.min(G.battles + 1, COUNT_MAX);
    b.lootSeed = lootSeed(G.steps, px, py, foe.level, G.battles);
    b.condition = forceCondition !== null ? forceCondition
      : battleCondition(fishing ? 'FISHING' : region, b.trainer, b.hunt, seed);
    b.arena = arenaKind(region, tileHere(px, py), fishing, b.hunt, inSandbox(px, py));
    b.scene = forceScene ? { ...forceScene } : battleScene(b.condition, b.arena, seed);
  }
  clearParticles();
  if(!b.hunt){eventAction(b,'sendout','foe');eventAction(b,'sendout','mine');}
  if (b.trainer) {
    qMsg(b, b.trainer.name + ': ' + b.trainer.intro);
    qMsg(b, b.trainer.name + ' sent out ' + foe.name + '!');
  } else if (b.hunt) {
    queueScare(b);
  } else {
    qMsg(b, 'A wild ' + foe.name + ' appeared!');
  }
  if (CONDITIONS[b.condition].msg) qMsg(b, CONDITIONS[b.condition].msg);
  qMsg(b, 'Go, ' + mine.name + '!');
  qDo(b, () => { b.phase = 'menu'; b.cursor = 0; });
  b.phase = 'anim';
}

/* The hunt's jumpscare intro, entirely through the step queue. The foe starts
   hidden; the reveal fires juiceScare once (one flash, never a strobe). Under
   reduced motion a held dark frame replaces the flash/shake/lunge - the text
   and the sound are the same either way. */
let SCARE_CALM = null;             // test seam: null follows REDUCED_MOTION
function scareCalm() { return SCARE_CALM === null ? REDUCED_MOTION : SCARE_CALM; }
function setScareCalm(v) { SCARE_CALM = v === null ? null : !!v; }

function queueScare(b) {
  const calm = scareCalm();
  b.scare = 'dark'; b.scareT = 0;
  qDo(b, () => sfx('scare'));
  if (calm) qWait(b, 0.4);
  qMsg(b, 'Something was breathing right behind you...');
  qDo(b, () => { b.scare = 'reveal'; b.scareT = 0; juiceScare(b, calm); });
  qMsg(b, b.foe.name + ' lunged out of the dark!');
  qMsg(b, "It's hunting you. There's no time to aim a BALL!");
  qDo(b, () => { b.scare = null; });
}

// The overworld's handoff into a hunt battle: a hard cut, or the normal fade
// under reduced motion. Also the tests' direct seam.
function startHunt(foe) {
  if (scareCalm()) startFade(() => startBattle(foe, { hunt: true }));
  else startBattle(foe, { hunt: true });
}

// Called once by endBattle when a hunt battle ends, with 'win', 'run' or
// 'lose', before the fade out. Pays the reward through the queue (step 1).
function huntOver(b, result) {
  if (result === 'win') {
    const n = huntCount(G.flags.huntBeaten);
    const reward = n === 0 ? HUNT.rewardFirst : HUNT.rewardRepeat;
    G.flags.huntBeaten = n + 1;
    for (const k of Object.keys(reward)) {
      G.materials[k] = (G.materials[k] || 0) + reward[k];
      qMsg(b, 'It left ' + reward[k] + ' ' + (MATERIAL_LABEL[k] || k.toUpperCase()) + ' behind in the dark.');
    }
  }
  // Overworld consequences: the stalker leaves the cave for now. A loss rests
  // it longer than any walk out of the cave (restLose > 67).
  G.stalker = null;
  G.tension = 0;
  if (result === 'win') G.huntGone = true;               // until healParty
  else if (result === 'run') G.huntRest = HUNT_AI.restRun;
  else { G.huntRest = HUNT_AI.restLose; payBlackout(b); } // the whiteout follows; a blackout is a blackout
}

// Lose a quarter of the coins (rounded down), narrated if any.
function payBlackout(b) {
  if (forceNoLoot) return;
  const left = blackoutCoins(G.coins);
  if (left < G.coins) qMsg(b, 'You dropped ' + (G.coins - left) + ' coins...');
  G.coins = left;
}

// The end of a non-hunt battle: coins and loot, all through the queue.
function payRewards(b, result) {
  if (forceNoLoot) return;
  if (result === 'lose') { payBlackout(b); return; }
  if (result !== 'win' && result !== 'caught') return;
  if (result === 'win') {
    const top = b.trainer ? Math.max(...b.trainer.team.map(([, lv]) => lv)) : null;
    const isGym = !!b.trainer && b.trainer.id === 'gym';
    const n = coinReward(b.foe.level, top, isGym, !!G.flags.gymBonus);
    G.coins = addCoins(G.coins, n);
    qMsg(b, 'You got ' + n + ' coins!');
    if (isGym) G.flags.gymBonus = true;
  }
  const region = b.fishing ? 'FISHING' : regionName(G.player.ty);
  const item = lootRoll(region, SPECIES[b.foe.id].types, result === 'caught', b.trainer, b.hunt, b.lootSeed);
  if (item) {
    const name = GOODS[item].name;
    qMsg(b, result === 'caught' ? b.foe.name + ' was holding a ' + name + '!'
                                : 'The wild ' + b.foe.name + ' dropped a ' + name + '!');
    if ((G.bag[item] || 0) >= BAG_MAX) qMsg(b, '...but your bag is full.');
    else G.bag = bagAdd(G.bag, item, 1);
  }
}

// The battle BAG list: usable items you own, in a fixed order.
function battleBagItems() {
  return (G.balls > 0 ? ['ball'] : []).concat(BATTLE_BAG.filter(k => (G.bag[k] || 0) > 0));
}

/* --- battle step queue -------------------------------------------------- */
function qMsg(b, s) { b.queue.push({ t: 'msg', s }); }
function qDo(b, fn) { b.queue.push({ t: 'do', fn }); }
function qWait(b, ms) { b.queue.push({ t: 'wait', ms }); }
function qHp(b) { b.queue.push({ t: 'hp' }); }
function qCommand(b, kind, onDone) {
  if (!CombatCommands) { qDo(b, () => onDone({tier:'OK',damageScale:1,critBonus:0,throwScale:1})); return; }
  b.queue.push({ t:'cmd', kind, onDone });
}
function qAction(b, action, onContact) { b.queue.push({t:'action', action:{...action,id:++actionSerial,elapsed:0}, onContact, contacted:false}); }
function commandClock() {
  const b=G.battle;if(!b||!b.command)return 0;
  const fractional=typeof performance!=='undefined' && lastBattleFrameAt ? Math.max(0,Math.min(.05,(performance.now()-lastBattleFrameAt)/1000))*.55 : 0;
  return b.command.elapsed+fractional;
}
function normalizeCombatSettings(v) { return CombatCommands ? CombatCommands.normalizeSettings(v) : v; }
// The camera may stream only here: in a battle, focused, not mid-descent, with the setting ON.
function webcamActive() { return !campaignBusy && G.mode === 'battle' && !!G.battle && battleFocused && G.settings.webcam === 'ON'; }
// Everything the webcam controller may touch: the same seams keyboard and touch use.
function webcamOptions() {
  return {
    getSettings: () => G.settings, setSettings: v => { G.settings = normalizeCombatSettings(v); saveGame(); },
    getCommand: () => (G.battle && G.battle.command) || null, commandClock, pauseGeneration: () => webcamPauseGen,
    isInputOpen: () => !combatModal && battleFocused, press, release, commandInput,
  };
}
const WEBCAM_MESSAGES = { denied: 'Camera blocked: keyboard and touch still work.', ended: 'Camera disconnected: keyboard and touch still work.', unavailable: 'Webcam: not available in this browser.' };
function commandInput(pressed, released, at) {
  const b=G.battle;
  if (!b || !b.command || !battleFocused) return;
  if(!b.command.ready){if(pressed){b.command.ready=true;b.command.waitingRelease=true;b.commandInput={};}return;}
  if(b.command.waitingRelease){if(released)b.command.waitingRelease=false;return;}
  const pending=b.commandInput,eventAt=Number.isFinite(at)?at:commandClock();
  if(pressed){pending.pressed=true;pending.pressAt=eventAt;}
  if(released){pending.released=true;pending.releaseAt=eventAt;}
  pending.at=b.command.kind==='charge'||b.command.kind==='catch'?(pending.releaseAt??pending.pressAt):pending.pressAt;
}
function openCombatSettings() { if(battleHost)battleHost.openSettings(); }
function battleSnapshot() {
  const b=G.battle;if(!b)return null;
  return {mine:{...b.mine,id:b.visualMineId||b.mine.id,visible:!b.hiddenMine},foe:{...b.foe,visible:!b.hiddenFoe&&b.scare!=='dark'},arena:b.hunt?'cave':b.arena,scene:b.scene,condition:b.condition,hunt:b.hunt,scare:b.scare,action:b.action,command:b.command};
}
function battleArenaKind() {
  return arenaKind(regionName(G.player.ty), tileHere(G.player.tx,G.player.ty), false, false, inSandbox(G.player.tx,G.player.ty));
}
function actionRecipe(moveId) {
  if (globalThis.MonsterRecipes) return globalThis.MonsterRecipes.recipeFor(moveId);
  return {duration:.8,contactAt:.45};
}
function eventAction(b,kind,actor='mine',extra={}) {
  if(kind==='sendout')qDo(b,()=>{b[actor==='mine'?'hiddenMine':'hiddenFoe']=false;});
  qAction(b,{kind,actor,target:actor,moveId:null,duration:kind==='evolve'?1.6:.65,contactAt:.32,...extra},()=>{});
}

function pumpQueue(b, dt) {
  if (b.step) {
    if (b.step.t === 'msg') return;                      // waits for a key
    if (b.step.t === 'cmd') {
      if (!battleFocused) return;
      if(!b.command.ready||b.command.waitingRelease)return;
      b.command=CombatCommands.stepCommand(b.command,dt*.55,b.commandInput);
      b.commandInput={};
      if (!b.command.done) return;
      const result=b.command.result, callback=b.step.onDone;
      b.actionFeedback={...result,age:0}; b.command=null; b.step=null;
      const rest=b.queue;b.queue=[];callback(result);b.queue=b.queue.concat(rest);
    } else if (b.step.t === 'action') {
      if (!battleFocused) return;
      const s=b.step,a=s.action;a.elapsed=Math.min(a.duration,a.elapsed+Math.max(0,dt));b.action=a;
      if (!s.contacted && a.elapsed+1e-10>=a.contactAt) {s.contacted=true;if(s.onContact)s.onContact();}
      if (a.elapsed+1e-10<a.duration) return;
      if (!s.contacted && s.onContact) s.onContact();
      b.action=null;b.step=null;
    } else if (b.step.t === 'wait') {
      b.timer -= dt;
      if (b.timer > 0) return;
      b.step = null;
    } else if (b.step.t === 'hp') {
      const settled = Math.abs(b.dispMine - b.mine.hp) < 0.5 &&
                      Math.abs(b.dispFoe - b.foe.hp) < 0.5;
      if (!settled) return;
      b.dispMine = b.mine.hp; b.dispFoe = b.foe.hp;
      b.step = null;
    }
  }
  while (!b.step && b.queue.length) {
    const s = b.queue.shift();
    if (s.t === 'do') {
      // Steps queued from inside fn() must run *here*, not after everything
      // already pending, so swap in an empty queue and splice the result in.
      const rest = b.queue;
      b.queue = [];
      s.fn();
      b.queue = b.queue.concat(rest);
      continue;
    }
    b.step = s;
    if (s.t === 'cmd') {
      const context=b.hunt?'hunt':b.trainer && b.teamIdx===b.trainer.team.length-1?'ace':'normal';
      b.command=CombatCommands.createCommand(s.kind,G.settings.actionMode,context);b.command.ready=false;b.commandInput={};return;
    }
    if (s.t === 'action') { b.action=s.action; if(battlePresenter)battlePresenter.play(s.action); return; }
    if (s.t === 'wait') b.timer = s.ms;
    if (s.t === 'msg') { sfx('text'); return; }
  }
}

function effWord(eff) {
  if (eff === 0) return 'It had no effect...';
  if (eff >= 2) return "It's super effective!";
  if (eff < 1) return "It's not very effective...";
  return null;
}

function statName(k) {
  return { atk: 'ATTACK', def: 'DEFENSE', spa: 'SP.ATK', spd: 'SP.DEF', spe: 'SPEED' }[k];
}

function applyMove(b, attackerIsMine, moveId) {
  const atk = attackerIsMine ? b.mine : b.foe;
  const def = attackerIsMine ? b.foe : b.mine;
  const aStg = attackerIsMine ? b.stagesMine : b.stagesFoe;
  const dStg = attackerIsMine ? b.stagesFoe : b.stagesMine;
  const mv = MOVES[moveId];

  qDo(b, () => {
    if (atk.hp <= 0) return;
    const label = (attackerIsMine ? '' : 'Foe ') + atk.name;
    const resolve = timing => {
      if(!attackerIsMine&&b.defending)timing={...timing,damageScale:Math.min(timing.damageScale,.8),tier:timing.tier==='PERFECT'?'PERFECT':'GUARD'};
      qMsg(b, label + ' used ' + mv.name + '!');
      const res = damageCalc(atk, def, moveId, aStg, dStg, Math.random, timing.damageScale, timing.critBonus, b.condition);
      const recipe=actionRecipe(moveId), actor=attackerIsMine?'mine':'foe', other=attackerIsMine?'foe':'mine';
      const pace=CombatCommands?1.6:1;
      const action={moveId,actor,target:mv.eff && mv.eff.target==='self'?actor:other,result:res,duration:recipe.duration*pace,contactAt:recipe.contactAt*pace};
      if(!attackerIsMine&&['GUARD','PERFECT'].includes(timing.tier))action.guardTier=timing.tier;
      if (res.missed) {
        qAction(b,action,()=>{}); qMsg(b,label+"'s attack missed!"); return;
      }
      if (mv.cat === 'status') {
        const e=mv.eff,store=e.target==='self'?aStg:dStg,before=store[e.stat]||0,after=clamp(before+e.stages,-6,6);
        const tName=e.target==='self'?label:(attackerIsMine?'Foe '+def.name:def.name);
        action.result={...res,capped:after===before,status:true};
        qAction(b,action,()=>{store[e.stat]=after;sfx(e.stages>0?'buff':'debuff');});
        if(after===before)qMsg(b,tName+"'s "+statName(e.stat)+" won't go "+(e.stages>0?'higher':'lower')+'!');
        else qMsg(b,tName+"'s "+statName(e.stat)+(Math.abs(e.stages)>=2?' sharply':'')+' '+(e.stages>0?'rose':'fell')+'!');
        return;
      }
      qAction(b,action,()=>{
        def.hp=Math.max(0,def.hp-res.dmg);
        juiceHit(b,other,res.eff,res.crit,mv.type);
        if(res.eff!==0)sfx(res.eff>=2?'hitStrong':res.eff<1?'hitWeak':'hit');
      });
      qHp(b);if(res.crit)qMsg(b,'A critical hit!');const word=effWord(res.eff);if(word)qMsg(b,word);
    };
    if (mv.cat==='status') resolve({damageScale:1,critBonus:0});
    else qCommand(b,attackerIsMine?(mv.cat==='phys'?'strike':'charge'):'guard',resolve);
  });
}

function faintCheck(b) {
  qDo(b, () => {
    if (b.foe.hp <= 0) {
      eventAction(b,'faint','foe');qDo(b,()=>{b.hiddenFoe=true;});
      qDo(b, () => sfx('faint'));
      qMsg(b, (b.trainer ? 'Foe ' : 'Wild ') + b.foe.name + ' fainted!');
      const amount = xpFromFaint(b.foe);
      const learner = b.mine;
      if (learner.hp > 0) {
        qMsg(b, learner.name + ' gained ' + amount + ' EXP!');
        qDo(b, () => {
          const evs = gainXp(learner, amount);
          for (const ev of evs) {
            if (ev.t === 'level') {
              qDo(b, () => { sfx('level'); b.dispMine = learner.hp; });eventAction(b,'level','mine');
              qMsg(b, learner.name + ' grew to LV ' + ev.level + '!');
            } else if (ev.t === 'move') {
              qMsg(b, learner.name + ' learned ' + MOVES[ev.move].name + '!');
            } else if (ev.t === 'swap') {
              qMsg(b, learner.name + ' forgot ' + MOVES[ev.dropped].name + '...');
              qMsg(b, '...and learned ' + MOVES[ev.move].name + '!');
            } else if (ev.t === 'evolve') {
              const oldId=Object.keys(SPECIES).find(id=>SPECIES[id].name===ev.from),newId=learner.id;
              b.visualMineId=oldId;
              qDo(b, () => sfx('evolve'));
              qMsg(b, 'What? ' + ev.from + ' is evolving!');
              eventAction(b,'evolve','mine',{into:newId});qDo(b,()=>{b.visualMineId=null;});
              qMsg(b, ev.from + ' evolved into ' + ev.into + '!');
            }
          }
        });
      }
      if (b.trainer) {
        qDo(b, () => {
          b.teamIdx++;
          if (b.teamIdx < b.trainer.team.length) {
            const [sid, lvl] = b.trainer.team[b.teamIdx];
            b.foe = makeMon(sid, lvl);
            b.hiddenFoe=true;
            b.dispFoe = b.foe.hp;
            b.stagesFoe = {};
            qMsg(b, b.trainer.name + ' sent out ' + b.foe.name + '!');
            eventAction(b,'sendout','foe');
            qDo(b, () => { b.phase = 'menu'; b.cursor = 0; });
          } else {
            qMsg(b, b.trainer.name + ': ' + b.trainer.defeat);
            qDo(b, () => endBattle(b, 'win'));
          }
        });
      } else {
        qDo(b, () => endBattle(b, 'win'));
      }
      return;
    }

    if (b.mine.hp <= 0) {
      eventAction(b,'faint','mine');qDo(b,()=>{b.hiddenMine=true;});
      qDo(b, () => sfx('faint'));
      qMsg(b, b.mine.name + ' fainted!');
      qDo(b, () => {
        if (partyAlive()) {
          b.phase = 'swap';
          b.cursor = 0;
          b.forcedSwap = true;
        } else {
          qMsg(b, 'You have no monsters left...');
          qDo(b, () => endBattle(b, 'lose'));
        }
      });
      return;
    }

    qDo(b, () => { b.phase = 'menu'; b.cursor = 0; });
  });
}

function takeTurn(b, playerAction) {
  b.phase = 'anim';
  const foeMoveId = b.foe.moves[Math.floor(Math.random() * b.foe.moves.length)];

  if(playerAction.t==='defend'){
    b.defending=true;qMsg(b,b.mine.name+' braces behind a shield!');
    applyMove(b,false,foeMoveId);qHp(b);qDo(b,()=>{b.defending=false;});faintCheck(b);return;
  }

  if (playerAction.t === 'run') {
    if (b.trainer) {
      qMsg(b, "You can't run from a trainer battle!");
      qDo(b, () => { b.phase = 'menu'; b.cursor = 0; });
      return;
    }
    const odds = b.hunt ? HUNT.runOdds
               : clamp(0.35 + (b.mine.spe - b.foe.spe) * 0.02, 0.2, 0.95);
    if (Math.random() < odds) {
      eventAction(b,'escape','mine');
      qDo(b, () => sfx('run'));
      qMsg(b, b.hunt ? 'You bolted into the dark... it lost your scent. For now.' : 'Got away safely!');
      qDo(b, () => endBattle(b, 'run'));
    } else {
      qMsg(b, b.hunt ? 'It cut you off!' : "Couldn't get away!");
      applyMove(b, false, foeMoveId);
      qHp(b);
      faintCheck(b);
    }
    return;
  }

  if (playerAction.t === 'ball') {
    if (b.trainer) {
      qMsg(b, "You can't catch another trainer's monster!");
      qDo(b, () => { b.phase = 'menu'; b.cursor = 0; });
      return;
    }
    if (b.hunt) {
      // Refused before the throw: no BALL spent and no turn used.
      qMsg(b, 'It melts into the dark before the BALL can land!');
      qDo(b, () => { b.phase = 'menu'; b.cursor = 0; });
      return;
    }
    const great = playerAction.item === 'greatball';
    if ((great ? (G.bag.greatball || 0) : G.balls) <= 0) {
      // Defensive: the BAG list never offers what you don't own.
      qMsg(b, 'You have no balls left!');
      qDo(b, () => { b.phase = 'menu'; b.cursor = 0; });
      return;
    }
    qCommand(b,'catch',timing=>{
      const roll=(catchRollImpl||catchRoll)(b.foe,1.5*(great?GOODS.greatball.bonus:1),Math.random,timing.throwScale);
      qMsg(b,great?'You threw a GREAT BALL!':'You threw a BALL!');
      qDo(b,()=>{if(great)G.bag=bagAdd(G.bag,'greatball',-1);else G.balls--;sfx('throw');b.ballAnim={t:0,shakes:roll.shakes,caught:roll.caught};});
      const ballItem=great?'greatball':'ball';   // the 3D presenter tints a GREAT BALL blue
      eventAction(b,'throw','mine',{target:'foe',duration:1.1,contactAt:.65,result:roll,item:ballItem});
      qDo(b,()=>{b.hiddenFoe=true;});
      eventAction(b,'catch','mine',{target:'foe',duration:.6+.45*roll.shakes,contactAt:.5,result:roll,item:ballItem});
      if(roll.caught){
        qDo(b,()=>sfx('catch'));qMsg(b,'Gotcha! '+b.foe.name+' was caught!');
        qDo(b,()=>{if(G.party.length<6){G.party.push(b.foe);qMsg(b,b.foe.name+' joined your team.');}else qMsg(b,'Your team is full — '+b.foe.name+' was released.');qDo(b,()=>endBattle(b,'caught'));});
      }else{
        qDo(b,()=>{b.hiddenFoe=false;b.ballAnim=null;});eventAction(b,'sendout','foe');
        qMsg(b,roll.shakes===0?'Oh no! It broke free instantly!':roll.shakes>=3?'Argh! So close!':'It broke free!');
        applyMove(b,false,foeMoveId);qHp(b);faintCheck(b);
      }
    });
    return;
  }

  if (playerAction.t === 'item') {
    const item = playerAction.item, toMenu = () => { b.phase = 'menu'; b.cursor = 0; };
    if (!Object.prototype.hasOwnProperty.call(GOODS, item) || !((G.bag[item] || 0) > 0)) { qDo(b, toMenu); return; }
    const good = GOODS[item];
    if (good.kind === 'escape') {
      if (b.trainer || b.hunt) { qMsg(b, "The smoke won't help here!"); qDo(b, toMenu); return; }
      G.bag = bagAdd(G.bag, item, -1);
      eventAction(b, 'escape', 'mine');
      qDo(b, () => sfx('run'));
      qMsg(b, 'You vanished in a puff of smoke!');
      qDo(b, () => endBattle(b, 'run'));
      return;
    }
    if (good.kind === 'heal') {
      const mon = b.mine;
      if (mon.hp >= mon.maxhp) { qMsg(b, "It won't have any effect."); qDo(b, toMenu); return; }
      G.bag = bagAdd(G.bag, item, -1);
      const n = Math.min(good.heal, mon.maxhp - mon.hp);
      mon.hp += n;
      // The 3D heal glow (kind 'heal' on the active monster) is queued from inside this
      // step, so it splices in right here: glow, then the message.
      qDo(b, () => { sfx('heal'); eventAction(b, 'heal', 'mine'); });
      qMsg(b, mon.name + ' recovered ' + n + ' HP!');
      qHp(b);
      applyMove(b, false, foeMoveId);
      qHp(b);
      faintCheck(b);
      return;
    }
    qDo(b, toMenu);
    return;
  }

  if (playerAction.t === 'swap') {
    const target = G.party[playerAction.index];
    qMsg(b, 'Come back, ' + b.mine.name + '!');
    eventAction(b,'swap','mine');
    qDo(b, () => {
      b.mine = target;
      b.hiddenMine=true;
      b.dispMine = target.hp;
      b.stagesMine = {};
    });
    qMsg(b, 'Go, ' + target.name + '!');
    eventAction(b,'sendout','mine');
    applyMove(b, false, foeMoveId);
    qHp(b);
    faintCheck(b);
    return;
  }

  // Both sides attack; order by priority then speed.
  const myMove = MOVES[playerAction.move];
  const foeMove = MOVES[foeMoveId];
  const myPrio = myMove.prio || 0, foePrio = foeMove.prio || 0;
  const mySpe = b.mine.spe * stageMul(b.stagesMine.spe || 0);
  const foeSpe = b.foe.spe * stageMul(b.stagesFoe.spe || 0);
  const meFirst = myPrio !== foePrio ? myPrio > foePrio
                : mySpe !== foeSpe ? mySpe > foeSpe
                : Math.random() < 0.5;

  const first = () => applyMove(b, meFirst, meFirst ? playerAction.move : foeMoveId);
  const second = () => applyMove(b, !meFirst, meFirst ? foeMoveId : playerAction.move);

  first(); qHp(b);
  qDo(b, () => {
    if (b.mine.hp > 0 && b.foe.hp > 0) { second(); qHp(b); }
  });
  faintCheck(b);
}

function endBattle(b, result) {
  if (b.hunt && !b.huntPaid) {
    // Narrate the hunt's outcome first, then come back here to fade.
    b.huntPaid = true;
    huntOver(b, result);
    qDo(b, () => endBattle(b, result));
    return;
  }
  if (!b.hunt && !b.rewardPaid) {
    // Same re-entry for coins and loot: queue them, then come back to fade.
    b.rewardPaid = true;
    payRewards(b, result);
    qDo(b, () => endBattle(b, result));
    return;
  }
  b.result = result;
  b.phase = 'over';
  if (!b.hunt) {
    if (G.stalker) G.stalker.grace = HUNT_AI.grace;     // no hunt straight after a fight
    if (inCave(G.player.ty) && (result === 'win' || result === 'run')) G.tension = tensionEvent(G.tension, result);
  }
  if (b.trainer && result === 'win') {
    G.beaten[b.trainer.id] = true;
    if (b.trainer.id === 'gym') G.flags.gym = true;
  }
  startFade(() => {
    G.battle = null;
    if (result === 'lose') {
      G.mode = 'overworld';
      const gift = healParty();
      G.player.tx = G.lastCentre[0]; G.player.ty = G.lastCentre[1];
      G.player.px = G.lastCentre[0] * 32; G.player.py = G.lastCentre[1] * 32;
      G.player.dir = 'up'; G.player.moving = false;
      syncCave();
      say(['You scrambled back to the CENTRE...', 'Your team was patched up, good as new.'].concat(gift ? [NURSE_GIFT] : []));
    } else if (b.trainer && b.trainer.id === 'gym' && result === 'win') {
      G.mode = 'victory';
    } else {
      G.mode = 'overworld';
    }
  });
}

function startFade(onBlack) {
  G.fadeDir = 1;
  G.fadeCb = onBlack;
}

function tryEncounter() {
  const p = G.player;
  if (!GRASS.includes(tileAt(p.tx, p.ty))) return;
  if (!partyAlive()) return;
  const z = zoneAt(p.tx, p.ty);
  if (!z) return;
  // Same single Math.random() call as ever; only the threshold moves.
  if (Math.random() > encounterRate(inCave(p.ty) ? G.tension : 0)) return;
  const sid = pickWeighted(z.pool, Math.random);
  const lvl = z.min + Math.floor(Math.random() * (z.max - z.min + 1));
  G.pendingEncounter = makeMon(sid, lvl);
  sfx('encounter');
  startFade(() => {
    const foe = G.pendingEncounter;
    G.pendingEncounter = null;
    startBattle(foe, {});
  });
}

/* --- the DARK CAVE: lantern, tension, the stalker, the PULSE ----------- */
// Settle cave entry/exit after any move, teleport or load: leaving removes the
// stalker and the tension; entering reseeds its rng and spawns it far away
// (unless it is resting or beaten).
function syncCave() {
  const p = G.player;
  if (!inCave(p.ty)) {
    if (G.caveIn) G.tension = 0;
    G.caveIn = false;
    G.stalker = null;
    return;
  }
  if (!G.caveIn) {
    G.caveIn = true;
    G.caveRng = mulberry32(G.steps);
    spawnStalker();
  }
}

function spawnStalker() {
  const p = G.player;
  if (G.huntGone || G.huntRest > 0 || !inCave(p.ty)) { G.stalker = null; return; }
  const [x, y, wp] = stalkerSpawn([p.tx, p.ty], G.edits, G.picked, npcTiles());
  G.stalker = newStalker(x, y, wp);
}

// Per completed step: the lantern drains, tension moves, a resting stalker
// counts down (cave steps only) and returns far away.
function caveStep() {
  const p = G.player;
  syncCave();
  if (!inCave(p.ty)) return;
  G.lantern = lanternStep(G.lantern, true);
  const hunted = !!G.stalker && G.stalker.mode === 'hunt';
  G.tension = tensionStep(G.tension, G.lantern, hunted, inSafeZone(p.tx, p.ty));
  if (G.huntRest > 0) {
    G.huntRest -= 1;
    if (G.huntRest === 0) spawnStalker();
  }
}

// The stalker's move for this step. True if it lunged into a fight (a carried
// PULSE fires by reflex instead).
function stalkerTurn() {
  const st = G.stalker;
  if (!st || G.mode !== 'overworld' || G.fadeDir !== 0) return false;
  const p = G.player;
  const [next, ev] = stalkerTick(st, [p.tx, p.ty], G.lantern, G.tension, G.edits, G.picked, npcTiles(), G.caveRng);
  G.stalker = next;
  if (ev !== 'lunge' || !partyAlive()) return false;
  if (G.pulses > 0) { firePulse(true); return false; }
  beginHunt();
  return true;
}

// Contact: stop, then hand off to the hunt battle (startHunt picks the hard
// cut or, under reduced motion, the fade).
function beginHunt() {
  const st = G.stalker;
  G.player.moving = false;
  sfx('hunt');
  if (st) worldFx('lunge', st.x, st.y, null, {});
  startHunt(makeMon(HUNT.species, huntLevel(G.party.map(m => m.level))));
}

// Spend a PULSE: stuns and shoves a stalker in reach; spent even when nothing
// is there. Returns true if a charge was used.
function firePulse(auto) {
  if (G.pulses <= 0) {
    sfx('cancel');
    G.toast = { s: 'No PULSE. Craft one from ORE.', t: 2.5 };
    return false;
  }
  const p = G.player;
  G.pulses -= 1;
  G.tension = tensionEvent(G.tension, 'pulse');
  const [next, hit] = pulseApply(G.stalker, [p.tx, p.ty], G.edits, G.picked, npcTiles());
  G.stalker = next;
  sfx('pulse');
  worldFx('pulse', p.tx, p.ty, null, { hit, auto: !!auto });
  if (auto) G.toast = { s: 'PULSE fired! It reels, stunned.', t: 3 };
  else if (hit) G.toast = { s: 'PULSE! The shape reels, stunned.', t: 3 };
  else G.toast = { s: 'The PULSE flares... nothing.', t: 2.5 };
  return true;
}

// Test/playtest seam: set any of lantern, tension, pulses, huntRest, huntGone,
// and stalker (a partial state merged over newStalker at x, y) in one call.
function setCave(o) {
  for (const k of ['lantern', 'tension', 'pulses', 'huntRest', 'huntGone', 'caveIn']) if (k in o) G[k] = o[k];
  if ('stalker' in o) G.stalker = o.stalker ? Object.assign(newStalker(o.stalker.x, o.stalker.y), o.stalker) : null;
  return G;
}

function menuLabel(item) {
  if (item === 'PULSE') return 'PULSE x' + G.pulses;
  return item;
}

function caveHudText() { return 'LAMP ' + G.lantern + '%  TENSION ' + G.tension + '  PULSE ' + G.pulses; }

// [name, detail, craftable] per CRAFT row: each recipe, BUILD, BACK.
// Everything a recipe can spend or fill, as one object: materials, the
// BALL/lamp/PULSE counters and the BAG (ids never collide; tested).
function craftHave() {
  return Object.assign({}, G.materials, { balls: G.balls, lantern: G.lantern, pulse: G.pulses }, G.bag);
}

// False when a recipe's GOODS output would overflow its BAG stack.
function bagRoom(r) {
  return !isGood(r.out) || (G.bag[r.out] || 0) + r.count <= BAG_MAX;
}

function craftRows() {
  const tier = pickTier(G.flags.pick);
  const axe = axeTier(G.flags.axe);
  const m = G.materials;
  const have = craftHave();
  const rows = RECIPES.map(r => {
    const need = Object.keys(r.needs).map(k => r.needs[k] + ' ' + craftLabel(k)).join(', ');
    const can = craft(have, r, tier, axe) !== null && bagRoom(r);
    if (r.setsTier) {
      const owned = tier >= r.setsTier;
      return [craftLabel(r.out), owned ? 'owned - it cracks seams' : 'from ' + need + ' - cracks seams',
              !owned && can];
    }
    if (r.setsTool) {
      const owned = axe >= r.setsTool[1];
      return [craftLabel(r.out), owned ? 'owned - it cuts thin trees' : 'from ' + need + ' - cuts thin trees',
              !owned && can];
    }
    if (r.out === 'lantern') return [craftLabel('lantern'), 'from ' + need + ' - lamp ' + G.lantern + '%', can];
    if ('cap' in r) return [r.count + ' ' + craftLabel(r.out), 'from ' + need + ' - have ' + have[r.out] + '/' + r.cap, can];
    return [r.count + ' ' + craftLabel(r.out), 'from ' + need, can];
  });
  rows.push(['BUILD WALLS', 'place WALLs in ROCKY PASS', m.wall > 0]);
  rows.push(['BACK', '', true]);
  return rows;
}

// The overworld BAG screen and the CENTRE shop. Pure list builders (the shell
// only draws them) and their strings, compared across builds by PARITY.
const BAG_BALL_DESC = 'A plain BALL for catching wild monsters. The CENTRE shop sells more.';
const BAG_MAT_DESC = { stone: 'Rough STONE from ROCKY PASS. CRAFT turns it into WALLs.',
                       ore: 'Metal ORE from ROCKY PASS. CRAFT turns it into BALLs.',
                       wall: 'A WALL block. Choose BUILD WALLS in CRAFT to place it.' };
const BAG_MSG = { full: "It won't have any effect.", fainted: "A POTION can't revive a fainted monster.",
                  healed: '%s recovered %d HP!', pick: 'Use %s on which monster?' };
const SHOP_STOCK = ['ball', 'greatball', 'potion', 'superpotion', 'smoke'];   // the BUY list, in order
const SHOP_OFFER = ['SHOP', 'LEAVE'];    // after the CENTRE heal
const SHOP_MAIN = ['BUY', 'SELL', 'BACK'];
const SHOP_MSG = { coins: 'Not enough coins.', full: 'Your bag is full.',
                   purse: 'Your coin purse is full.', bought: 'Bought %d %s for %d coins.',
                   sold: 'Sold %d %s for %d coins.', empty: 'You have nothing to sell.' };
// Python's "%s %d" % args for the shared message strings.
function fmtMsg(s, ...a) { let i = 0; return s.replace(/%[sd]/g, () => String(a[i++])); }
function isGood(id) { return Object.prototype.hasOwnProperty.call(GOODS, id); }
function bagName(item) {
  if (item === 'ball') return 'BALL';
  if (isGood(item)) return GOODS[item].name;
  return MATERIAL_LABEL[item] || String(item).toUpperCase();
}
function bagDesc(item) {
  if (item === 'ball') return BAG_BALL_DESC;
  if (isGood(item)) return GOODS[item].desc;
  return BAG_MAT_DESC[item] || '';
}
// The BAG screen, top to bottom: [kind, id, count]. kind is 'head' (a section
// title), 'none' (an empty section) or a selectable row: 'item' (BALL and the
// battle items), 'mat' (read-only materials) or 'loot'.
function bagRows(balls, bag, materials) {
  const ids = Object.keys(GOODS);
  const items = (balls > 0 ? [['item', 'ball', balls]] : [])
    .concat(ids.filter(k => GOODS[k].kind !== 'loot' && (bag[k] || 0) > 0).map(k => ['item', k, bag[k]]));
  const loot = ids.filter(k => GOODS[k].kind === 'loot' && (bag[k] || 0) > 0).map(k => ['loot', k, bag[k]]);
  const mats = MATERIALS.map(k => ['mat', k, materials[k] || 0]);
  const rows = [];
  for (const [title, part] of [['ITEMS', items], ['MATERIALS', mats], ['LOOT', loot]]) {
    rows.push(['head', title, 0]);
    if (part.length) rows.push(...part); else rows.push(['none', title, 0]);
  }
  return rows;
}
function bagEntries(rows) {      // indexes of the selectable rows (what the BAG cursor walks)
  const out = [];
  rows.forEach((r, i) => { if (r[0] === 'item' || r[0] === 'mat' || r[0] === 'loot') out.push(i); });
  return out;
}
// First visible row of a size-row window over n rows that keeps row cur in view.
function listTop(n, cur, size) { return Math.max(0, Math.min(cur - Math.floor((size - 1) / 2), n - size)); }
function healRefusal(mon) {      // null when a POTION can be used on mon, else the BAG_MSG key
  if (mon.hp <= 0) return 'fainted';
  if (mon.hp >= mon.maxhp) return 'full';
  return null;
}
// BUY: [id, name, price] for SHOP_STOCK. SELL: [id, name, price, owned] for owned loot.
function shopRows(page, bag) {
  if (page === 'buy') return SHOP_STOCK.map(k => [k, bagName(k), k === 'ball' ? BALL_PRICE : GOODS[k].price]);
  return Object.keys(GOODS).filter(k => GOODS[k].kind === 'loot' && (bag[k] || 0) > 0)
    .map(k => [k, GOODS[k].name, GOODS[k].price, bag[k]]);
}
function shopQtyCap(page, row) { return page === 'buy' ? SHOP_QTY_MAX : Math.max(1, Math.min(SHOP_QTY_MAX, row[3])); }

function checkTrainerSight() {
  if (G.mode !== 'overworld' || !partyAlive()) return;
  const p = G.player;
  for (const n of NPCS) {
    if (n.kind !== 'trainer' || G.beaten[n.id]) continue;
    const d = { up: [0, -1], down: [0, 1], left: [-1, 0], right: [1, 0] }[n.dir];
    for (let i = 1; i <= n.sight; i++) {
      const x = n.x + d[0] * i, y = n.y + d[1] * i;
      if (SOLID.has(tileHere(x, y))) break;
      if (p.tx === x && p.ty === y) { engageTrainer(n); return; }
    }
  }
}

function engageTrainer(n) {
  G.player.moving = false;
  sfx('alert');
  say([n.name + ' noticed you!'], () => {
    startFade(() => {
      const [sid, lvl] = n.team[0];
      startBattle(makeMon(sid, lvl), { trainer: n });
    });
  });
}

function interact() {
  const p = G.player;
  const [fx, fy] = facingTile(p);
  const t = tileHere(fx, fy);

  const n = NPCS.find(v => v.x === fx && v.y === fy);
  if (n) {
    if (n.kind === 'prof') { professorTalk(); return; }
    if (n.kind === 'miner') { quarryTalk(n); return; }
    if (n.kind === 'trainer') {
      if (G.beaten[n.id]) { say([n.name + ': ' + n.after]); return; }
      engageTrainer(n);
      return;
    }
    say([n.name + ': ' + n.lines[0]].concat(n.lines.slice(1)));
    return;
  }

  if (t === 'H') {
    sfx('heal');
    const gift = healParty();
    G.lastCentre = [fx, fy + 1];
    say(CENTRE_HEAL.concat(gift ? [NURSE_GIFT] : []), openShop);
    return;
  }
  if (t === 'D') { professorTalk(); return; }
  if (t === 'S') { say(SIGNS[fx + ',' + fy] || ['The lettering has worn away.']); return; }
  if (t === 'o') { pickUp(fx, fy); return; }
  if (t === 'G') { gymDoor(); return; }
  if (t === '~') { fish(); return; }
  if (t === 'B') { say(['Just a wall. Nothing to see.']); return; }
  if (Object.prototype.hasOwnProperty.call(BLOCKS, t) && (inSandbox(fx, fy) || BLOCKS[t].authoredOnly)) {
    const b = BLOCKS[t];
    const tier = pickTier(G.flags.pick);
    const axe = axeTier(G.flags.axe);
    if (canMine(t, fx, fy, tier, axe)) mine(fx, fy);
    else if (b.tool === 'axe') say(['This tree is thinner than the rest. An AXE could cut it.']);
    else if (b.tier > 1) {
      say(['A ' + b.name + ', flecked with ORE.',
           tier ? 'Your PICK just skids off it. It needs an IRON PICK.'
                : 'It would take an IRON PICK to break it.']);
    } else say(['A loose ' + b.name + '. A PICK would break it.']);
    return;
  }
  if (G.building) placeWall(fx, fy);          // refusals explain themselves
}

/* --- sandbox ------------------------------------------------------------ */
function quarryTalk(n) {
  const tier = pickTier(G.flags.pick);
  if (tier) {
    const after = G.flags.backstop ? null : quarryBackstop(G.materials, tier, G.edits);
    if (after) {                     // out of ORE for good: a one-off top-up
      G.materials = after;
      G.flags.backstop = true;
      sfx('level');
      say([n.name + ': ' + n.backstop[0], 'You got ' + BACKSTOP_ORE + ' ORE!'].concat(n.backstop.slice(1)));
      return;
    }
    say([n.name + ': ' + n.after[0]].concat(n.after.slice(1)));
    return;
  }
  G.flags.pick = 1;
  sfx('level');
  say([n.name + ': ' + n.lines[0], 'You got a PICK!'].concat(n.lines.slice(1)));
}

// Break the tile at (x, y) if the PICK or AXE can. Returns the drops.
function mine(x, y) {
  const t = tileHere(x, y);
  if (!canMine(t, x, y, G.flags.pick, G.flags.axe)) return {};
  const drops = mineDrop(t, x, y);
  G.edits = withEdit(G.edits, x, y, BLOCKS[t].leaves);
  for (const k in drops) G.materials[k] = (G.materials[k] || 0) + drops[k];
  sfx(BLOCKS[t].tier >= 2 ? 'mineHeavy' : 'mine');   // cosmetic only
  worldFx('mine', x, y, t, drops);
  G.toast = { s: Object.keys(drops).length === 0 ? 'You cut down the ' + BLOCKS[t].name + '.'
    : 'Got ' + Object.keys(drops).map(k =>
      MATERIAL_LABEL[k] + (drops[k] === 1 ? '' : ' x' + drops[k])).join(' and ') + '!', t: 2.5 };
  return drops;
}

// Craft RECIPES[i] from materials, counters and the BAG (BALLs land in the
// pouch, loot goods in the BAG, a tool recipe raises the PICK tier or
// records the AXE instead).
function craftRecipe(i) {
  const r = RECIPES[i];
  const tier = pickTier(G.flags.pick);
  const axe = axeTier(G.flags.axe);
  if (r.setsTier && tier >= r.setsTier) {
    sfx('cancel');
    G.craftMsg = 'You already have the ' + craftLabel(r.out) + '.';
    return false;
  }
  if (r.setsTool && axe >= r.setsTool[1]) {
    sfx('cancel');
    G.craftMsg = 'You already have the ' + craftLabel(r.out) + '.';
    return false;
  }
  if (!bagRoom(r)) {
    sfx('cancel');
    G.craftMsg = 'Your BAG is full of ' + craftLabel(r.out) + '.';
    return false;
  }
  const have = craftHave();
  if ('cap' in r && have[r.out] >= r.cap) {
    sfx('cancel');
    G.craftMsg = r.out === 'lantern' ? 'Your lantern is already full.'
                                     : 'You can carry only ' + r.cap + ' ' + craftLabel(r.out) + '.';
    return false;
  }
  const after = craft(have, r, tier, axe);
  if (!after) {
    sfx('cancel');
    G.craftMsg = 'Need ' + Object.keys(r.needs).map(k => r.needs[k] + ' ' + craftLabel(k)).join(', ') + '.';
    return false;
  }
  // route every key home: counters, materials, and the rest is the BAG
  G.balls = after.balls; delete after.balls;
  G.lantern = after.lantern; delete after.lantern;
  G.pulses = after.pulse; delete after.pulse;
  const mats = {};
  for (const k of Object.keys(G.materials)) { mats[k] = after[k]; delete after[k]; }
  G.materials = mats;
  const bag = {};
  for (const k of Object.keys(after)) if (after[k] > 0) bag[k] = after[k];
  G.bag = bag;
  sfx('level');
  if (r.out === 'lantern') G.craftMsg = 'Lantern refilled to ' + G.lantern + '%.';
  else if (r.setsTier) {
    G.flags.pick = r.setsTier;
    G.craftMsg = 'Crafted the ' + craftLabel(r.out) + '. Cracked seams give way now.';
  } else if (r.setsTool) {
    G.flags[r.setsTool[0]] = r.setsTool[1];
    G.craftMsg = 'Crafted the ' + craftLabel(r.out) + '. Thin trees give way now.';
  } else G.craftMsg = 'Crafted ' + r.count + ' ' + craftLabel(r.out) + '.';
  return true;
}

function placeWall(x, y) {
  if ((G.materials.wall || 0) <= 0) {
    sfx('cancel');
    G.toast = { s: 'No WALLs left. CRAFT some from STONE.', t: 2.5 };
    return false;
  }
  const [good, why] = placementOk(x, y, G.edits, G.picked, npcTiles(), [G.player.tx, G.player.ty]);
  if (!good) { sfx('cancel'); G.toast = { s: why, t: 2.5 }; return false; }
  G.edits = withEdit(G.edits, x, y, WALL);
  G.materials.wall -= 1;
  sfx('place');
  worldFx('place', x, y, WALL, {});
  G.toast = { s: 'Placed a WALL. ' + G.materials.wall + ' left.', t: 2.5 };
  return true;
}

function pickUp(x, y) {
  const key = x + ',' + y;
  if (G.picked.has(key)) { say(['Nothing left here but ' + pickedText(x, y) + '.']); return; }
  const amount = ITEMS[key] || 3;
  G.picked.add(key);
  G.balls += amount;
  sfx('catch');
  say(['You found ' + amount + ' BALLS!', 'You are carrying ' + G.balls + '.']);
}

function fish() {
  if (!partyAlive()) { say(['Your team is in no shape to fish.']); return; }
  const [fx, fy] = facingTile(G.player);
  const z = WATER_ZONES.find(w => fx >= w.x1 && fx <= w.x2 && fy >= w.y1 && fy <= w.y2);
  if (!z) { say(['The water here is shallow and empty.']); return; }
  sfx('throw');
  if (Math.random() > 0.55) { say(['You cast a line...', '...nothing is biting.']); return; }
  say(['You cast a line...', 'Something strikes!'], () => {
    const sid = pickWeighted(z.pool, Math.random);
    const lvl = z.min + Math.floor(Math.random() * (z.max - z.min + 1));
    G.pendingEncounter = makeMon(sid, lvl);
    sfx('encounter');
    startFade(() => {
      const foe = G.pendingEncounter;
      G.pendingEncounter = null;
      startBattle(foe, {fishing:true});
    });
  });
}

function gymDoor() {
  if (G.flags.gym) { if (campaignHost) campaignHost.showChapterMenu(); else say(['The gym is quiet now. LEADER VOLT gives you a nod.']); return; }
  if (!G.flags.starter) { say(['The gym door is shut. You need a team first.']); return; }
  const won = NPCS.filter(n => n.kind === 'trainer' && G.beaten[n.id]).length;
  if (won < GYM_REQUIREMENT) {
    say(['The doors will not budge.',
         'GYM WARDEN: Six trainers beaten, that\'s the rule. You have ' + won + '.']);
    return;
  }
  say(['The gym doors slide open...'], () => {
    startFade(() => {
      const [sid, lvl] = GYM_LEADER.team[0];
      startBattle(makeMon(sid, lvl), { trainer: GYM_LEADER });
    });
  });
}

function professorTalk() {
  if (!G.flags.starter) {
    say(['PROF. CEDAR: There you are! You cannot walk the trail unarmed.',
         'Four young monsters are waiting, including PICKAJOO. Choose your partner.'],
        () => { G.mode = 'starter'; G.starterCursor = 0; });
  } else if(!G.flags.pickajooGift&&!G.party.some(m=>m.id==='zapmote')){
    if(G.party.length>=6){say(['PROF. CEDAR: PICKAJOO is waiting for you. Make room in your team first.']);return;}
    G.party.push(makeMon('zapmote',5));G.flags.pickajooGift=true;sfx('level');
    say(['PROF. CEDAR: Take PICKAJOO along!','PICKAJOO joined your team and already knows THUNDER.']);
  } else if (!G.flags.gym) {
    say(['PROF. CEDAR: Follow the path north through the grass.',
         'LEADER VOLT runs the gym at the top of the trail. Beat them and the trail is yours.']);
  } else {
    say(['PROF. CEDAR: Champion of the trail! I always knew you had it.']);
  }
}

function chooseStarter(i) {
  const mon = makeMon(STARTERS[i], 5);
  G.party.push(mon);
  G.flags.starter = true;
  G.mode = 'overworld';
  sfx('level');
  say(['You received ' + mon.name + '!',
       'PROF. CEDAR: Head north when you are ready. And do drop by the CENTRE.']);
}

/* --- save / load -------------------------------------------------------- */
function chapterState() {
  if (Campaign) return Campaign.normalizeChapter(G.chapter, G.flags.gym);
  return G.chapter || { v: 1, unlocked: G.flags.gym === true, completed: false, active: false, stage: 1 };
}

function saveGame() {
  try {
    const data = {
      party: G.party, balls: G.balls, bag: Object.assign({}, G.bag), coins: G.coins, battles: G.battles, flags: G.flags, beaten: G.beaten, chapter: chapterState(), settings:G.settings,
      picked: [...G.picked].sort(), centre: G.lastCentre.slice(),
      edits: Object.fromEntries(Object.keys(G.edits).sort().map(k => [k, G.edits[k]])),
      materials: Object.assign({}, G.materials),
      cave: { lantern: G.lantern, tension: G.tension, pulses: G.pulses, rest: G.huntRest, gone: G.huntGone },
      x: G.player.tx, y: G.player.ty, dir: G.player.dir, steps: G.steps
    };
    localStorage.setItem(SAVE_KEY, JSON.stringify(data));
    return true;
  } catch (e) { return false; }
}

function loadGame() {
  try {
    const raw = localStorage.getItem(SAVE_KEY);
    if (!raw) return false;
    const d = JSON.parse(raw);
    if (!d || !Array.isArray(d.party)) return false;
    G.party = d.party.map(m => {
      if (!SPECIES[m.id]) return null;
      if(m.id==='zapmote'){
        if(m.name==='ZAPMOTE')m.name='PICKAJOO';
        if(!Array.isArray(m.moves)||!m.moves.includes('thunderbolt'))m.moves=(Array.isArray(m.moves)?m.moves.slice(0,3):[]).concat('thunderbolt');
      }
      recalcStats(m);
      m.hp = clamp(m.hp, 0, m.maxhp);
      return m;
    }).filter(Boolean);
    G.balls = d.balls || 0;
    G.flags = Object.assign({ starter: false, gym: false }, d.flags);
    G.chapter = Campaign ? Campaign.normalizeChapter(d.chapter, G.flags.gym) : null;
    G.settings = CombatCommands ? CombatCommands.normalizeSettings(d.settings) : G.settings;
    G.flags.pick = pickTier(G.flags.pick);          // old saves: true -> 1
    G.flags.axe = axeTier(G.flags.axe);             // pre-Part B saves: none -> 0
    G.flags.backstop = !!G.flags.backstop;
    G.flags.gymBonus = !!G.flags.gymBonus;
    G.bag = cleanBag(d.bag);
    G.coins = cleanCoins(d.coins);
    G.battles = cleanCount(d.battles);
    G.flags.huntBeaten = huntCount(G.flags.huntBeaten);
    G.beaten = d.beaten || {};
    G.steps = d.steps || 0;
    G.picked = new Set(Array.isArray(d.picked) ? d.picked : []);
    G.lastCentre = Array.isArray(d.centre) ? d.centre.slice() : START_TILE.slice();
    G.edits = loadEdits(d.edits);
    const mats = d.materials && typeof d.materials === 'object' ? d.materials : {};
    G.materials = zeroMaterials();
    for (const k of MATERIALS) {
      const v = Math.trunc(Number(mats[k]));
      if (Number.isFinite(v) && v > 0) G.materials[k] = v;
    }
    G.building = false;
    loadCave(d.cave);
    G.player.tx = d.x; G.player.ty = d.y; G.player.dir = d.dir || 'down';
    G.player.px = d.x * 32; G.player.py = d.y * 32;
    G.player.moving = false;
    syncCave();                      // loaded inside the cave: it spawns far away
    return true;
  } catch (e) { return false; }
}

// The cave counters from a save; missing or garbage -> defaults.
function loadCave(raw) {
  const c = raw && typeof raw === 'object' && !Array.isArray(raw) ? raw : {};
  const num = (k, dflt, top) => {
    const v = c[k];
    if (v === undefined || v === null || typeof v === 'boolean') return dflt;
    const n = Math.trunc(Number(v));
    return Number.isFinite(n) ? clamp(n, 0, top) : dflt;
  };
  G.lantern = num('lantern', LANTERN.max, LANTERN.max);
  G.tension = num('tension', 0, TENSION.max);
  G.pulses = num('pulses', 0, PULSE.max);
  G.huntRest = num('rest', 0, HUNT_AI.restLose);
  G.huntGone = c.gone === true;
  G.stalker = null;
  G.caveIn = false;
}

function hasSave() {
  try { return !!localStorage.getItem(SAVE_KEY); } catch (e) { return false; }
}

/* ====================== LAYER 4: SHELL ======================= */

const TILE = 32;
const VIEW_W = 20, VIEW_H = 15;
const W = VIEW_W * TILE, H = VIEW_H * TILE;

let canvas, ctx;
const keys = {};

/* Accessibility: one flag every motion effect reads. With the OS "reduce
   motion" setting on, screen shake (and later juice) scales to zero at draw
   time only - battle logic and timings are untouched. */
const REDUCED_MOTION = typeof matchMedia === 'function' &&
  matchMedia('(prefers-reduced-motion: reduce)').matches;
const SHAKE_SCALE = REDUCED_MOTION ? 0 : 1;
let camX = 0, camY = 0;

/* --- battle juice (shell only) -------------------------------------------
   Every effect is set by juiceHit() from inside the hit's qDo step, decays
   in updateBattle and is drawn in drawBattle. None of it is read by battle
   logic, so the step queue, damage and RNG order are untouched. Cosmetic
   randomness uses its own PRNG, never Math.random (which the engine uses).
   Same constants, same values as the pygame build. */
const SHAKE_MAX = 7;              // px at trauma 1 (arena only; 240+7 < 248 keeps the HP box clear)
const TRAUMA_DECAY = 1.8;         // trauma lost per second
const TRAUMA_HIT = 0.35;          // normal hit
const TRAUMA_WEAK = 0.2;          // not very effective
const TRAUMA_SUPER = 0.6;         // super effective
const TRAUMA_CRIT = 0.2;          // added on top for a critical hit
const HITSTOP_WEAK = 0.03;        // s of frozen animation
const HITSTOP_NORMAL = 0.06;
const HITSTOP_SUPER = 0.10;
const HITSTOP_CRIT = 0.12;
const FLASH_TIME = 0.2;           // s the damaged sprite is tinted white
const FLASH_ALPHA = 0.85;         // peak white strength
const PARTICLE_MAX = 64;          // pool size, never exceeded
const PARTICLE_BURST = 14;        // per normal hit
const PARTICLE_BURST_SUPER = 22;  // per super-effective / crit hit
const PARTICLE_BURST_REDUCED = 5; // per hit when reduced motion is on
const PARTICLE_LIFE = 0.5;        // s, +-40% per particle
const PARTICLE_SPEED = 150;       // px/s, +-50%
const PARTICLE_GRAVITY = 380;     // px/s^2
const HIT_PITCH_JITTER = 0.05;    // +-5% per hit sound
const HITSTOP_SCALE = REDUCED_MOTION ? 0 : 1;
const FLASH_SCALE = REDUCED_MOTION ? 0 : 1;
// The hunt battle's jumpscare (b.scare). One flash that decays, never a strobe.
const SCARE_FLASH_TIME = 0.3;     // s the arena-wide white flash takes to fade (none with reduced motion)
const SCARE_FLASH_ALPHA = 0.8;    // its peak strength
const SCARE_TRAUMA = 0.8;         // shake added at the reveal (none with reduced motion)
const SCARE_LUNGE_TIME = 0.35;    // s the foe takes to spring from close up back to its platform
const SCARE_LUNGE_SCALE = 1.35;   // how much bigger it starts the lunge
const SCARE_VEIL_DARK = 235;      // arena darkness while the foe is still hidden (alpha 0..255)
const SCARE_VEIL = 110;           // the gloom over the whole hunt battle once it is revealed

// Cosmetic PRNG (mulberry32) so juice never perturbs the engine's Math.random.
let fxSeed = (Date.now() >>> 0) || 1;
function fxRand() {
  fxSeed = (fxSeed + 0x6D2B79F5) >>> 0;
  let t = fxSeed;
  t = Math.imul(t ^ (t >>> 15), t | 1);
  t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
}

// Fixed pool, allocated once: x, y, vx, vy, life, max, size, colour.
const PARTS = [];
for (let i = 0; i < PARTICLE_MAX; i++) PARTS.push({ x: 0, y: 0, vx: 0, vy: 0, life: 0, max: 1, size: 3, col: '#fff' });
function clearParticles() { for (let i = 0; i < PARTICLE_MAX; i++) PARTS[i].life = 0; }

// Sprite centres in the arena, matching drawBattle.
function juiceTarget(side) { return side === 'foe' ? [W * 0.66, 178] : [W * 0.26, 300]; }

function spawnBurst(x, y, n, col) {
  const light = shadeBy(col, 0.5);              // once per burst, not per frame
  for (let i = 0, k = 0; i < n && k < PARTICLE_MAX; k++) {
    const p = PARTS[k];
    if (p.life > 0) continue;
    const ang = fxRand() * Math.PI * 2;
    const spd = PARTICLE_SPEED * (0.5 + fxRand());
    const r = 6 + fxRand() * 10;              // start on a ring so the freeze frame reads
    p.x = x + Math.cos(ang) * r; p.y = y + Math.sin(ang) * r;
    p.vx = Math.cos(ang) * spd; p.vy = Math.sin(ang) * spd - 90;
    p.max = p.life = PARTICLE_LIFE * (0.6 + fxRand() * 0.8);
    p.size = 2 + fxRand() * 3;
    p.col = i % 3 === 2 ? '#ffffff' : i % 3 === 1 ? light : col;
    i++;
  }
}

function juiceHit(b, side, eff, crit, type) {
  if (eff === 0) return;                      // nothing landed
  const sup = eff >= 2, weak = eff < 1;
  const add = (sup ? TRAUMA_SUPER : weak ? TRAUMA_WEAK : TRAUMA_HIT) + (crit ? TRAUMA_CRIT : 0);
  b.trauma = Math.min(1, b.trauma + add);
  const stop = crit ? HITSTOP_CRIT : sup ? HITSTOP_SUPER : weak ? HITSTOP_WEAK : HITSTOP_NORMAL;
  b.freeze = Math.max(b.freeze, stop * HITSTOP_SCALE);
  b.flashSide = side;
  b.flashT = FLASH_TIME * FLASH_SCALE;
  const n = REDUCED_MOTION ? PARTICLE_BURST_REDUCED : (sup || crit) ? PARTICLE_BURST_SUPER : PARTICLE_BURST;
  const at = juiceTarget(side);
  spawnBurst(at[0], at[1], n, TYPE_COLOR[type] || '#ffffff');
}

// The hunt's reveal: one decaying white flash plus a shake. With reduced
// motion (calm) neither happens; the text carries the scare.
function juiceScare(b, calm) {
  if (calm) return;
  b.trauma = Math.min(1, Math.max(b.trauma, SCARE_TRAUMA));
  b.scareFlash = SCARE_FLASH_TIME;
}

// Where the foe sprite sits: its platform, or mid-lunge during the hunt's
// reveal (springing from close up back to the platform). No lunge when calm.
function foePose(b) {
  let x = W * 0.66, y = 178, size = 78;
  if (b.scare === 'reveal' && !scareCalm() && b.scareT < SCARE_LUNGE_TIME) {
    const u = b.scareT / SCARE_LUNGE_TIME;
    const k = 1 - (1 - u) * (1 - u);             // ease out
    x = W * 0.5 + (x - W * 0.5) * k;
    y = 214 + (y - 214) * k;
    size = size * (SCARE_LUNGE_SCALE + (1 - SCARE_LUNGE_SCALE) * k);
  }
  return [x, y, size];
}

// Animation time only: the queue clock and input keep running during a freeze.
function updateJuice(b, dt) {
  b.scareFlash = Math.max(0, (b.scareFlash || 0) - dt);
  if (b.freeze > 0) { b.freeze = Math.max(0, b.freeze - dt); return; }
  b.animT += dt;
  b.trauma = Math.max(0, b.trauma - TRAUMA_DECAY * dt);
  b.flashT = Math.max(0, b.flashT - dt);
  for (let i = 0; i < PARTICLE_MAX; i++) {
    const p = PARTS[i];
    if (p.life <= 0) continue;
    p.life -= dt;
    p.vy += PARTICLE_GRAVITY * dt;
    p.x += p.vx * dt; p.y += p.vy * dt;
  }
}

function drawParticles(ox, oy) {
  for (let i = 0; i < PARTICLE_MAX; i++) {
    const p = PARTS[i];
    if (p.life <= 0) continue;
    const s = p.size * (p.life / p.max) + 0.5;  // shrink instead of alpha: no state churn
    ctx.fillStyle = p.col;
    ctx.fillRect(p.x + ox - s, p.y + oy - s, s * 2, s * 2);
  }
}

// One offscreen canvas, made on first use, for the white damage flash.
let flashCanvas = null, flashCtx = null;
const FLASH_BOX = 288;            // offscreen box the white flash is drawn into
function drawCreatureFlash(sp, cx, cy, s, flip, backView, t, alpha) {
  if (!flashCanvas) {
    flashCanvas = document.createElement('canvas');
    flashCanvas.width = flashCanvas.height = FLASH_BOX;
    flashCtx = flashCanvas.getContext('2d');
  }
  flashCtx.setTransform(1, 0, 0, 1, 0, 0);
  flashCtx.globalCompositeOperation = 'source-over';
  flashCtx.clearRect(0, 0, FLASH_BOX, FLASH_BOX);
  const main = ctx;
  ctx = flashCtx;
  try { drawCreature(sp, FLASH_BOX / 2, FLASH_BOX / 2, s, flip, backView, t); }
  finally { ctx = main; }
  flashCtx.globalCompositeOperation = 'source-atop';
  flashCtx.fillStyle = '#ffffff';
  flashCtx.fillRect(0, 0, FLASH_BOX, FLASH_BOX);
  flashCtx.globalCompositeOperation = 'source-over';
  ctx.globalAlpha = alpha;
  ctx.drawImage(flashCanvas, cx - FLASH_BOX / 2, cy - FLASH_BOX / 2);
  ctx.globalAlpha = 1;
}

/* --- overworld (sandbox) juice (shell only) --------------------------------
   Fed by worldFx() from mine()/placeWall() after the state has changed:
   a camera nudge, pooled debris and dust, the crack frame of a broken tile,
   a WALL pop-in and floating pickup labels. Nothing here is read back by
   game logic, and it draws with fxRand only. Same names and values as the
   pygame build. Particles and labels live in world pixels. */
const WORLD_SHAKE_MAX = 4;        // px at trauma 1: a camera nudge; the HUD never moves
const TRAUMA_MINE = 0.5;          // per boulder broken (0.5^2 * 4 = 1 px)
const TRAUMA_MINE_ORE = 0.7;      // when ORE drops (~2 px)
const DEBRIS_MAX = 48;            // overworld particle pool, never exceeded
const DEBRIS_BURST = 12;          // stone chips per break
const DEBRIS_BURST_ORE = 6;       // extra gold glints when ORE drops
const DEBRIS_BURST_REDUCED = 4;   // chips per break with reduced motion (plus 1 glint for ORE)
const DEBRIS_SPEED = 110;         // px/s, +-50%
const DEBRIS_LIFE = 0.45;         // s, +-40%
const DEBRIS_GRAVITY = 520;       // px/s^2
const DUST_BURST = 10;            // dust puff when a built WALL is mined back (half on placing)
const DUST_SPEED = 45;            // px/s, +-50%
const DUST_GRAVITY = -40;         // px/s^2: dust drifts up
const CRACK_TIME = 0.05;          // s (3 frames at 60 Hz) a broken tile lingers, cracked
const CRACK_FLASH = 0.6;          // peak white over the cracked tile (0 with reduced motion)
const POP_TIME = 0.15;            // s a placed WALL takes to pop in
const POP_FROM = 0.4;             // its starting scale
const POP_BACK = 2.4;             // easeOutBack overshoot constant (peak scale ~1.11)
const FLOAT_MAX = 6;              // floating "+1 STONE" labels alive at once
const FLOAT_TIME = 0.9;           // s each label lives
const FLOAT_RISE = 24;            // px it rises over its life
const FLOAT_STAGGER = 0.15;       // s before each further label from one break appears
const FLOAT_LINE = 15;            // px between stacked labels (they rise together)
const SPARKLE_RADIUS = 4;         // tiles (Chebyshev) within which ORE boulders glint
const SPARKLE_PERIOD = 2.2;       // s between glints on one boulder
const SPARKLE_TIME = 0.35;        // s each glint lasts
const TARGET_OK = '#6ee882';      // build box: a WALL would go here
const TARGET_BAD = '#f05c50';     // build box: it would be refused (also drawn with an x)
const TARGET_OK_FILL = 'rgba(110,232,130,0.22)';
const TARGET_BAD_FILL = 'rgba(240,92,80,0.22)';
const STONE_CHIPS = ['#767066', '#928c82', '#544f48'];
const ORE_GLINT = '#ffbe40';
const ORE_GLINT_HI = '#ffeca0';
const SEAM_EDGE = '#d6a054';     // the lit lip of a cracked seam (K)
const TREE_TRUNK = [226, 208, 168];  // a THICK TREE's (T) pale, bark-stripped trunk band
const TREE_NOTCH = [58, 38, 22];     // the axe notches cut into it
const TREE_BAND = [14, 7, 5, 25];    // the trunk band rect inside the tile: x, y, w, h
const TREE_NOTCHES = [12, 19, 26];   // tile-y of each notch (a wedge across the band)
const DUST_COL = '#c4baa6';
const FLOAT_COL = { stone: '#dccea9', ore: ORE_GLINT };
const CRAFT_RECT = [70, 74, W - 140, 340];  // below the HUD (ends y=66), above the toast (y=420)
const CRAFT_ROW_H = 30;                     // row pitch of the CRAFT list
const CRAFT_ROWS = 7;                       // visible CRAFT rows; longer lists scroll (cues like the BAG)
                                            // and the 7th row still ends above the message line
const CRAFT_TIER_NAME = ['NONE', 'PICK', 'IRON PICK'];
// The tier-2 break, the seam tell and the GEODE (same names and values in the pygame build).
const TRAUMA_MINE_HEAVY = 0.9;    // a CRACKED SEAM (0.9^2 * 4 = ~3 px; still clamped at 1.0 -> WORLD_SHAKE_MAX)
const MINE_HITSTOP = 0.06;        // s the world fx hold on a seam break (0 with reduced motion); input never stops
const DEBRIS_BURST_HEAVY = 20;    // rock chips per seam break (a boulder gets DEBRIS_BURST)
const DEBRIS_BURST_HEAVY_ORE = 10; // ORE glints per seam break
const DEBRIS_SPEED_HEAVY = 150;   // px/s, +-50%: seam chips fly further
const GEODE_DOOR = (() => {       // the entrance seam on the GEODE's bottom row
  for (let x = GEODE[0]; x <= GEODE[2]; x++) if (MAP[GEODE[3]][x] === SEAM) return [x, GEODE[3]];
  return null;
})();
const GEODE_GLINT_ONE_IN = 3;     // 1 in N open GEODE tiles carries a crystal (by tileHash)
const GEODE_GLINT_PERIOD = 1.7;   // s between glints on one crystal
const GEODE_GLINT_TIME = 0.45;    // s each glint lasts
const GEODE_GLINT = '#c49cff';
const GEODE_GLINT_HI = '#f4eaff';
const GEODE_GLOW = [150, 110, 230]; // a soft violet wash over the opened pocket, above the lantern dark
const GEODE_GLOW_ALPHA = 48;      // peak alpha (0-255) at the pocket's centre; static, so kept with reduced motion
const GEODE_GLOW_STEPS = 6;       // nested ellipses that build the wash (each adds ALPHA / STEPS)
const HUD_MAT_RECT = [8, 42, 250, 24];        // materials + pick tier panel (ends y=66, above CRAFT_RECT)
const HUD_CAVE_RECT = [W / 2 - 105, 8, 210, 30];   // DARK CAVE lantern/tension/PULSE line (cave only)
const HUD_LEAD_RECT = [W - 166, 8, 158, 30];  // lead monster HP box
const HUD_TIER_COL = ['#6f8ba8', '#bfe0ff', ORE_GLINT];   // NONE / PICK / IRON PICK label
const MENU_W = 190;
const MENU_Y = 46;                // below the lead-HP box (ends y=38); was 16, which overlapped it
// The BAG screen and the CENTRE shop (same names and values in the pygame build).
const BAG_RECT = [70, 74, W - 140, 340];    // CRAFT's footprint: below the HUD (y=66), above the toast (y=420)
const BAG_ROWS = 8;                         // visible list rows (section titles included); it scrolls
const BAG_ROW_H = 26;
const BAG_PICK_RECT = [100, 128, W - 200, 236];   // the POTION party picker, inside BAG_RECT; 6 rows of 30
const SHOP_RECT = [70, 74, W - 140, 340];   // BUY / SELL
const SHOP_ROWS = 6;
const SHOP_ROW_H = 30;
const SHOP_MENU_RECT = [W - 16 - MENU_W, MENU_Y, MENU_W, 128];   // SHOP / LEAVE and BUY / SELL / BACK
const BBAG_ROWS = 3;                        // the battle BAG list, inside the bottom panel
const BBAG_ROW_H = 22;
const BBAG_SPLIT_X = 312;                   // list on the left, the selected item's description on the right
const COIN_COL = '#b07828';
const CUE_COL = '#4a90d8';                  // section titles and the scroll cues

function easeOutBack(u) { const c3 = POP_BACK + 1; return 1 + c3 * Math.pow(u - 1, 3) + POP_BACK * Math.pow(u - 1, 2); }

const WFX = { trauma: 0, freeze: 0, cracks: new Map(), pops: new Map() };   // freeze: hit-stop, s   // 'x,y' -> {t, tile} / seconds
const DEBRIS = [];
for (let i = 0; i < DEBRIS_MAX; i++) DEBRIS.push({ x: 0, y: 0, vx: 0, vy: 0, life: 0, max: 1, size: 2, col: '#fff', grav: 0 });
const FLOATS = [];
for (let i = 0; i < FLOAT_MAX; i++) FLOATS.push({ on: false, age: 0, delay: 0, wx: 0, wy: 0, s: '', col: '#fff' });

function resetWorldFx() {
  WFX.trauma = 0; WFX.freeze = 0; WFX.cracks.clear(); WFX.pops.clear();
  for (let i = 0; i < DEBRIS_MAX; i++) DEBRIS[i].life = 0;
  for (let i = 0; i < FLOAT_MAX; i++) FLOATS[i].on = false;
}

function spray(x, y, n, cols, speed, grav, size) {
  let spawned = 0;
  for (let k = 0; k < DEBRIS_MAX && spawned < n; k++) {
    const p = DEBRIS[k];
    if (p.life > 0) continue;
    const ang = fxRand() * Math.PI * 2;
    const spd = speed * (0.5 + fxRand());
    p.x = x + (fxRand() * 2 - 1) * 8; p.y = y + (fxRand() * 2 - 1) * 8;
    p.vx = Math.cos(ang) * spd; p.vy = Math.sin(ang) * spd - speed * 0.6;   // chips kick upward first
    p.max = p.life = DEBRIS_LIFE * (0.6 + fxRand() * 0.8);
    p.size = size * (0.6 + fxRand() * 0.8);
    p.col = cols[spawned % cols.length];
    p.grav = grav;
    spawned++;
  }
  return spawned;
}

function floatLabel(wx, wy, s, col, delay) {
  for (let i = 0; i < FLOAT_MAX; i++) {
    const f = FLOATS[i];
    if (f.on) continue;
    f.on = true; f.age = 0; f.delay = delay; f.wx = wx; f.wy = wy; f.s = s; f.col = col;
    return true;
  }
  return false;
}

function worldFx(kind, x, y, tile, drops) {
  const cx = x * TILE + TILE / 2, cy = y * TILE + TILE / 2, key = x + ',' + y;
  const calm = REDUCED_MOTION;
  if (kind === 'mine') {
    const ore = !!drops.ore;
    const heavy = !!BLOCKS[tile] && BLOCKS[tile].tier >= 2;          // a CRACKED SEAM
    WFX.cracks.set(key, { t: CRACK_TIME, tile });
    WFX.pops.delete(key);
    WFX.trauma = Math.min(1, WFX.trauma + (heavy ? TRAUMA_MINE_HEAVY : ore ? TRAUMA_MINE_ORE : TRAUMA_MINE));
    if (heavy && !calm) WFX.freeze = Math.max(WFX.freeze, MINE_HITSTOP);
    spray(cx, cy, calm ? DEBRIS_BURST_REDUCED : heavy ? DEBRIS_BURST_HEAVY : DEBRIS_BURST, STONE_CHIPS,
          heavy ? DEBRIS_SPEED_HEAVY : DEBRIS_SPEED, DEBRIS_GRAVITY, heavy ? 3.5 : 3);
    if (ore) spray(cx, cy, calm ? 1 : heavy ? DEBRIS_BURST_HEAVY_ORE : DEBRIS_BURST_ORE,
                   [ORE_GLINT, ORE_GLINT_HI], DEBRIS_SPEED * 1.2, DEBRIS_GRAVITY, 2.5);
    if (tile === WALL) spray(cx, cy + 8, calm ? DEBRIS_BURST_REDUCED : DUST_BURST, [DUST_COL], DUST_SPEED, DUST_GRAVITY, 4);
    const ks = Object.keys(drops).sort((a, b) => (a !== 'stone') - (b !== 'stone'));
    ks.forEach((k, i) => floatLabel(cx, y * TILE - 4 - i * FLOAT_LINE,
      '+' + drops[k] + ' ' + MATERIAL_LABEL[k], FLOAT_COL[k] || '#ffffff', i * FLOAT_STAGGER));
  } else if (kind === 'lunge' || kind === 'pulse') {
    caveFxEvent(kind, x, y, drops);
  } else if (kind === 'place') {
    WFX.pops.set(key, 0);
    WFX.cracks.delete(key);
    spray(cx, cy + 12, Math.floor((calm ? DEBRIS_BURST_REDUCED : DUST_BURST) / 2), [DUST_COL], DUST_SPEED, DUST_GRAVITY, 3.5);
  }
}

// World-fx animation time only. During a hit-stop the debris, crack frame,
// labels and shake decay hold still; the game (movement, input, the clock the
// tells read) runs on in update() and never waits.
function updateWorldFx(dt) {
  if (WFX.freeze > 0) { WFX.freeze = Math.max(0, WFX.freeze - dt); return; }
  WFX.trauma = Math.max(0, WFX.trauma - TRAUMA_DECAY * dt);
  for (const [k, c] of WFX.cracks) { c.t -= dt; if (c.t <= 0) WFX.cracks.delete(k); }
  for (const [k, t] of WFX.pops) { if (t + dt >= POP_TIME) WFX.pops.delete(k); else WFX.pops.set(k, t + dt); }
  for (let i = 0; i < DEBRIS_MAX; i++) {
    const p = DEBRIS[i];
    if (p.life <= 0) continue;
    p.life -= dt;
    p.vy += p.grav * dt;
    p.x += p.vx * dt; p.y += p.vy * dt;
  }
  for (let i = 0; i < FLOAT_MAX; i++) {
    const f = FLOATS[i];
    if (!f.on) continue;
    f.age += dt;
    if (f.age >= f.delay + FLOAT_TIME) f.on = false;
  }
}

function worldOffset() {
  const k = WFX.trauma * WFX.trauma * WORLD_SHAKE_MAX * SHAKE_SCALE;
  if (k <= 0) return [0, 0];
  return [Math.round((fxRand() * 2 - 1) * k), Math.round((fxRand() * 2 - 1) * k)];
}

// Scale of a WALL still popping in, or null once it has settled.
function popScale(key) {
  if (!WFX.pops.has(key)) return null;
  if (REDUCED_MOTION) return 1;
  return POP_FROM + (1 - POP_FROM) * easeOutBack(Math.min(1, WFX.pops.get(key) / POP_TIME));
}

function liveDebris() { let n = 0; for (let i = 0; i < DEBRIS_MAX; i++) if (DEBRIS[i].life > 0) n++; return n; }

/* --- DARK CAVE horror kit: look, sound and feel (shell only) ----------------
   Same names and values as the pygame build. Nothing here is read by game
   logic; every random draw is fxRand, never Math.random or the stalker's
   mulberry32. Fed by worldFx('lunge' / 'pulse'), advanced by updateCaveFx,
   drawn by drawOverworld. Fixed pools: no allocation per frame. */
const LAMP_TINT = [120, 66, 16];  // warm wash over the lit floor; about as bright as the floor, so it tints, not lights
const LAMP_TINT_ALPHA = 44;       // its alpha (0-255) where the soft edge begins; 0 at the clear core
const LAMP_DARK = [6, 4, 12];     // the unlit cave
const LAMP_DARK_ALPHA = 238;      // its alpha outside the lantern
const LAMP_FEATHER = [0.8, 1.15]; // x lit radius: fully lit inside the first, fully dark past the second
const LAMP_FLICKER_BELOW = 25;    // % charge under which the flame gutters (none with reduced motion)
const LAMP_FLICKER_ALPHA = 80;    // peak extra dark over the lit ring at an empty lamp (core stays clear)
const LAMP_FLICKER_RATE = 9;      // new flicker targets per second (eased between)
const HUD_CAVE_BAR_X = 52;        // the LAMP / TENSION bars start this far into HUD_CAVE_RECT
const HUD_CAVE_BAR_W = 84;
const HUD_CAVE_BAR_H = 6;
const HUD_CAVE_ROWS = [7, 19];    // y of the LAMP row and the TENSION row inside HUD_CAVE_RECT
const HUD_TENSION_FROM = 25;      // the TENSION row shows from here
const HUD_LAMP_LOW = 20;          // % under which the LAMP bar turns from amber to red-orange
const VIGNETTE_FROM = 50;         // tension at which the edge vignette starts...
const VIGNETTE_MIN = 30;          // ...at this alpha (0-255),
const VIGNETTE_MAX = 120;         // rising linearly to this at tension 100
const VIGNETTE_PULSE = 40;        // extra alpha on each heartbeat at fear (none with reduced motion)
const HEART_HZ_MIN = 1.2;         // heartbeats per second at fear (TENSION.fear)...
const HEART_HZ_MAX = 1.8;         // ...rising to this at tension 100
const HEART_DUB = 0.18;           // the "dub" lands this far (fraction of a beat) after the "lub"
const GRAIN_TILE = 128;           // px square film-grain tile, generated once
const GRAIN_ALPHA = 46;           // peak per-pixel alpha of the static
const GRAIN_FPS = 24;             // the static re-rolls its offset this often
const TEAR_EVERY = 2.0;           // s, mean gap between horizontal tear lines (fear only)
const TEAR_TIME = 0.12;           // s each tear lasts
const TEAR_SHIFT = 6;             // px a tear slides its strip sideways
const TEAR_MAX = 2;               // tears alive at once (fixed pool)
const EYE_COL = [255, 70, 90];    // hunting eyes
const EYE_STUN_COL = [110, 124, 150]; // dimmed, stunned eyes
const EYE_BLINK_EVERY = 2.8;      // s, mean gap between blinks
const EYE_BLINK_TIME = 0.12;      // s a blink lasts
const EYE_BOB = 1.5;              // px the eyes drift (none with reduced motion)
const STALKER_SHADE = [70, 60, 96]; // the GLOOMSTALK sprite darkened to a shadow, not a monster
const STALKER_GLIDE = 0.18;       // s the body takes to slide one tile (snaps with reduced motion)
const TRAIL_MAX = 6;              // fading eye ghosts behind a moving hunter (fixed pool)
const TRAIL_TIME = 0.35;          // s each ghost lasts
const LUNGE_TIME = 0.28;          // s of eye flare + jolt before the cut to the hunt (none with reduced motion)
const LUNGE_TRAUMA = 0.9;         // world jolt (0.81 * WORLD_SHAKE_MAX = ~3 px)
const LUNGE_EYE_SCALE = 2.6;      // the eyes swell to this as it springs
const LUNGE_FLASH_ALPHA = 90;     // the one red flash over the world (decays, never repeats)
const PULSE_RING_TIME = 0.45;     // s the wavefront takes to run PULSE.range tiles (by path)
const PULSE_RING_FADE = 0.25;     // s the lit tiles take to fade once it has passed
const PULSE_RING_ALPHA = 150;     // wavefront strength (0-255)
const PULSE_HIT_COL = [150, 236, 255];
const PULSE_MISS_COL = [120, 136, 170];
const PULSE_HIT_TRAUMA = 0.6;     // jolt when the PULSE catches it (none on a miss)
const PULSE_SPARKS = 14;          // sparks off the stunned stalker (a miss throws none)
const DRONE_VOL = 0.18;           // ambient cave drone volume at tension 100 (a quarter of it at 0)

const rgbStr = (c, a) => a === undefined ? 'rgb(' + c[0] + ',' + c[1] + ',' + c[2] + ')'
                                         : 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + a + ')';
function smoothstep(u) { u = clamp(u, 0, 1); return u * u * (3 - 2 * u); }

// Half-size in px of the lantern's hole sprite: the lit radius times the
// outer edge of the feather (fully dark beyond it).
function lampHoleRadius(charge) { return Math.ceil(Math.round(lanternRadius(charge) * TILE) * LAMP_FEATHER[1]); }

// [rgb, alpha] of the lantern mask d px from the flame, for a lit radius of
// lit px: clear inside the core, a warm wash out to the feather, then a
// smoothstep into the dark.
function lampProfile(d, lit) {
  const core = LANTERN.corePx;
  if (d <= core) return [LAMP_DARK, 0];
  const inner = lit * LAMP_FEATHER[0], outer = lit * LAMP_FEATHER[1];
  if (d <= inner) return [LAMP_TINT, Math.floor(LAMP_TINT_ALPHA * (d - core) / Math.max(1, inner - core) + 0.5)];
  const e = smoothstep((d - inner) / (outer - inner));
  const rgb = LAMP_TINT.map((a, i) => Math.floor(a + (LAMP_DARK[i] - a) * e + 0.5));
  return [rgb, Math.floor(LAMP_TINT_ALPHA * (1 - e) + LAMP_DARK_ALPHA * e + 0.5)];
}

// 0..1: how hard the flame gutters - none above LAMP_FLICKER_BELOW %.
function lampFlickerAmp(charge, reduced) {
  if (reduced || charge >= LAMP_FLICKER_BELOW) return 0;
  return (LAMP_FLICKER_BELOW - Math.max(0, charge)) / LAMP_FLICKER_BELOW;
}

// Edge vignette alpha: none under VIGNETTE_FROM, then linear to VIGNETTE_MAX.
function vignetteAlpha(tension) {
  const t = clamp(tension, 0, TENSION.max);
  if (t < VIGNETTE_FROM) return 0;
  return Math.floor(VIGNETTE_MIN + (VIGNETTE_MAX - VIGNETTE_MIN) * (t - VIGNETTE_FROM) / (TENSION.max - VIGNETTE_FROM) + 0.5);
}

// Heartbeats per second: none below fear, HEART_HZ_MIN..MAX above it.
function heartHz(tension) {
  const t = clamp(tension, 0, TENSION.max);
  if (t < TENSION.fear) return 0;
  return HEART_HZ_MIN + (HEART_HZ_MAX - HEART_HZ_MIN) * (t - TENSION.fear) / (TENSION.max - TENSION.fear);
}

// 0..1 swell of one lub-dub, phase 0..1 through the beat.
function heartEnv(phase) {
  const lub = Math.exp(-phase / 0.07);
  const dub = phase >= HEART_DUB ? 0.65 * Math.exp(-(phase - HEART_DUB) / 0.07) : 0;
  return Math.max(lub, dub);
}

// What the screen does at this tension. Reduced motion keeps a static
// vignette, the HUD meter and the heartbeat sound - no pulse, grain or tears.
function tensionFx(tension, reduced) {
  const fear = clamp(tension, 0, TENSION.max) >= TENSION.fear, moving = fear && !reduced;
  return { vignette: vignetteAlpha(tension), pulse: moving, grain: moving, tears: moving, heart: heartHz(tension) };
}

// 1 -> 0 over LUNGE_TIME: the one flash of the lunge (it only ever decays).
function lungeFlare(age) {
  if (age === null || age === undefined || age < 0 || age >= LUNGE_TIME) return 0;
  const u = age / LUNGE_TIME;
  return (1 - u) * (1 - u);
}

// Absolute rects and fills of the cave HUD bars inside HUD_CAVE_RECT. tension
// is null below HUD_TENSION_FROM; label makes fear readable without colour.
function caveHudBars(charge, tension) {
  const x = HUD_CAVE_RECT[0], y = HUD_CAVE_RECT[1];
  const c = clamp(Math.trunc(charge), 0, LANTERN.max), t = clamp(Math.trunc(tension), 0, TENSION.max);
  const fear = t >= TENSION.fear, show = t >= HUD_TENSION_FROM;
  return {
    lamp: [x + HUD_CAVE_BAR_X, y + HUD_CAVE_ROWS[0], HUD_CAVE_BAR_W, HUD_CAVE_BAR_H],
    lampFill: Math.floor((HUD_CAVE_BAR_W * c + Math.floor(LANTERN.max / 2)) / LANTERN.max),
    low: c < HUD_LAMP_LOW,
    tension: show ? [x + HUD_CAVE_BAR_X, y + HUD_CAVE_ROWS[1], HUD_CAVE_BAR_W, HUD_CAVE_BAR_H] : null,
    tensionFill: show ? Math.floor((HUD_CAVE_BAR_W * t + Math.floor(TENSION.max / 2)) / TENSION.max) : 0,
    fear, label: fear ? 'FEAR!' : 'TENSION' };
}

// Which eyes read through the dark: 'stun' (dimmed) while stunned, 'hunt'
// while it hunts within sense (Manhattan - a lower bound on its path, so no
// BFS per frame), else null.
function stalkerEyes(st, player, charge, tension) {
  if (!st) return null;
  if (st.stun > 0) return 'stun';
  if (st.mode !== 'hunt') return null;
  const d = Math.abs(st.x - player[0]) + Math.abs(st.y - player[1]);
  return d <= stalkerSense(charge, tension) ? 'hunt' : null;
}

// [[x, y, path distance]] the PULSE wavefront lights: every tile its BFS
// reaches within PULSE.range, so it pours round rock, never through it.
function pulseRing(reach) {
  const out = [];
  for (const [k, d] of reach) if (d <= PULSE.range) { const [x, y] = k.split(',').map(Number); out.push([x, y, d]); }
  return out.sort((a, b) => a[2] - b[2] || a[1] - b[1] || a[0] - b[0]);
}

let CAVE_CALM = null;             // test seam: null follows REDUCED_MOTION
function caveCalm() { return CAVE_CALM === null ? REDUCED_MOTION : CAVE_CALM; }
function setCaveCalm(v) { CAVE_CALM = v === null ? null : !!v; }

const CFX = { trail: [], tears: [], pendingConfirm: false };
for (let i = 0; i < TRAIL_MAX; i++) CFX.trail.push({ x: 0, y: 0, t: 0 });
for (let i = 0; i < TEAR_MAX; i++) CFX.tears.push({ t: 0, y: 0, h: 0, dx: 0 });
function resetCaveFx() {
  Object.assign(CFX, { hbPhase: 0, hbOn: false, beats: 0, flicker: 0, flickerTo: 0, flickerT: 0,
    grainT: 0, grainX: 0, grainY: 0, tearWait: TEAR_EVERY, blinkWait: EYE_BLINK_EVERY, blink: 0,
    stTo: null, stFromX: 0, stFromY: 0, glide: 1, lungeAge: null, lungeAt: [0, 0], ring: null });
  for (const tr of CFX.trail) tr.t = 0;
  for (const te of CFX.tears) te.t = 0;
}
resetCaveFx();

function caveFxEvent(kind, x, y, drops) {
  const calm = caveCalm();
  if (kind === 'lunge') {
    if (calm) return;                       // the fade and the text carry it
    CFX.lungeAge = 0; CFX.lungeAt = [x, y];
    WFX.trauma = Math.max(WFX.trauma, LUNGE_TRAUMA);
  } else if (kind === 'pulse') {
    const hit = !!(drops && drops.hit);
    const reach = caveDist([x, y], G.edits, G.picked, npcTiles(), true);
    CFX.ring = { age: 0, x, y, hit, tiles: pulseRing(reach) };
    sfx(hit ? 'pulseHit' : 'pulseMiss');
    const st = G.stalker;
    if (hit && st) {
      WFX.trauma = Math.min(1, WFX.trauma + PULSE_HIT_TRAUMA);
      spray(st.x * TILE + TILE / 2, st.y * TILE + TILE / 2 - 4, calm ? DEBRIS_BURST_REDUCED : PULSE_SPARKS,
            [rgbStr(PULSE_HIT_COL), '#ffffff'], DEBRIS_SPEED, -60, 2.5);
    }
  }
}

// World px centre the body is drawn at (it glides tile to tile).
function stalkerPx(st) {
  const tx = st.x * TILE + TILE / 2, ty = st.y * TILE + TILE / 2;
  if (!CFX.stTo || CFX.stTo[0] !== st.x || CFX.stTo[1] !== st.y || CFX.glide >= 1) return [tx, ty];
  const k = smoothstep(CFX.glide);
  return [CFX.stFromX + (tx - CFX.stFromX) * k, CFX.stFromY + (ty - CFX.stFromY) * k];
}

function updateCaveFx(dt) {
  const calm = caveCalm();
  const live = G.mode === 'overworld' && inCave(G.player.ty);
  const fx = tensionFx(G.tension, calm);
  // Heartbeat: the sound stays with reduced motion; the first beat lands at once.
  if (live && fx.heart > 0) {
    if (!CFX.hbOn) { CFX.hbOn = true; CFX.hbPhase = 0.999; }
    CFX.hbPhase += dt * fx.heart;
    if (CFX.hbPhase >= 1) { CFX.hbPhase -= 1; CFX.beats++; sfx('heartbeat'); }
  } else if (!['menu', 'craft', 'bag', 'shop'].includes(G.mode)) CFX.hbOn = false;
  // The flame gutters at low charge.
  if (lampFlickerAmp(G.lantern, calm) > 0) {
    CFX.flickerT -= dt;
    if (CFX.flickerT <= 0) { CFX.flickerT = 1 / LAMP_FLICKER_RATE; const r = fxRand(); CFX.flickerTo = r * r; }
    CFX.flicker += (CFX.flickerTo - CFX.flicker) * Math.min(1, dt * 20);
  } else { CFX.flicker = 0; CFX.flickerTo = 0; }
  // Film grain and tear lines: fear only, never with reduced motion.
  if (fx.grain) {
    CFX.grainT -= dt;
    if (CFX.grainT <= 0) {
      CFX.grainT = 1 / GRAIN_FPS;
      CFX.grainX = Math.floor(fxRand() * GRAIN_TILE); CFX.grainY = Math.floor(fxRand() * GRAIN_TILE);
    }
  }
  for (const te of CFX.tears) te.t = fx.tears ? Math.max(0, te.t - dt) : 0;
  if (fx.tears && live) {
    CFX.tearWait -= dt;
    if (CFX.tearWait <= 0) {
      CFX.tearWait = TEAR_EVERY * (0.5 + fxRand());
      const te = CFX.tears.find(q => q.t <= 0);
      if (te) {
        te.t = TEAR_TIME; te.y = 60 + Math.floor(fxRand() * (H - 120));
        te.h = 2 + Math.floor(fxRand() * 4); te.dx = fxRand() < 0.5 ? TEAR_SHIFT : -TEAR_SHIFT;
      }
    }
  }
  // Eyes blink now and then.
  CFX.blink = Math.max(0, CFX.blink - dt);
  CFX.blinkWait -= dt;
  if (CFX.blinkWait <= 0) { CFX.blink = EYE_BLINK_TIME; CFX.blinkWait = EYE_BLINK_EVERY * (0.5 + fxRand()); }
  // The body glides between tiles; a hunting one leaves fading eye ghosts.
  const st = G.stalker;
  if (!st) CFX.stTo = null;
  else if (!CFX.stTo || CFX.stTo[0] !== st.x || CFX.stTo[1] !== st.y) {
    const near = CFX.stTo && Math.abs(st.x - CFX.stTo[0]) + Math.abs(st.y - CFX.stTo[1]) <= 2;
    if (near && !calm) {
      const [fx0, fy0] = stalkerPx(Object.assign({}, st, { x: CFX.stTo[0], y: CFX.stTo[1] }));  // from wherever it is drawn now
      CFX.stFromX = fx0; CFX.stFromY = fy0; CFX.glide = 0;
      if (st.mode === 'hunt') {
        const tr = CFX.trail.find(q => q.t <= 0);
        if (tr) { tr.x = fx0; tr.y = fy0; tr.t = TRAIL_TIME; }
      }
    } else CFX.glide = 1;
    CFX.stTo = [st.x, st.y];
  }
  CFX.glide = Math.min(1, CFX.glide + dt / STALKER_GLIDE);
  for (const tr of CFX.trail) if (tr.t > 0) tr.t = Math.max(0, tr.t - dt);
  if (CFX.lungeAge !== null) { CFX.lungeAge += dt; if (CFX.lungeAge >= LUNGE_TIME) CFX.lungeAge = null; }
  if (CFX.ring) { CFX.ring.age += dt; if (CFX.ring.age >= PULSE_RING_TIME + PULSE_RING_FADE) CFX.ring = null; }
  // A confirm pressed while the lunge flare held the screen is replayed now.
  if (CFX.pendingConfirm && CFX.lungeAge === null) { CFX.pendingConfirm = false; confirmKey(); }
  caveDrone(live || (inCave(G.player.ty) && ['menu', 'craft', 'bag', 'shop', 'dialogue'].includes(G.mode))
    ? DRONE_VOL * (0.25 + 0.75 * clamp(G.tension, 0, TENSION.max) / TENSION.max) : 0);
}

function tearsLive() { let n = 0; for (const te of CFX.tears) if (te.t > 0) n++; return n; }

// 0..PULSE_RING_ALPHA for a ring tile at path distance d right now: bright on
// the wavefront, then fading. Reduced motion: no travelling front, every
// reached tile just fades together.
function ringAlpha(d) {
  const r = CFX.ring;
  if (!r) return 0;
  const a = PULSE_RING_ALPHA * (r.hit ? 1 : 0.6), age = r.age;
  if (caveCalm()) return Math.trunc(a * 0.5 * Math.max(0, 1 - age / (PULSE_RING_TIME + PULSE_RING_FADE)));
  const front = (PULSE.range + 1) * Math.min(1, age / PULSE_RING_TIME);
  if (d > front) return 0;
  const v = age < PULSE_RING_TIME ? Math.max(0.35, 1 - (front - d) / 1.5)    // bright on the front, a glow behind it
                                  : 0.35 * Math.max(0, 1 - (age - PULSE_RING_TIME) / PULSE_RING_FADE);
  return Math.trunc(a * v);
}

// ORE boulders, from the deterministic mineDrop: computed once, so the glint
// is a fixed property of the tile, never a per-frame search of the map.
const ORE_SPOTS = [];
for (let y = ROCK_BAND[0]; y <= ROCK_BAND[1]; y++) {
  for (let x = 0; x < MAP_W; x++) {
    const t = MAP[y][x];
    if (canMine(t, x, y, true) && mineDrop(t, x, y).ore) ORE_SPOTS.push([x, y]);
  }
}

// [[x, y, strength]] of ORE boulders glinting this frame: only unmined ones
// within SPARKLE_RADIUS tiles of the player, so it hints rather than maps.
function oreTells() {
  const px = G.player.tx, py = G.player.ty, out = [];
  const w = SPARKLE_TIME / SPARKLE_PERIOD;
  for (const [x, y] of ORE_SPOTS) {
    if (Math.max(Math.abs(x - px), Math.abs(y - py)) > SPARKLE_RADIUS || tileHere(x, y) !== '#') continue;
    if (REDUCED_MOTION) { out.push([x, y, 0.6]); continue; }      // steady, no blinking
    const ph = ((G.time / SPARKLE_PERIOD + (tileHash(x, y) & 255) / 256) % 1 + 1) % 1;
    if (ph < w) out.push([x, y, Math.sin(Math.PI * ph / w)]);
  }
  return out;
}

// The authored seams and the GEODE crystals (open pocket tiles picked by
// tileHash), both fixed: no per-frame map search.
const SEAM_SPOTS = [], GEODE_SPOTS = [];
for (let y = 0; y < MAP_H; y++) for (let x = 0; x < MAP_W; x++) if (MAP[y][x] === SEAM) SEAM_SPOTS.push([x, y]);
for (let y = GEODE[1]; y <= GEODE[3]; y++) {
  for (let x = GEODE[0]; x <= GEODE[2]; x++) {
    if ('c;,'.includes(MAP[y][x]) && tileHash(x, y) % GEODE_GLINT_ONE_IN === 0) GEODE_SPOTS.push([x, y]);
  }
}

// True once the GEODE's entrance seam has been mined.
function geodeOpen() { return tileHere(GEODE_DOOR[0], GEODE_DOOR[1]) !== SEAM; }

// A GEODE pocket tile drawn as solid rock because the pocket is still sealed:
// the lantern would otherwise show its grass through the wall.
function geodeMasked(x, y, opened) {
  if (x < GEODE[0] || x > GEODE[2] || y < GEODE[1] || y > GEODE[3]) return false;
  if (MAP[y][x] === 'C' || MAP[y][x] === SEAM) return false;
  return !(opened === undefined ? geodeOpen() : opened);
}

// The glyph the overworld draws at (x, y) before crack/pop frames: a collected
// ball is its ground, a sealed GEODE tile is rock and a sealed glade tile is
// forest, so nothing shows through a wall.
function overworldGlyph(x, y, opened) {
  const t = tileHere(x, y);
  if (t === 'o' && G.picked.has(x + ',' + y)) return pickedGround(x, y);
  if (!opened && geodeMasked(x, y, false)) return 'C';   // sealed: rock, not grass seen through the wall
  if (gladeMasked(x, y, G.edits)) return '#';             // sealed: forest until the THICK TREE falls
  return t;
}

// [[x, y, strength]] of unmined CRACKED SEAMs glinting this frame: only with
// the IRON PICK, within SPARKLE_RADIUS, and only a seam with an open face (the
// sealed GEODE's inner seam stays quiet until the pocket opens).
function seamTells() {
  if (pickTier(G.flags.pick) < 2) return [];
  const px = G.player.tx, py = G.player.ty, out = [], opened = geodeOpen();
  const w = SPARKLE_TIME / SPARKLE_PERIOD;
  for (const [x, y] of SEAM_SPOTS) {
    if (Math.max(Math.abs(x - px), Math.abs(y - py)) > SPARKLE_RADIUS || tileHere(x, y) !== SEAM) continue;
    if (!DIRS4.some(([dx, dy]) => !SOLID.has(tileHere(x + dx, y + dy)) && !geodeMasked(x + dx, y + dy, opened))) continue;
    if (REDUCED_MOTION) { out.push([x, y, 0.6]); continue; }      // steady, no blinking (as the ORE tell)
    const ph = ((G.time / SPARKLE_PERIOD + (tileHash(x, y) & 255) / 256) % 1 + 1) % 1;
    if (ph < w) out.push([x, y, Math.sin(Math.PI * ph / w)]);
  }
  return out;
}

// [[x, y, strength]] of GEODE crystals glinting this frame: none until the
// entrance seam is mined, none with reduced motion.
function geodeGlints() {
  if (REDUCED_MOTION || !geodeOpen()) return [];
  const w = GEODE_GLINT_TIME / GEODE_GLINT_PERIOD, out = [];
  for (const [x, y] of GEODE_SPOTS) {
    const ph = ((G.time / GEODE_GLINT_PERIOD + (tileHash(x, y) >> 8) / 256) % 1 + 1) % 1;
    if (ph < w) out.push([x, y, Math.sin(Math.PI * ph / w)]);
  }
  return out;
}

function drawGlint(x, y, k, col, hi) {
  const h = tileHash(x, y);
  const gx = Math.round(x * TILE - camX) + 9 + (h >> 4) % 14;
  const gy = Math.round(y * TILE - camY) + 8 + (h >> 8) % 12;
  const r = 1 + Math.round(4 * k);
  ctx.fillStyle = col;
  ctx.fillRect(gx - r, gy, r * 2 + 1, 1);
  ctx.fillRect(gx, gy - r, 1, r * 2 + 1);
  ctx.fillStyle = hi;
  ctx.fillRect(gx - 1, gy - 1, 2, 2);
}

// The opened GEODE over the lantern dark: a soft static violet wash and its
// crystal glints, so the pocket reads as special from its doorway.
let geodeGlow = null;
function drawGeodeLight() {
  if (!geodeOpen()) return;
  const gw = (GEODE[2] - GEODE[0] + 1) * TILE, gh = (GEODE[3] - GEODE[1]) * TILE;   // open rows only
  const sx = Math.round(GEODE[0] * TILE - camX), sy = Math.round(GEODE[1] * TILE - camY);
  if (sx > W || sy > H || sx + gw < 0 || sy + gh < 0) return;
  if (!geodeGlow) {
    geodeGlow = document.createElement('canvas');
    geodeGlow.width = gw; geodeGlow.height = gh;
    const m = geodeGlow.getContext('2d');
    m.fillStyle = 'rgba(' + GEODE_GLOW.join(',') + ',' + (Math.floor(GEODE_GLOW_ALPHA / GEODE_GLOW_STEPS) / 255) + ')';
    for (let i = 0; i < GEODE_GLOW_STEPS; i++) {          // nested ellipses build a soft centre
      const u = i / GEODE_GLOW_STEPS;
      m.beginPath();
      m.ellipse(gw / 2, gh / 2, gw * (1 - u * 0.8) / 2, gh * (1 - u * 0.8) / 2, 0, 0, Math.PI * 2);
      m.fill();
    }
  }
  ctx.drawImage(geodeGlow, sx, sy);
  for (const [x, y, k] of geodeGlints()) drawGlint(x, y, k, GEODE_GLINT, GEODE_GLINT_HI);
}

// The IRON PICK's seam tell, drawn over the lantern dark like the GEODE light.
function drawSeamTells() {
  for (const [x, y, k] of seamTells()) drawGlint(x, y, k, ORE_GLINT, ORE_GLINT_HI);
}

/* placementOk for the faced tile, cached: it runs two BFS, so it is redone
   only when the faced tile, the player's tile, the overlay, the picked set
   or an NPC position changes - not every frame. */
let targetCache = null, editsRef = null, editsVer = 0, targetCalls = 0;
function buildTarget() {
  if (G.edits !== editsRef) { editsRef = G.edits; editsVer++; }
  const p = G.player;
  const [fx, fy] = facingTile(p);
  let key = fx + ',' + fy + '|' + p.tx + ',' + p.ty + '|' + editsVer + '|' +
            Object.keys(G.edits).length + '|' + G.picked.size + '|';
  for (const n of NPCS) key += n.x + ',' + n.y + ';';
  if (!targetCache || targetCache.key !== key) {
    targetCalls++;
    targetCache = { key, res: placementOk(fx, fy, G.edits, G.picked, npcTiles(), [p.tx, p.ty]) };
  }
  return targetCache.res;
}
function targetColour() {
  return buildTarget()[0] && (G.materials.wall || 0) > 0 ? TARGET_OK : TARGET_BAD;
}

// Crack frames, WALL pop-ins and ORE glints, over the tile layer.
function drawSandboxFx() {
  for (const [k, c] of WFX.cracks) {
    const [x, y] = k.split(',').map(Number);
    const sx = Math.round(x * TILE - camX), sy = Math.round(y * TILE - camY);
    const a = CRACK_FLASH * FLASH_SCALE * Math.min(1, c.t / CRACK_TIME);
    if (a > 0) {
      ctx.globalAlpha = a; ctx.fillStyle = '#ffffff'; ctx.fillRect(sx, sy, TILE, TILE);
      ctx.globalAlpha = 1;
    }
    ctx.strokeStyle = '#282420'; ctx.lineWidth = 2;               // over the flash, so it reads
    ctx.beginPath();
    ctx.moveTo(sx + 7, sy + 7); ctx.lineTo(sx + 14, sy + 15); ctx.lineTo(sx + 10, sy + 22); ctx.lineTo(sx + 19, sy + 28);
    ctx.moveTo(sx + 14, sy + 15); ctx.lineTo(sx + 25, sy + 11);
    ctx.stroke();
  }
  for (const k of WFX.pops.keys()) {
    const [x, y] = k.split(',').map(Number);
    const s = popScale(k);
    // Grow out of the ground: scale about the tile's bottom centre.
    const ax = x * TILE - camX + TILE / 2, ay = y * TILE - camY + TILE;
    ctx.setTransform(s, 0, 0, s, ax, ay);
    drawWallBody(-TILE / 2, -TILE);
    ctx.setTransform(1, 0, 0, 1, 0, 0);
  }
  for (const [x, y, k] of oreTells()) drawGlint(x, y, k, ORE_GLINT, ORE_GLINT_HI);
}

function drawBuildBox() {
  const [fx, fy] = facingTile(G.player);
  const col = targetColour();
  const x = Math.round(fx * TILE - camX), y = Math.round(fy * TILE - camY);
  ctx.fillStyle = col === TARGET_OK ? TARGET_OK_FILL : TARGET_BAD_FILL;
  ctx.fillRect(x, y, TILE, TILE);
  ctx.strokeStyle = col;
  ctx.lineWidth = 2;
  ctx.strokeRect(x + 1, y + 1, TILE - 2, TILE - 2);
  if (col === TARGET_BAD) {                     // not colour alone: refusals get an x
    ctx.beginPath();
    ctx.moveTo(x + 10, y + 10); ctx.lineTo(x + TILE - 10, y + TILE - 10);
    ctx.moveTo(x + 10, y + TILE - 10); ctx.lineTo(x + TILE - 10, y + 10);
    ctx.stroke();
  }
}

function drawWorldFx() {
  for (let i = 0; i < DEBRIS_MAX; i++) {
    const p = DEBRIS[i];
    if (p.life <= 0) continue;
    const s = p.size * (p.life / p.max) + 0.5;
    ctx.fillStyle = p.col;
    ctx.fillRect(Math.round(p.x - camX - s), Math.round(p.y - camY - s), Math.max(1, Math.round(s * 2)), Math.max(1, Math.round(s * 2)));
  }
  for (let i = 0; i < FLOAT_MAX; i++) {
    const f = FLOATS[i];
    if (!f.on || f.age < f.delay) continue;
    const u = Math.min(1, f.age / FLOAT_TIME);           // one break's labels rise as a stack
    const rise = FLOAT_RISE * (1 - (1 - u) * (1 - u));   // ease-out
    const v = (f.age - f.delay) / FLOAT_TIME;            // each fades on its own clock
    ctx.globalAlpha = v < 0.6 ? 1 : Math.max(0, 1 - (v - 0.6) / 0.4);
    const x = Math.round(f.wx - camX), y = Math.round(f.wy - camY - rise);
    text(f.s, x + 1, y + 1, 13, '#14161a', 'center');
    text(f.s, x, y, 13, f.col, 'center');
  }
  ctx.globalAlpha = 1;
}

// One-frame taps: a direction pressed and released between two frames never
// shows in keys[], so press() latches it here and update() clears it after
// one overworld frame. A real hold is unchanged (it is held anyway).
const TAPS = { up: false, down: false, left: false, right: false };
function clearTaps() { TAPS.up = TAPS.down = TAPS.left = TAPS.right = false; }

/* --- audio: a tiny synth, no assets ------------------------------------- */
let actx = null;
function audio() {
  if (!actx) {
    try { actx = new (window.AudioContext || window.webkitAudioContext)(); }
    catch (e) { actx = false; }
  }
  return actx || null;
}

function tone(freq, dur, type, vol, slideTo) {
  const a = audio();
  if (!a) return;
  const o = a.createOscillator(), g = a.createGain();
  o.type = type || 'square';
  o.frequency.setValueAtTime(freq, a.currentTime);
  if (slideTo) o.frequency.exponentialRampToValueAtTime(slideTo, a.currentTime + dur);
  g.gain.setValueAtTime(vol || 0.05, a.currentTime);
  g.gain.exponentialRampToValueAtTime(0.0001, a.currentTime + dur);
  o.connect(g); g.connect(a.destination);
  o.start(); o.stop(a.currentTime + dur + 0.02);
}

function hitPitch() { return 1 + (fxRand() * 2 - 1) * HIT_PITCH_JITTER; }

// Short white-noise burst; the buffer is synthesized once and reused.
let noiseBuf = null;
function noiseClick(dur, vol) {
  const a = audio();
  if (!a) return;
  if (!noiseBuf) {
    noiseBuf = a.createBuffer(1, Math.floor(a.sampleRate * 0.1), a.sampleRate);
    const d = noiseBuf.getChannelData(0);
    for (let i = 0; i < d.length; i++) d[i] = fxRand() * 2 - 1;
  }
  const src = a.createBufferSource(), g = a.createGain();
  src.buffer = noiseBuf;
  g.gain.setValueAtTime(vol, a.currentTime);
  g.gain.exponentialRampToValueAtTime(0.0001, a.currentTime + dur);
  src.connect(g); g.connect(a.destination);
  src.start(); src.stop(a.currentTime + dur + 0.01);
}

const SFX = {
  text:     () => tone(880, 0.03, 'square', 0.02),
  select:    () => tone(660, 0.05, 'square', 0.04),
  cursor:    () => tone(440, 0.03, 'square', 0.025),
  cancel:    () => tone(330, 0.06, 'square', 0.035),
  // Hits: a noise click transient + a pitched body, +-5% pitch per play.
  hit:       () => { const p = hitPitch(); noiseClick(0.025, 0.035); tone(200 * p, 0.12, 'sawtooth', 0.05, 90 * p); },
  // Super effective: louder click, the saw body, plus a low sine thump.
  hitStrong: () => { const p = hitPitch(); noiseClick(0.04, 0.06); tone(300 * p, 0.2, 'sawtooth', 0.065, 70 * p);
                     tone(110 * p, 0.28, 'sine', 0.08, 45 * p); },
  hitWeak:   () => { const p = hitPitch(); tone(150 * p, 0.1, 'triangle', 0.035, 110 * p); },
  faint:     () => tone(400, 0.5, 'triangle', 0.05, 60),
  level:     () => { tone(523, 0.1, 'square', 0.04); setTimeout(() => tone(784, 0.18, 'square', 0.04), 100); },
  evolve:    () => { tone(392, 0.12, 'square', 0.04); setTimeout(() => tone(523, 0.12, 'square', 0.04), 120); setTimeout(() => tone(784, 0.3, 'square', 0.05), 240); },
  throw:     () => tone(520, 0.14, 'sine', 0.05, 900),
  catch:     () => { tone(660, 0.1, 'square', 0.05); setTimeout(() => tone(880, 0.1, 'square', 0.05), 110); setTimeout(() => tone(1175, 0.25, 'square', 0.05), 220); },
  encounter: () => { tone(300, 0.08, 'square', 0.05); setTimeout(() => tone(500, 0.08, 'square', 0.05), 90); setTimeout(() => tone(300, 0.08, 'square', 0.05), 180); },
  alert:     () => { tone(880, 0.09, 'square', 0.05); setTimeout(() => tone(1100, 0.16, 'square', 0.05), 100); },
  // The hunt's jumpscare: a noise burst over a screeching fall and a sub thump.
  scare:     () => { noiseClick(0.18, 0.075); tone(900, 0.5, 'sawtooth', 0.06, 110);
                     setTimeout(() => tone(55, 0.6, 'sine', 0.08, 30), 20); },
  heal:      () => { tone(660, 0.09, 'sine', 0.05); setTimeout(() => tone(880, 0.09, 'sine', 0.05), 100); setTimeout(() => tone(1100, 0.2, 'sine', 0.05), 200); },
  buff:      () => tone(400, 0.18, 'sine', 0.04, 800),
  debuff:    () => tone(500, 0.18, 'sine', 0.04, 200),
  run:       () => tone(700, 0.2, 'sine', 0.04, 260),
  step:      () => tone(120, 0.02, 'triangle', 0.015),
  hop:       () => tone(340, 0.13, 'sine', 0.04, 720),
  // Sandbox: a gritty crack for the pick, a dull double knock for a wall.
  mine:      () => { noiseClick(0.06, 0.06); tone(180, 0.12, 'triangle', 0.05, 70); },
  place:     () => { tone(160, 0.06, 'square', 0.035); setTimeout(() => tone(120, 0.08, 'square', 0.035), 70); },
  // A CRACKED SEAM giving way: a longer crack over a low, falling body.
  mineHeavy: () => { noiseClick(0.09, 0.075); tone(120, 0.22, 'triangle', 0.06, 45);
                     setTimeout(() => tone(62, 0.32, 'sine', 0.07, 34), 20); },
  // DARK CAVE. Contact: a sharp breath in, then a falling growl with a square
  // rasp under it (the battle's "scare" screech follows it).
  hunt:      () => { noiseClick(0.16, 0.035); setTimeout(() => tone(96, 0.42, 'sawtooth', 0.065, 42), 40);
                     setTimeout(() => tone(64, 0.4, 'square', 0.025, 38), 60); },
  // The PULSE: a click, a rising sine sweep over a falling triangle whomp and a
  // sub thump - always played; then a hit crack or a miss fizzle.
  pulse:     () => { noiseClick(0.03, 0.05); tone(180, 0.3, 'sine', 0.065, 1500); tone(240, 0.34, 'triangle', 0.055, 60);
                     setTimeout(() => tone(70, 0.3, 'sine', 0.065, 40), 10); },
  pulseHit:  () => { setTimeout(() => { noiseClick(0.06, 0.06); tone(1400, 0.16, 'sawtooth', 0.03, 260); }, 50);
                     setTimeout(() => tone(66, 0.32, 'sine', 0.075, 34), 70); },
  pulseMiss: () => setTimeout(() => tone(520, 0.3, 'triangle', 0.035, 150), 60),
  // Fear (tension >= 75): a low lub-dub, a soft triangle edge so small speakers hear it.
  heartbeat: () => { tone(62, 0.16, 'sine', 0.1, 40); tone(124, 0.05, 'triangle', 0.02, 80);
                     setTimeout(() => { tone(55, 0.18, 'sine', 0.08, 36); tone(110, 0.05, 'triangle', 0.015, 70); },
                                HEART_DUB / HEART_HZ_MIN * 1000); }

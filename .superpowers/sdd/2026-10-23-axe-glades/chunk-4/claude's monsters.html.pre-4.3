/* --- DARK CAVE horror kit: lantern, tension, the stalker, the PULSE ------ */

// A tiny seeded PRNG, bit-for-bit the same as the .py build's, so a stalker
// trace replays identically in both. Returns rng() -> [0, 1).
function mulberry32(seed) {
  let a = seed >>> 0;
  return function () {
    a = (a + 0x6D2B79F5) >>> 0;

function cursorArrow(x, y) {          // the pygame build's cursor_arrow: a 10x10 right-pointing triangle
  ctx.fillStyle = '#22303f';
  ctx.beginPath(); ctx.moveTo(x, y); ctx.lineTo(x + 10, y + 5); ctx.lineTo(x, y + 10); ctx.closePath(); ctx.fill();
}
function scrollCue(x, y, up) {         // a small triangle at the edge of a list: more rows past it
  ctx.fillStyle = CUE_COL;
  ctx.beginPath();
  if (up) { ctx.moveTo(x - 5, y + 4); ctx.lineTo(x + 5, y + 4); ctx.lineTo(x, y - 4); }
  else { ctx.moveTo(x - 5, y - 4); ctx.lineTo(x + 5, y - 4); ctx.lineTo(x, y + 4); }
  ctx.closePath(); ctx.fill();
}
function hRule(x1, x2, y) { ctx.fillStyle = '#2a3340'; ctx.fillRect(x1, y - 1, x2 - x1, 2); }


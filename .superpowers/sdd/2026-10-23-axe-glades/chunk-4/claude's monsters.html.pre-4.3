/* ====================== LAYER 2: ENGINE ======================
   Pure functions.  Nothing here touches the DOM or global state. */

function clamp(v, lo, hi) { return v < lo ? lo : v > hi ? hi : v; }

function statAt(base, level, isHP) {
  return isHP
    ? Math.floor(base * 2 * level / 100) + level + 10
    : Math.floor(base * 2 * level / 100) + 5;
}

function xpForLevel(level) { return level * level * level; }

// The four most recent moves learnable at or below `level`.
function movesForLevel(speciesId, level) {
  const known = [];
  for (const [lvl, id] of SPECIES[speciesId].learn) {
    if (lvl > level) break;
    if (!known.includes(id)) known.push(id);
  }
  return known.slice(-4);
}

function makeMon(speciesId, level, nickname) {
  const sp = SPECIES[speciesId];
  const mon = {
    id: speciesId, name: nickname || sp.name, level,
    xp: xpForLevel(level), moves: movesForLevel(speciesId, level), hp: 0, maxhp: 0
  };
  recalcStats(mon);
  mon.hp = mon.maxhp;
  return mon;
}

function recalcStats(mon) {
  const b = SPECIES[mon.id].base;
  mon.maxhp = statAt(b.hp, mon.level, true);
  mon.atk = statAt(b.atk, mon.level);
  mon.def = statAt(b.def, mon.level);
  mon.spa = statAt(b.spa, mon.level);
  mon.spd = statAt(b.spd, mon.level);
  mon.spe = statAt(b.spe, mon.level);
}

function stageMul(stage) {
  return stage >= 0 ? (2 + stage) / 2 : 2 / (2 - stage);
}

function typeEffectiveness(moveType, defTypes) {
  let mul = 1;
  const row = TYPE_CHART[moveType] || {};
  for (const t of defTypes) mul *= (row[t] !== undefined ? row[t] : 1);
  return mul;
}

/* Returns { missed, dmg, eff, crit }.  `rng` is injectable so the
   engine can be tested deterministically.  `condition` is a CONDITIONS id: its
   acc shifts every move that can miss and its boost scales damage after the type
   chart.  null/undefined (or 'clear') is today's result, and the number of rng
   draws never depends on it. */
function damageCalc(atkMon, defMon, moveId, atkStages, defStages, rng, timing = 1, critBonus = 0, condition = null) {
  rng = rng || Math.random;
  timing = typeof timing === 'number' && Number.isFinite(timing) ? clamp(timing, .65, 1.2) : 1;
  critBonus = typeof critBonus === 'number' && Number.isFinite(critBonus) ? clamp(critBonus, 0, .05) : 0;
  const mv = MOVES[moveId];
  const sp = SPECIES[atkMon.id];
  const cond = (typeof condition === 'string' && Object.prototype.hasOwnProperty.call(CONDITIONS, condition))
    ? CONDITIONS[condition] : CONDITIONS.clear;

  const accStage = stageMul(0);
  if (mv.acc < 999 && rng() * 100 >= (mv.acc + cond.acc) * accStage) {
    return { missed: true, dmg: 0, eff: 1, crit: false };
  }
  if (mv.cat === 'status' || mv.pow === 0) {
    return { missed: false, dmg: 0, eff: 1, crit: false };
  }

  const crit = rng() < Math.min(1, (mv.highCrit ? 0.125 : 0.0625) + critBonus);
  // A critical hit ignores the attacker's negative and the defender's
  // positive stat stages, the same way the real games handle it.
  const aKey = mv.cat === 'phys' ? 'atk' : 'spa';
  const dKey = mv.cat === 'phys' ? 'def' : 'spd';
  const aStage = crit ? Math.max(0, atkStages[aKey] || 0) : (atkStages[aKey] || 0);
  const dStage = crit ? Math.min(0, defStages[dKey] || 0) : (defStages[dKey] || 0);

  const A = Math.max(1, Math.floor(atkMon[aKey] * stageMul(aStage)));
  const D = Math.max(1, Math.floor(defMon[dKey] * stageMul(dStage)));

  let dmg = Math.floor(Math.floor(Math.floor(2 * atkMon.level / 5 + 2) * mv.pow * A / D) / 50) + 2;
  if (crit) dmg = Math.floor(dmg * 1.5);
  if (sp.types.includes(mv.type)) dmg = Math.floor(dmg * 1.5);   // STAB

  const eff = typeEffectiveness(mv.type, SPECIES[defMon.id].types);
  dmg = Math.floor(dmg * eff);
  dmg = Math.floor(dmg * (cond.boost[mv.type] || 1));          // battle condition
  dmg = Math.floor(dmg * (0.85 + rng() * 0.15));

  return { missed: false, dmg: eff === 0 ? 0 : Math.max(1, Math.floor(dmg * timing)), eff, crit };
}

/* Ball shake check.  Returns { caught, shakes } with shakes in 0..4. */
function catchRoll(mon, ballBonus, rng, throwScale = 1) {
  rng = rng || Math.random;
  throwScale = typeof throwScale === 'number' && Number.isFinite(throwScale) ? clamp(throwScale, 1, 1.85) : 1;
  const rate = SPECIES[mon.id].catchRate;
  const a = ((3 * mon.maxhp - 2 * mon.hp) * rate * ballBonus * throwScale) / (3 * mon.maxhp);
  if (a >= 255) return { caught: true, shakes: 4 };
  const b = 65536 / Math.pow(255 / a, 0.25);
  let shakes = 0;
  for (let i = 0; i < 4; i++) {
    if (rng() * 65536 >= b) return { caught: false, shakes };
    shakes++;
  }
  return { caught: true, shakes: 4 };
}

function xpFromFaint(foe) {
  return Math.max(1, Math.floor(SPECIES[foe.id].baseExp * foe.level / 7));
}

/* Applies XP and returns a list of narratable events. */
function gainXp(mon, amount) {
  const events = [];
  mon.xp += amount;
  while (mon.level < 100 && mon.xp >= xpForLevel(mon.level + 1)) {
    mon.level++;

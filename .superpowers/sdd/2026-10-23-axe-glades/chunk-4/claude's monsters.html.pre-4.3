/* The DARK CAVE's forced hunt battle. Wild-style (XP as normal), but BALL is
   refused and RUN uses fixed odds. Level tracks the party's best, clamped to
   the cave's band so grinding eventually wins. Rewards land in materials.
   Hand-ported from the Python HUNT table (PARITY checks it). */
const HUNT = { species: 'gloomstalk', lvMin: 22, lvMax: 28, lvOffset: -1, runOdds: 0.5,
               rewardFirst: { ore: 3 }, rewardRepeat: { ore: 1 } };
// The hunter's level for a party: best level + offset, clamped.
function huntLevel(partyLevels) {
  return clamp(Math.max(...partyLevels) + HUNT.lvOffset, HUNT.lvMin, HUNT.lvMax);
}
// G.flags.huntBeaten from a save: a non-negative int, garbage -> 0.
function huntCount(v) {
  if (typeof v !== 'number' || !isFinite(v)) return 0;
  return Math.max(0, Math.trunc(v));
}


/* --- dialogue / menus --------------------------------------------------- */
function drawDialogue() {
  const d = G.dialogue;
  if (!d) return;
  panel(16, H - 118, W - 32, 102);
  const line = d.lines[d.i] || '';
  wrapText(line, 36, H - 82, W - 76, 20, 15, '#22303f');
  const blink = Math.sin(G.time * 6) > 0;
  if (blink) {
    ctx.fillStyle = '#22303f';
    ctx.beginPath();
    ctx.moveTo(W - 46, H - 38); ctx.lineTo(W - 34, H - 38); ctx.lineTo(W - 40, H - 30);
    ctx.closePath(); ctx.fill();
  }
}

function wrapText(s, x, y, maxW, lh, size, color) {
  ctx.font = 'bold ' + size + 'px "Courier New", monospace';
  const words = String(s).split(' ');
  let line = '', ly = y;
  for (const w of words) {
    const test = line ? line + ' ' + w : w;
    if (ctx.measureText(test).width > maxW && line) {
      text(line, x, ly, size, color);
      line = w; ly += lh;
    } else line = test;
  }
  if (line) text(line, x, ly, size, color);
  return ly;
}

function menuRows() { return (G.flags.gym ? MENU_ITEMS.slice(0,-1).concat(['DESCEND','CLOSE']) : MENU_ITEMS).concat(['SETTINGS']); }
function drawMenu() {
  const items = menuRows().map(menuLabel);
  const w = MENU_W, h = 26 * items.length + 24;
  panel(W - w - 16, MENU_Y, w, h);              // below the lead-HP box, never over it
  items.forEach((it, i) => {
    const y = MENU_Y + 30 + i * 26;
    if (i === G.menu.cursor) {
      ctx.fillStyle = '#22303f';
      ctx.beginPath();
      ctx.moveTo(W - w + 2, y - 10); ctx.lineTo(W - w + 12, y - 5); ctx.lineTo(W - w + 2, y);
      ctx.closePath(); ctx.fill();
    }
    text(it, W - w + 20, y, 15, '#22303f');
  });
}

// CRAFT: materials on top, one row per recipe, then BUILD and BACK. It starts
// below the HUD (region, materials, lead HP end at y=66) and ends above the
// toast strip (y=420), so it covers none of them.

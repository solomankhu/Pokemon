  const axeOwned = axeTier(G.flags.axe) > 0;
  text('AXE: ' + (axeOwned ? 'YES' : 'NO'), x + 120 + ctx.measureText(pickText).width + 16, y + 33, 13,
       axeOwned ? '#b07828' : '#6f8ba8');
  text(promptLabel('cancel') + ' back', x + w - 18, y + 32, 11, '#6f8ba8', 'right');
  const m = G.materials;
  text('STONE ' + m.stone + '   ORE ' + m.ore + '   WALL ' + m.wall + '   BALLS ' + G.balls,
       x + 20, y + 64, 13, '#22303f');
  ctx.fillStyle = '#2a3340';
